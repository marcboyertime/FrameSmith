{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fcpcommandconsole.local/schemas/effect-plan.schema.json",
  "title": "FCPCommandConsole EffectPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "operationID", "originalRequest", "confidence", "ambiguities", "effectID", "selectionToken", "parameters", "representation", "editableProperties", "generatedAssets", "previewStrategy", "verification", "fallback", "cost", "preconditionRevision"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "operationID": {"type": "string", "format": "uuid"},
    "originalRequest": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "ambiguities": {"type": "array", "items": {"type": "string"}},
    "effectID": {"enum": ["native.targeted_rotate_zoom", "look.old_television", "transition.natural_dissolve", "motion.living_still"]},
    "selectionToken": {"$ref": "#/$defs/selectionToken"},
    "normalizedPoint": {"$ref": "#/$defs/target"},
    "parameters": {"type": "object", "additionalProperties": {"$ref": "#/$defs/parameterValue"}},
    "representation": {"enum": ["fcpxml_native", "layered_media", "motion_template", "external_editable_composition", "baked_render"]},
    "editableProperties": {"type": "array", "items": {"$ref": "#/$defs/editableProperty"}},
    "generatedAssets": {"type": "array", "items": {"$ref": "#/$defs/generatedAsset"}},
    "previewStrategy": {"type": "string", "minLength": 1},
    "verification": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "fallback": {"type": "string", "minLength": 1},
    "cost": {"$ref": "#/$defs/cost"},
    "preconditionRevision": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "coordinateSpace", "confirmed"],
      "properties": {"x": {"type":"number","minimum":0,"maximum":1}, "y": {"type":"number","minimum":0,"maximum":1}, "coordinateSpace": {"type":"string"}, "confirmed": {"type":"boolean"}}
    },
    "selectionToken": {
      "type": "object", "additionalProperties": false,
      "required": ["tokenID", "selectionType", "timelineID", "clipIDs", "sourceIdentities", "revision", "handleBeforeFrames", "handleAfterFrames", "isSpine", "adjacent"],
      "properties": {
        "tokenID": {"type":"string","minLength":1}, "selectionType": {"enum":["single-clip","two-adjacent-clips","range","point","none"]}, "timelineID": {"type":"string","minLength":1}, "clipIDs": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}}, "sourceIdentities": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/sourceIdentity"}}, "revision": {"type":"string","minLength":1},
        "startFrame": {"type":"integer","minimum":0}, "endFrame": {"type":"integer","minimum":0}, "sourceDurationFrames": {"type":"integer","minimum":1}, "sourceRangeStartFrame": {"type":"integer","minimum":0}, "sourceRangeEndFrame": {"type":"integer","minimum":1}, "leftSourceDurationFrames": {"type":"integer","minimum":1}, "rightSourceDurationFrames": {"type":"integer","minimum":1}, "leftSourceRangeStartFrame": {"type":"integer","minimum":0}, "leftSourceRangeEndFrame": {"type":"integer","minimum":1}, "rightSourceRangeStartFrame": {"type":"integer","minimum":0}, "rightSourceRangeEndFrame": {"type":"integer","minimum":1}, "leftClipEndFrame": {"type":"integer","minimum":0}, "rightClipStartFrame": {"type":"integer","minimum":0}, "boundaryFrame": {"type":"integer","minimum":0}, "frameRate": {"type":"integer","minimum":1,"maximum":240}, "handleBeforeFrames": {"type":"integer","minimum":0}, "handleAfterFrames": {"type":"integer","minimum":0}, "isSpine": {"type":"boolean"}, "adjacent": {"type":"boolean"}
      }
    },
    "sourceIdentity": {
      "type": "object", "additionalProperties": false,
      "required": ["itemID", "canonicalPath", "sha256"],
      "properties": {
        "itemID": {"type": "string", "minLength": 1},
        "canonicalPath": {"type": "string", "pattern": "^/", "minLength": 2},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "parameterValue": {"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"},{"type":"array","items":{"$ref":"#/$defs/parameterValue"}},{"type":"object","additionalProperties":{"$ref":"#/$defs/parameterValue"}}]},
    "editableProperty": {"type":"object","additionalProperties":false,"required":["name","valueType","keyframeable"],"properties":{"name":{"type":"string","minLength":1},"valueType":{"type":"string"},"minimum":{"type":"number"},"maximum":{"type":"number"},"defaultValue":{"$ref":"#/$defs/parameterValue"},"keyframeable":{"type":"boolean"}}},
    "generatedAsset": {"type":"object","additionalProperties":false,"required":["kind","format","alpha","deterministic"],"properties":{"kind":{"type":"string","minLength":1},"format":{"type":"string","minLength":1},"alpha":{"type":"boolean"},"deterministic":{"type":"boolean"}}},
    "cost": {"type":"object","additionalProperties":false,"required":["paid","usd","provider","requiresMediaUpload"],"properties":{"paid":{"const":false},"usd":{"const":0},"provider":{"const":"local"},"estimatedUnits":{"type":"number","minimum":0},"requiresMediaUpload":{"const":false}}}
  }
}

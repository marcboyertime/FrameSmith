#!/bin/zsh
# Non-destructive entitlement repair for the one approved isolated Final Cut copy.
# It does not launch either app, open a library, or re-sign nested code.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
destination_root="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole"
copied_app="$destination_root/Final Cut Pro - FCPCommandConsole.app"
copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"
expected_host_bundle_identifier="com.apple.FinalCut"
expected_copied_host_bundle_path="$copied_app"
expected_host_version="12.3"
expected_host_build="450152"
expected_stock_pre_injection_host_executable_sha256="6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390"
mas_receipt_relative_path="Contents/_MASReceipt/receipt"
expected_mas_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
framework_name="FCPCommandConsoleRuntime.framework"
embedded_framework="$copied_app/Contents/Frameworks/$framework_name"
embedded_runtime="$embedded_framework/Versions/A/FCPCommandConsoleRuntime"
embedded_compatibility_policy="$embedded_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
preferences_file="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
provenance_root="/Users/marcboyer/Movies/FCPCommandConsole/provenance"
repair_dir="$provenance_root/patch-$(/bin/date -u +%Y%m%dT%H%M%SZ)-repair-library-validation-$$"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
required_added_entitlement="com.apple.security.cs.disable-library-validation"
removed_entitlements=(
    com.apple.application-identifier
    com.apple.developer.aps-environment
    com.apple.developer.icloud-container-environment
    com.apple.developer.icloud-container-identifiers
    com.apple.developer.icloud-services
    com.apple.developer.team-identifier
    com.apple.security.application-groups
    com.apple.security.automation.apple-events
    com.apple.security.scripting-targets
    com.apple.security.temporary-exception.apple-events
    keychain-access-groups
)

fail() {
    print -u2 -r -- "repair-library-validation-entitlement: $1"
    exit 1
}

capture_preferences() {
    local output_dir="$1"
    if [[ -f "$preferences_file" ]]; then
        /usr/bin/plutil -convert xml1 -o "$output_dir/stock-preferences.xml" "$preferences_file"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    else
        print -r -- "absent" > "$output_dir/stock-preferences.xml"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    fi
}

capture_receipt() {
    local app_path="$1"
    local output_dir="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "MAS receipt is missing or not a regular file: $app_path"
    fi
    /bin/cp "$receipt_path" "$output_dir/receipt"
    /usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}' > "$output_dir/receipt.sha256"
}

verify_receipt() {
    local app_path="$1"
    local label="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "$label MAS receipt is missing or not a regular file"
    fi
    local receipt_sha256="$(/usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}')"
    if [[ "$receipt_sha256" != "$expected_mas_receipt_sha256" ]]; then
        fail "$label MAS receipt SHA-256 is not the reviewed value"
    fi
}

verify_compatibility_policy() {
    local policy_path="$1"
    if [[ ! -f "$policy_path" ]] || ! /usr/bin/plutil -lint "$policy_path" >/dev/null; then
        fail "embedded onboarding compatibility policy is missing or invalid"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "6" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "$expected_host_bundle_identifier" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedCopiedHostBundlePath' "$policy_path")" != "$expected_copied_host_bundle_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "$expected_host_version" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "$expected_host_build" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedStockPreInjectionHostExecutableSHA256' "$policy_path")" != "$expected_stock_pre_injection_host_executable_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptRelativePath' "$policy_path")" != "$mas_receipt_relative_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptSHA256' "$policy_path")" != "$expected_mas_receipt_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "$onboarding_framework_relative_executable_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "$expected_onboarding_framework_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "$expected_onboarding_framework_arm64_uuid" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "embedded onboarding compatibility policy host, receipt, or binary identity is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "forward_original_setter_async_nil_metadata_provider" ]]; then
        fail "embedded onboarding compatibility policy guard or replacement contract is not exact"
    fi
    for removed_policy_key in CompatibilityInstallPhases MethodGuardLogSubsystem MethodGuardLogCategory PreferenceDomain ApprovedPreferenceKeys ApprovedPreferenceValues SynchronizeDeterministically; do
        if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
            fail "embedded onboarding compatibility policy retains a retired scheduler, logger, or preference key"
        fi
    done
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" ]]; then
        fail "embedded onboarding compatibility policy setter contract is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1' "$policy_path" >/dev/null 2>&1; then
        fail "embedded onboarding compatibility policy permits an extra method replacement"
    fi
}

capture_bundle() {
    local app_path="$1"
    local executable_path="$2"
    local output_dir="$3"
    /bin/mkdir -p "$output_dir"
    /bin/cp "$app_path/Contents/Info.plist" "$output_dir/Info.plist"
    /usr/bin/shasum -a 256 "$executable_path" | /usr/bin/awk '{print $1}' > "$output_dir/main-executable.sha256"
    /usr/bin/shasum -a 256 "$app_path/Contents/Info.plist" | /usr/bin/awk '{print $1}' > "$output_dir/Info.plist.sha256"
    /usr/bin/codesign -dvvv "$app_path" > "$output_dir/codesign-metadata.txt" 2>&1
    /usr/bin/codesign -d -r- "$app_path" > "$output_dir/designated-requirement.txt" 2>&1
    /usr/bin/codesign -d --entitlements :- "$app_path" > "$output_dir/entitlements.plist" 2> "$output_dir/entitlements.stderr"
    /usr/bin/otool -arch arm64 -L "$executable_path" > "$output_dir/main-libraries-arm64.txt"
    /usr/bin/otool -arch x86_64 -L "$executable_path" > "$output_dir/main-libraries-x86_64.txt"
}

require_not_running() {
    local audit_file="$1"
    if /usr/bin/pgrep -fl 'Final Cut Pro' > "$audit_file"; then
        fail "a Final Cut Pro process is running; repair was not attempted"
    fi
    print -r -- "no Final Cut Pro process observed" > "$audit_file"
}

canonicalize_entitlements() {
    local input_file="$1"
    local output_prefix="$2"
    /usr/bin/plutil -convert binary1 -o "$output_prefix.bplist" "$input_file"
    /usr/bin/plutil -convert xml1 -o "$output_prefix.plist" "$output_prefix.bplist"
}

verify_load_commands() {
    local phase="$1"
    local copied_arm64="$repair_dir/copied-load-commands-$phase-arm64.txt"
    local copied_x86_64="$repair_dir/copied-load-commands-$phase-x86_64.txt"
    local stock_arm64="$repair_dir/stock-libraries-arm64-without-header.txt"
    local stock_x86_64="$repair_dir/stock-libraries-x86_64-without-header.txt"
    local filtered_arm64="$repair_dir/copied-libraries-$phase-arm64-without-intended-load.txt"
    local filtered_x86_64="$repair_dir/copied-libraries-$phase-x86_64-without-intended-load.txt"

    /usr/bin/otool -arch arm64 -L "$copied_executable" > "$copied_arm64"
    /usr/bin/otool -arch x86_64 -L "$copied_executable" > "$copied_x86_64"
    local arm64_count="$(/usr/bin/grep -F -c "$load_path" "$copied_arm64" || true)"
    local x86_64_count="$(/usr/bin/grep -F -c "$load_path" "$copied_x86_64" || true)"
    if [[ "$arm64_count" != "1" || "$x86_64_count" != "1" ]]; then
        fail "expected exactly one intended load command in each architecture"
    fi
    /usr/bin/sed '1d' "$repair_dir/stock-before/main-libraries-arm64.txt" > "$stock_arm64"
    /usr/bin/sed '1d' "$repair_dir/stock-before/main-libraries-x86_64.txt" > "$stock_x86_64"
    /usr/bin/grep -F -v "$load_path" "$copied_arm64" | /usr/bin/sed '1d' > "$filtered_arm64"
    /usr/bin/grep -F -v "$load_path" "$copied_x86_64" | /usr/bin/sed '1d' > "$filtered_x86_64"
    if ! /usr/bin/cmp -s "$stock_arm64" "$filtered_arm64"; then
        fail "unexpected arm64 main-executable dependency change"
    fi
    if ! /usr/bin/cmp -s "$stock_x86_64" "$filtered_x86_64"; then
        fail "unexpected x86_64 main-executable dependency change"
    fi
}

if [[ ! -d "$source_app" || ! -f "$source_executable" || ! -f "$source_app/$mas_receipt_relative_path" ]]; then
    fail "required stock app is missing"
fi
if [[ ! -d "$copied_app" || -L "$copied_app" || "$copied_app" != "$expected_copied_host_bundle_path" || ! -f "$copied_executable" || ! -d "$embedded_framework" || ! -f "$embedded_runtime" || ! -f "$embedded_compatibility_policy" ]]; then
    fail "approved copied-app path or embedded runtime baseline is missing"
fi
if [[ ! -f "$allowlist" || ! -x "$entitlement_verifier" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before repair"
fi

source_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$source_app/Contents/Info.plist")"
source_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$source_app/Contents/Info.plist")"
copied_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$copied_app/Contents/Info.plist")"
copied_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$copied_app/Contents/Info.plist")"
if [[ "$source_version" != "$expected_host_version" || "$source_build" != "$expected_host_build" || "$copied_version" != "$expected_host_version" || "$copied_build" != "$expected_host_build" ]]; then
    fail "stock or copied app version/build guard failed (expected 12.3/450152)"
fi
copied_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")"
copied_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$copied_app/Contents/Info.plist")"
copied_display_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$copied_app/Contents/Info.plist")"
copied_executable_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$copied_app/Contents/Info.plist")"
if [[ "$copied_identifier" != "$expected_host_bundle_identifier" || "$copied_name" != "Final Cut Pro - FCPCommandConsole" || "$copied_display_name" != "Final Cut Pro - FCPCommandConsole" || "$copied_executable_name" != "Final Cut Pro" ]]; then
    fail "copied app metadata does not match the approved isolated identity"
fi

/bin/mkdir -p "$provenance_root"
if [[ -e "$repair_dir" ]]; then
    fail "unique repair provenance destination already exists"
fi
/bin/mkdir "$repair_dir"
print -r -- "source_version=$source_version" > "$repair_dir/source-version-build.txt"
print -r -- "source_build=$source_build" >> "$repair_dir/source-version-build.txt"
print -r -- "copied_version=$copied_version" >> "$repair_dir/source-version-build.txt"
print -r -- "copied_build=$copied_build" >> "$repair_dir/source-version-build.txt"
print -r -- "bundle_identifier=$copied_identifier" > "$repair_dir/copied-identity.txt"
print -r -- "bundle_name=$copied_name" >> "$repair_dir/copied-identity.txt"
print -r -- "display_name=$copied_display_name" >> "$repair_dir/copied-identity.txt"
print -r -- "executable_name=$copied_executable_name" >> "$repair_dir/copied-identity.txt"
require_not_running "$repair_dir/process-before-repair.txt"
capture_bundle "$source_app" "$source_executable" "$repair_dir/stock-before"
capture_preferences "$repair_dir/stock-before"
capture_receipt "$source_app" "$repair_dir/stock-before"
verify_receipt "$source_app" "stock-before"
capture_bundle "$copied_app" "$copied_executable" "$repair_dir/copied-before"
capture_receipt "$copied_app" "$repair_dir/copied-before"
verify_receipt "$copied_app" "copied-before"
if ! /usr/bin/cmp -s "$repair_dir/stock-before/receipt" "$repair_dir/copied-before/receipt" || ! /usr/bin/cmp -s "$repair_dir/stock-before/receipt.sha256" "$repair_dir/copied-before/receipt.sha256"; then
    fail "copied MAS receipt differs from stock provenance"
fi
verify_compatibility_policy "$embedded_compatibility_policy"
/usr/bin/shasum -a 256 "$embedded_runtime" | /usr/bin/awk '{print $1}' > "$repair_dir/embedded-runtime-before.sha256"

initial_patch_dir=""
initial_patch_receipt_provenance="false"
for candidate in "$provenance_root"/patch-*; do
    if [[ -f "$candidate/stock-before/main-executable.sha256" && -f "$candidate/stock-before/Info.plist.sha256" && -f "$candidate/stock-before/stock-preferences.sha256" && -f "$candidate/copied-main-executable.pre-injection.sha256" ]]; then
        initial_patch_dir="$candidate"
        if [[ -f "$candidate/stock-before/receipt.sha256" && -f "$candidate/stock-before/receipt" ]]; then
            initial_patch_receipt_provenance="true"
        fi
        break
    fi
done
if [[ -z "$initial_patch_dir" ]]; then
    fail "initial patch provenance is missing"
fi
if [[ ! -f "$initial_patch_dir/signing.txt" ]]; then
    fail "initial patch signing provenance is missing"
fi
print -r -- "initial_patch_provenance=$initial_patch_dir" > "$repair_dir/initial-provenance.txt"
print -r -- "initial_patch_receipt_provenance=$initial_patch_receipt_provenance" >> "$repair_dir/initial-provenance.txt"
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/main-executable.sha256" "$repair_dir/stock-before/main-executable.sha256"; then
    fail "stock main executable fingerprint differs from initial patch evidence"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/Info.plist.sha256" "$repair_dir/stock-before/Info.plist.sha256"; then
    fail "stock Info.plist fingerprint differs from initial patch evidence"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/stock-preferences.sha256" "$repair_dir/stock-before/stock-preferences.sha256"; then
    fail "stock preference export fingerprint differs from initial patch evidence"
fi
if [[ "$initial_patch_receipt_provenance" == "true" ]]; then
    if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt.sha256" "$repair_dir/stock-before/receipt.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt" "$repair_dir/stock-before/receipt"; then
        fail "stock MAS receipt fingerprint differs from initial patch evidence"
    fi
else
    print -r -- "legacy_receipt_provenance=rebound_to_current_stock_copy_proof" >> "$repair_dir/initial-provenance.txt"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/copied-main-executable.pre-injection.sha256" "$repair_dir/stock-before/main-executable.sha256"; then
    fail "captured pre-injection copied executable differs from stock fingerprint"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$repair_dir/codesign-verify-before.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$repair_dir/runtime-codesign-verify-before.txt" 2>&1
verify_load_commands "before"

baseline_entitlements="$repair_dir/current-copy-baseline-entitlements.plist"
/bin/cp "$repair_dir/stock-before/entitlements.plist" "$baseline_entitlements"
for entitlement_key in "${removed_entitlements[@]}"; do
    if ! /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$repair_dir/stock-before/entitlements.plist" >/dev/null 2>&1; then
        fail "captured stock policy does not contain required removable key: $entitlement_key"
    fi
    /usr/libexec/PlistBuddy -c "Delete :$entitlement_key" "$baseline_entitlements" >/dev/null
done
if /usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$baseline_entitlements" >/dev/null 2>&1; then
    fail "captured stock policy unexpectedly already contains the required added entitlement"
fi
if [[ "$(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' "$repair_dir/copied-before/entitlements.plist")" != "true" ]]; then
    fail "current copied app does not retain com.apple.security.app-sandbox=true"
fi
if /usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$repair_dir/copied-before/entitlements.plist" >/dev/null 2>&1; then
    fail "current copied app already has library-validation disabled; refusing to re-repair"
fi
for forbidden_added_key in com.apple.security.get-task-allow com.apple.security.cs.debugger com.apple.security.cs.allow-dyld-environment-variables; do
    if /usr/libexec/PlistBuddy -c "Print :$forbidden_added_key" "$repair_dir/copied-before/entitlements.plist" >/dev/null 2>&1; then
        fail "current copied app contains forbidden entitlement: $forbidden_added_key"
    fi
done
/usr/bin/plutil -lint "$baseline_entitlements" >/dev/null
canonicalize_entitlements "$baseline_entitlements" "$repair_dir/baseline-entitlements"
canonicalize_entitlements "$repair_dir/copied-before/entitlements.plist" "$repair_dir/copied-before-entitlements"
if ! /usr/bin/cmp -s "$repair_dir/baseline-entitlements.plist" "$repair_dir/copied-before-entitlements.plist"; then
    fail "current copied-app entitlement baseline is not exactly stock minus the reviewed removals"
fi
print -r -- "current_copy_entitlement_baseline=stock_minus_11_reviewed_removals" > "$repair_dir/entitlement-baseline.txt"
print -r -- "library_validation_before=absent" >> "$repair_dir/entitlement-baseline.txt"
print -r -- "sandbox_before=true" >> "$repair_dir/entitlement-baseline.txt"
print -r -- "get_task_allow_before=absent" >> "$repair_dir/entitlement-baseline.txt"

repair_entitlements="$repair_dir/repair-signing-entitlements.plist"
/bin/cp "$repair_dir/copied-before/entitlements.plist" "$repair_entitlements"
/usr/libexec/PlistBuddy -c "Add :$required_added_entitlement bool true" "$repair_entitlements" >/dev/null
/usr/bin/plutil -lint "$repair_entitlements" >/dev/null

signing_identity="$(/usr/bin/security find-identity -v -p codesigning | /usr/bin/awk '/"Apple Development:/ {print $2; exit}')"
if [[ -z "$signing_identity" ]]; then
    fail "the required Apple Development signing identity is unavailable"
fi
initial_identity="$(/usr/bin/awk -F= '/^identity_fingerprint=/{print $2; exit}' "$initial_patch_dir/signing.txt")"
if [[ -z "$initial_identity" || "$signing_identity" != "$initial_identity" ]]; then
    fail "the available Apple Development identity does not match the initial copied-app signing evidence"
fi
print -r -- "signing_mode=apple_development" > "$repair_dir/signing.txt"
print -r -- "identity_fingerprint=$signing_identity" >> "$repair_dir/signing.txt"
print -r -- "signature_operation=top_level_copied_app_only" >> "$repair_dir/signing.txt"
print -r -- "deep_signing=false" >> "$repair_dir/signing.txt"

require_not_running "$repair_dir/process-before-top-level-resign.txt"
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none --entitlements "$repair_entitlements" "$copied_app" > "$repair_dir/sign-app.stdout" 2> "$repair_dir/sign-app.stderr"; then
    fail "top-level copied-app signing failed; nested code was not re-signed"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$repair_dir/codesign-verify-after.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$repair_dir/runtime-codesign-verify-after.txt" 2>&1
capture_bundle "$copied_app" "$copied_executable" "$repair_dir/copied-after"
capture_receipt "$copied_app" "$repair_dir/copied-after"
verify_receipt "$copied_app" "copied-after"
verify_compatibility_policy "$embedded_compatibility_policy"
if [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")" != "$expected_host_bundle_identifier" ]]; then
    fail "copied app bundle identifier changed during entitlement repair"
fi
if ! /usr/bin/cmp -s "$repair_dir/copied-before/receipt" "$repair_dir/copied-after/receipt" || ! /usr/bin/cmp -s "$repair_dir/copied-before/receipt.sha256" "$repair_dir/copied-after/receipt.sha256"; then
    fail "copied MAS receipt changed during entitlement repair"
fi
/usr/bin/shasum -a 256 "$embedded_runtime" | /usr/bin/awk '{print $1}' > "$repair_dir/embedded-runtime-after.sha256"
if ! /usr/bin/cmp -s "$repair_dir/embedded-runtime-before.sha256" "$repair_dir/embedded-runtime-after.sha256"; then
    fail "embedded runtime changed during top-level repair"
fi
if ! /usr/bin/cmp -s "$repair_dir/copied-before/Info.plist.sha256" "$repair_dir/copied-after/Info.plist.sha256"; then
    fail "copied app Info.plist changed during top-level repair"
fi
verify_load_commands "after"
"$entitlement_verifier" \
    "$repair_dir/stock-before/entitlements.plist" \
    "$repair_entitlements" \
    "$repair_dir/copied-after/entitlements.plist" \
    "$allowlist" > "$repair_dir/entitlement-allowlist.txt"
/usr/bin/shasum -a 256 "$allowlist" | /usr/bin/awk '{print $1}' > "$repair_dir/patch-entitlement-allowlist-config.sha256"

capture_bundle "$source_app" "$source_executable" "$repair_dir/stock-after"
capture_preferences "$repair_dir/stock-after"
capture_receipt "$source_app" "$repair_dir/stock-after"
verify_receipt "$source_app" "stock-after"
require_not_running "$repair_dir/process-after-repair.txt"
if ! /usr/bin/cmp -s "$repair_dir/stock-before/main-executable.sha256" "$repair_dir/stock-after/main-executable.sha256"; then
    fail "stock main executable fingerprint changed"
fi
if ! /usr/bin/cmp -s "$repair_dir/stock-before/Info.plist.sha256" "$repair_dir/stock-after/Info.plist.sha256"; then
    fail "stock Info.plist fingerprint changed"
fi
if ! /usr/bin/cmp -s "$repair_dir/stock-before/stock-preferences.sha256" "$repair_dir/stock-after/stock-preferences.sha256"; then
    fail "stock preference export fingerprint changed"
fi
if ! /usr/bin/cmp -s "$repair_dir/stock-before/receipt.sha256" "$repair_dir/stock-after/receipt.sha256" || ! /usr/bin/cmp -s "$repair_dir/stock-before/receipt" "$repair_dir/stock-after/receipt"; then
    fail "stock MAS receipt fingerprint changed"
fi
print -r -- "stock_app=unchanged" > "$repair_dir/stock-integrity.txt"
print -r -- "stock_preferences=unchanged" >> "$repair_dir/stock-integrity.txt"
print -r -- "stock_mas_receipt=unchanged" >> "$repair_dir/stock-integrity.txt"

print -r -- "status=repaired"
print -r -- "copied_app=$copied_app"
print -r -- "provenance=$repair_dir"

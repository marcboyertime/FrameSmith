#!/bin/zsh
# Read-only verifier for the one approved copied Final Cut artifact.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
destination_root="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole"
copied_app="$destination_root/Final Cut Pro - FCPCommandConsole.app"
copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"
expected_host_bundle_identifier="com.apple.FinalCut"
expected_copied_host_bundle_path="$copied_app"
expected_host_version="12.3"
expected_host_build="450152"
expected_stock_pre_injection_host_executable_sha256="6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390"
mas_receipt_relative_path="Contents/_MASReceipt/receipt"
expected_mas_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
source_onboarding_framework="$source_app/$onboarding_framework_relative_executable_path"
copied_onboarding_framework="$copied_app/$onboarding_framework_relative_executable_path"
onboarding_framework_load_path="@rpath/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
framework_name="FCPCommandConsoleRuntime.framework"
built_framework="$plugin_dir/build/$framework_name"
built_compatibility_policy="$built_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
embedded_framework="$copied_app/Contents/Frameworks/$framework_name"
embedded_runtime="$embedded_framework/Versions/A/FCPCommandConsoleRuntime"
embedded_compatibility_policy="$embedded_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
preferences_file="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
provenance_root="/Users/marcboyer/Movies/FCPCommandConsole/provenance"
verify_dir="$provenance_root/patch-$(/bin/date -u +%Y%m%dT%H%M%SZ)-verify-$$"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
required_added_entitlement="com.apple.security.cs.disable-library-validation"
removed_entitlements=(
    com.apple.application-identifier
    com.apple.developer.aps-environment
    com.apple.developer.icloud-container-environment
    com.apple.developer.icloud-container-identifiers
    com.apple.developer.icloud-services
    com.apple.developer.team-identifier
    com.apple.security.application-groups
    com.apple.security.automation.apple-events
    com.apple.security.scripting-targets
    com.apple.security.temporary-exception.apple-events
    keychain-access-groups
)

fail() {
    print -u2 -r -- "verify-copied-fcp: $1"
    exit 1
}

capture_preferences() {
    local output_dir="$1"
    if [[ -f "$preferences_file" ]]; then
        /usr/bin/plutil -convert xml1 -o "$output_dir/stock-preferences.xml" "$preferences_file"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    else
        print -r -- "absent" > "$output_dir/stock-preferences.xml"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    fi
}

capture_receipt() {
    local app_path="$1"
    local output_dir="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "MAS receipt is missing or not a regular file: $app_path"
    fi
    /bin/cp "$receipt_path" "$output_dir/receipt"
    /usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}' > "$output_dir/receipt.sha256"
}

verify_receipt() {
    local app_path="$1"
    local label="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "$label MAS receipt is missing or not a regular file"
    fi
    local receipt_sha256="$(/usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}')"
    if [[ "$receipt_sha256" != "$expected_mas_receipt_sha256" ]]; then
        fail "$label MAS receipt SHA-256 is not the reviewed value"
    fi
}

capture_bundle() {
    local app_path="$1"
    local executable_path="$2"
    local output_dir="$3"
    /bin/mkdir -p "$output_dir"
    /bin/cp "$app_path/Contents/Info.plist" "$output_dir/Info.plist"
    /usr/bin/shasum -a 256 "$executable_path" | /usr/bin/awk '{print $1}' > "$output_dir/main-executable.sha256"
    /usr/bin/shasum -a 256 "$app_path/Contents/Info.plist" | /usr/bin/awk '{print $1}' > "$output_dir/Info.plist.sha256"
    /usr/bin/codesign -dvvv "$app_path" > "$output_dir/codesign-metadata.txt" 2>&1
    /usr/bin/codesign -d -r- "$app_path" > "$output_dir/designated-requirement.txt" 2>&1
    /usr/bin/codesign -d --entitlements :- "$app_path" > "$output_dir/entitlements.plist" 2> "$output_dir/entitlements.stderr"
    /usr/bin/otool -arch arm64 -L "$executable_path" > "$output_dir/main-libraries-arm64.txt"
    /usr/bin/otool -arch x86_64 -L "$executable_path" > "$output_dir/main-libraries-x86_64.txt"
    /usr/bin/dwarfdump --uuid "$executable_path" > "$output_dir/main-executable.uuids.txt"
}

capture_onboarding_framework() {
    local framework_path="$1"
    local output_dir="$2"
    /usr/bin/shasum -a 256 "$framework_path" | /usr/bin/awk '{print $1}' > "$output_dir/onboarding-framework.sha256"
    /usr/bin/dwarfdump --uuid "$framework_path" > "$output_dir/onboarding-framework.uuids.txt"
    local framework_sha256="$(/usr/bin/awk '{print $1}' "$output_dir/onboarding-framework.sha256")"
    local framework_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    print -r -- "sha256=$framework_sha256" > "$output_dir/onboarding-framework.identity.txt"
    print -r -- "arm64_uuid=$framework_arm64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
    print -r -- "x86_64_uuid=$framework_x86_64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
}

verify_onboarding_framework_identity() {
    local output_dir="$1"
    local label="$2"
    local framework_sha256="$(/usr/bin/awk -F= '/^sha256=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_arm64_uuid="$(/usr/bin/awk -F= '/^arm64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk -F= '/^x86_64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    if [[ "$framework_sha256" != "$expected_onboarding_framework_sha256" || "$framework_arm64_uuid" != "$expected_onboarding_framework_arm64_uuid" || "$framework_x86_64_uuid" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "$label onboarding framework does not match the reviewed hash and slice UUIDs"
    fi
}

verify_onboarding_framework_load_path() {
    local executable_path="$1"
    local output_dir="$2"
    local label="$3"
    local architecture
    for architecture in arm64 x86_64; do
        /usr/bin/otool -arch "$architecture" -L "$executable_path" > "$output_dir/onboarding-framework-load-commands-$architecture.txt"
        local count="$(/usr/bin/grep -F -c "$onboarding_framework_load_path" "$output_dir/onboarding-framework-load-commands-$architecture.txt" || true)"
        if [[ "$count" != "1" ]]; then
            fail "$label main executable does not directly load exactly one reviewed onboarding framework in $architecture"
        fi
    done
}

compare_onboarding_framework_identity() {
    local first_output_dir="$1"
    local second_output_dir="$2"
    local label="$3"
    if ! /usr/bin/cmp -s "$first_output_dir/onboarding-framework.identity.txt" "$second_output_dir/onboarding-framework.identity.txt"; then
        fail "$label onboarding framework identity differs from stock provenance"
    fi
}

require_not_running() {
    local audit_file="$1"
    if /usr/bin/pgrep -fl 'Final Cut Pro' > "$audit_file"; then
        fail "Final Cut Pro is running; verifier will not proceed"
    fi
    print -r -- "no Final Cut Pro process observed" > "$audit_file"
}

verify_compatibility_policy() {
    local policy_path="$1"
    local label="$2"
    if ! /usr/bin/plutil -lint "$policy_path" >/dev/null; then
        fail "$label compatibility policy is invalid"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "6" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "$expected_host_bundle_identifier" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedCopiedHostBundlePath' "$policy_path")" != "$expected_copied_host_bundle_path" ]]; then
        fail "$label compatibility policy host bundle identifier is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "$expected_host_version" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "$expected_host_build" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedStockPreInjectionHostExecutableSHA256' "$policy_path")" != "$expected_stock_pre_injection_host_executable_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptRelativePath' "$policy_path")" != "$mas_receipt_relative_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptSHA256' "$policy_path")" != "$expected_mas_receipt_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "$onboarding_framework_relative_executable_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "$expected_onboarding_framework_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "$expected_onboarding_framework_arm64_uuid" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "$label compatibility policy host version/build or exact binary identity is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "1" ]]; then
        fail "$label compatibility policy method guard mode or phases are not exact"
    fi
    for removed_policy_key in CompatibilityInstallPhases MethodGuardLogSubsystem MethodGuardLogCategory PreferenceDomain ApprovedPreferenceKeys ApprovedPreferenceValues SynchronizeDeterministically; do
        if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
            fail "$label compatibility policy retains an obsolete scheduler or logger key"
        fi
    done
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "forward_original_setter_async_nil_metadata_provider" ]]; then
        fail "$label compatibility policy single onboarding query setter contract is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1' "$policy_path" >/dev/null 2>&1; then
        fail "$label compatibility policy permits an extra method replacement"
    fi
}

verify_entitlement_allowlist() {
    local stock_entitlements="$1"
    local expected_entitlements="$2"
    local signed_entitlements="$3"
    local output_dir="$4"
    local expected_binary="$output_dir/expected-entitlements.bplist"
    local signed_binary="$output_dir/signed-entitlements.bplist"
    local expected_canonical="$output_dir/expected-entitlements.canonical.plist"
    local signed_canonical="$output_dir/signed-entitlements.canonical.plist"

    for entitlement_key in "${removed_entitlements[@]}"; do
        if ! /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$stock_entitlements" >/dev/null 2>&1; then
            fail "captured stock entitlements do not contain required removable key: $entitlement_key"
        fi
        if /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$expected_entitlements" >/dev/null 2>&1; then
            fail "generated local entitlements retained removable key: $entitlement_key"
        fi
        if /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$signed_entitlements" >/dev/null 2>&1; then
            fail "signed copied app retained removable key: $entitlement_key"
        fi
    done
    if /usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$stock_entitlements" >/dev/null 2>&1; then
        fail "captured stock policy unexpectedly already contains the required added entitlement"
    fi
    for entitlement_file in "$expected_entitlements" "$signed_entitlements"; do
        if [[ "$(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' "$entitlement_file")" != "true" ]]; then
            fail "copied app entitlement policy does not retain com.apple.security.app-sandbox=true"
        fi
        if [[ "$(/usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$entitlement_file")" != "true" ]]; then
            fail "copied app entitlement policy does not require $required_added_entitlement=true"
        fi
    done
    for forbidden_added_key in com.apple.security.get-task-allow com.apple.security.cs.debugger com.apple.security.cs.allow-dyld-environment-variables; do
        if /usr/libexec/PlistBuddy -c "Print :$forbidden_added_key" "$signed_entitlements" >/dev/null 2>&1; then
            fail "forbidden added entitlement is present: $forbidden_added_key"
        fi
    done
    /usr/bin/plutil -convert binary1 -o "$expected_binary" "$expected_entitlements"
    /usr/bin/plutil -convert xml1 -o "$expected_canonical" "$expected_binary"
    /usr/bin/plutil -convert binary1 -o "$signed_binary" "$signed_entitlements"
    /usr/bin/plutil -convert xml1 -o "$signed_canonical" "$signed_binary"
    if ! /usr/bin/cmp -s "$expected_canonical" "$signed_canonical"; then
        fail "signed copied-app entitlement diff contains an unallowed addition, removal, or change"
    fi
    "$entitlement_verifier" "$stock_entitlements" "$expected_entitlements" "$signed_entitlements" "$allowlist" > "$output_dir/entitlement-allowlist.txt"
    /usr/bin/shasum -a 256 "$allowlist" | /usr/bin/awk '{print $1}' > "$output_dir/patch-entitlement-allowlist-config.sha256"
}

if [[ ! -d "$source_app" || ! -f "$source_executable" || ! -f "$source_onboarding_framework" ]]; then
    fail "required source app is missing"
fi
if [[ ! -d "$copied_app" || ! -f "$copied_executable" || ! -f "$copied_onboarding_framework" || ! -f "$embedded_runtime" || ! -f "$embedded_compatibility_policy" ]]; then
    fail "approved copied artifact or embedded runtime is missing"
fi
if [[ ! -d "$built_framework" || ! -f "$built_compatibility_policy" || ! -f "$allowlist" || ! -x "$entitlement_verifier" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before verification"
fi
source_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$source_app/Contents/Info.plist")"
source_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$source_app/Contents/Info.plist")"
if [[ "$source_version" != "$expected_host_version" || "$source_build" != "$expected_host_build" ]]; then
    fail "source app version/build guard failed (expected 12.3/450152)"
fi

/bin/mkdir -p "$provenance_root"
if [[ -e "$verify_dir" ]]; then
    fail "unique verification provenance destination already exists"
fi
/bin/mkdir "$verify_dir"
require_not_running "$verify_dir/process-before-verify.txt"
capture_bundle "$source_app" "$source_executable" "$verify_dir/stock-current"
capture_preferences "$verify_dir/stock-current"
capture_receipt "$source_app" "$verify_dir/stock-current"
verify_receipt "$source_app" "stock-current"
capture_bundle "$copied_app" "$copied_executable" "$verify_dir/copied-current"
capture_receipt "$copied_app" "$verify_dir/copied-current"
verify_receipt "$copied_app" "copied-current"
capture_onboarding_framework "$source_onboarding_framework" "$verify_dir/stock-current"
capture_onboarding_framework "$copied_onboarding_framework" "$verify_dir/copied-current"
verify_onboarding_framework_identity "$verify_dir/stock-current" "stock-current"
verify_onboarding_framework_identity "$verify_dir/copied-current" "copied-current"
compare_onboarding_framework_identity "$verify_dir/stock-current" "$verify_dir/copied-current" "copied-current"
if ! /usr/bin/cmp -s "$verify_dir/stock-current/receipt" "$verify_dir/copied-current/receipt" || ! /usr/bin/cmp -s "$verify_dir/stock-current/receipt.sha256" "$verify_dir/copied-current/receipt.sha256"; then
    fail "copied MAS receipt differs from stock provenance"
fi
verify_onboarding_framework_load_path "$source_executable" "$verify_dir/stock-current" "stock-current"
verify_onboarding_framework_load_path "$copied_executable" "$verify_dir/copied-current" "copied-current"
source_executable_sha256="$(/usr/bin/awk '{print $1}' "$verify_dir/stock-current/main-executable.sha256")"
source_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$verify_dir/stock-current/main-executable.uuids.txt")"
source_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$verify_dir/stock-current/main-executable.uuids.txt")"
copied_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$verify_dir/copied-current/main-executable.uuids.txt")"
copied_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$verify_dir/copied-current/main-executable.uuids.txt")"
if [[ "$source_executable_sha256" != "$expected_stock_pre_injection_host_executable_sha256" || "$source_arm64_uuid" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$source_x86_64_uuid" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$copied_arm64_uuid" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$copied_x86_64_uuid" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" ]]; then
    fail "stock or copied executable does not match the reviewed FCP 12.3 slice identity"
fi
print -r -- "stock_executable_sha256=$source_executable_sha256" > "$verify_dir/exact-host-identity.txt"
print -r -- "stock_arm64_uuid=$source_arm64_uuid" >> "$verify_dir/exact-host-identity.txt"
print -r -- "stock_x86_64_uuid=$source_x86_64_uuid" >> "$verify_dir/exact-host-identity.txt"
print -r -- "copied_arm64_uuid=$copied_arm64_uuid" >> "$verify_dir/exact-host-identity.txt"
print -r -- "copied_x86_64_uuid=$copied_x86_64_uuid" >> "$verify_dir/exact-host-identity.txt"

initial_patch_dir=""
initial_patch_receipt_provenance="false"
for candidate in "$provenance_root"/patch-*; do
    if [[ -f "$candidate/stock-before/main-executable.sha256" && -f "$candidate/stock-before/Info.plist.sha256" && -f "$candidate/stock-before/stock-preferences.sha256" && -f "$candidate/copied-main-executable.pre-injection.sha256" ]]; then
        initial_patch_dir="$candidate"
        if [[ -f "$candidate/stock-before/receipt.sha256" && -f "$candidate/stock-before/receipt" ]]; then
            initial_patch_receipt_provenance="true"
        fi
        break
    fi
done
if [[ -z "$initial_patch_dir" ]]; then
    fail "initial patch provenance is missing"
fi
print -r -- "initial_patch_provenance=$initial_patch_dir" > "$verify_dir/initial-provenance.txt"
print -r -- "initial_patch_receipt_provenance=$initial_patch_receipt_provenance" >> "$verify_dir/initial-provenance.txt"

if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/main-executable.sha256" "$verify_dir/stock-current/main-executable.sha256"; then
    fail "stock main executable fingerprint differs from initial patch evidence"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/Info.plist.sha256" "$verify_dir/stock-current/Info.plist.sha256"; then
    fail "stock Info.plist fingerprint differs from initial patch evidence"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/stock-preferences.sha256" "$verify_dir/stock-current/stock-preferences.sha256"; then
    fail "stock preference export fingerprint differs from initial patch evidence"
fi
if [[ "$initial_patch_receipt_provenance" == "true" ]]; then
    if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt.sha256" "$verify_dir/stock-current/receipt.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt" "$verify_dir/stock-current/receipt"; then
        fail "stock MAS receipt fingerprint differs from initial patch evidence"
    fi
else
    print -r -- "legacy_receipt_provenance=rebound_to_current_stock_copy_proof" >> "$verify_dir/initial-provenance.txt"
fi
if ! /usr/bin/cmp -s "$initial_patch_dir/copied-main-executable.pre-injection.sha256" "$verify_dir/stock-current/main-executable.sha256"; then
    fail "captured pre-injection copied executable differs from stock fingerprint"
fi

copied_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")"
copied_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$copied_app/Contents/Info.plist")"
copied_display_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$copied_app/Contents/Info.plist")"
copied_executable_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$copied_app/Contents/Info.plist")"

elif "$entitlement_verifier" --verify-legacy-migration-input "$update_dir/stock-before/entitlements.plist" "$update_dir/copied-before/entitlements.plist" "$allowlist" > "$update_dir/entitlement-legacy-migration-input.txt" 2>&1; then
    migration_required="true"
    print -r -- "entitlement_state=exact_retired_sandboxed_copy" > "$update_dir/migration-gate.txt"
else
    fail "copied app is neither the exact canonical policy nor the exact one-time sandboxed migration input"
fi
print -r -- "migration_required=$migration_required" >> "$update_dir/migration-gate.txt"
print -r -- "resolved_migration_required=$migration_required" >> "$update_dir/copied-identity.txt"

initial_patch_dir=""
initial_patch_receipt_provenance="false"
receipt_provenance_classification="unresolved"
schema7_source_update_dir=""
schema8_source_update_dir=""
current_policy_schema=""
for candidate in "$provenance_root"/patch-*; do
    if [[ -f "$candidate/stock-before/main-executable.sha256" && -f "$candidate/stock-before/Info.plist.sha256" && -f "$candidate/stock-before/stock-preferences.sha256" && -f "$candidate/copied-main-executable.pre-injection.sha256" ]]; then
        initial_patch_dir="$candidate"
        if [[ -f "$candidate/stock-before/receipt.sha256" && -f "$candidate/stock-before/receipt" ]]; then
            initial_patch_receipt_provenance="true"
        fi
        break
    fi
done
if [[ -z "$initial_patch_dir" || ! -f "$initial_patch_dir/signing.txt" ]]; then
    fail "initial patch provenance or signing evidence is missing"
fi
print -r -- "initial_patch_provenance=$initial_patch_dir" > "$update_dir/initial-provenance.txt"
print -r -- "initial_patch_receipt_provenance=$initial_patch_receipt_provenance" >> "$update_dir/initial-provenance.txt"
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/main-executable.sha256" "$update_dir/stock-before/main-executable.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/Info.plist.sha256" "$update_dir/stock-before/Info.plist.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/stock-preferences.sha256" "$update_dir/stock-before/stock-preferences.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/copied-main-executable.pre-injection.sha256" "$update_dir/stock-before/main-executable.sha256"; then
    fail "stock app or production preference baseline differs from initial patch evidence"
fi
current_policy_schema="$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$embedded_compatibility_policy")"
if [[ "$current_policy_schema" == "10" ]]; then
    if [[ "$migration_required" != "false" ]]; then
        fail "the exact Schema-10 completed-update source must retain the canonical copied-app entitlement endpoint"
    fi
    verify_exact_schema10_complete_update_provenance
    receipt_provenance_classification="exact_schema10_complete_update_provenance"
elif [[ "$current_policy_schema" == "9" ]]; then
    if [[ "$migration_required" != "false" ]]; then
        fail "the exact Schema-9 completed-update source must retain the canonical copied-app entitlement endpoint"
    fi
    verify_exact_schema9_complete_update_provenance
    receipt_provenance_classification="exact_schema9_complete_update_provenance"
elif [[ "$current_policy_schema" == "8" ]]; then
    if [[ "$migration_required" != "false" ]]; then
        fail "the exact Schema-8 completed-update source must retain the canonical copied-app entitlement endpoint"
    fi
    verify_exact_schema8_complete_update_provenance
    receipt_provenance_classification="exact_schema8_complete_update_provenance"
elif [[ "$current_policy_schema" == "7" ]]; then
    if [[ "$migration_required" != "false" ]]; then
        fail "the exact Schema-7 completed-update source must retain the canonical copied-app entitlement endpoint"
    fi
    verify_exact_schema7_complete_update_provenance
    receipt_provenance_classification="exact_schema7_complete_update_provenance"
elif [[ "$initial_patch_receipt_provenance" == "true" ]]; then
    if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt.sha256" "$update_dir/stock-before/receipt.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/receipt" "$update_dir/stock-before/receipt"; then
        fail "stock MAS receipt differs from receipt provenance captured by the initial patch"
    fi
    receipt_provenance_classification="complete_initial_receipt_provenance"
elif [[ "$migration_required" == "true" ]]; then
    print -r -- "legacy_receipt_provenance=rebound_to_current_stock_copy_proof" >> "$update_dir/initial-provenance.txt"
    receipt_provenance_classification="exact_retired_sandboxed_copy_rebind"
elif [[ "$migration_required" == "false" ]]; then
    if [[ "$current_policy_schema" != "6" ]]; then
        fail "current copied app is neither an exact completed Schema-7 or Schema-8 source nor the historical Schema-6 rebind source"
    fi
    if [[ -L "$initial_patch_dir/signing.txt" || -L "$initial_patch_dir/stock-before/main-executable.sha256" || -L "$initial_patch_dir/stock-before/Info.plist.sha256" || -L "$initial_patch_dir/stock-before/stock-preferences.sha256" || -L "$initial_patch_dir/copied-main-executable.pre-injection.sha256" ]]; then
        fail "exact Schema-6 receipt-provenance rebind requires ordinary historical baseline files"
    fi
    verify_exact_canonical_schema6_missing_receipt_provenance_rebind
    receipt_provenance_classification="exact_canonical_schema6_missing_receipt_provenance_rebind"
else
    fail "current copied app update requires receipt provenance from the initial patch"
fi
print -r -- "receipt_provenance_classification=$receipt_provenance_classification" >> "$update_dir/initial-provenance.txt"
print -r -- "receipt_provenance_classification=$receipt_provenance_classification" >> "$update_dir/copied-identity.txt"

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$update_dir/codesign-verify-before.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$update_dir/runtime-codesign-verify-before.txt" 2>&1
verify_load_commands "before"
if [[ "$copied_app" != "$expected_copied_host_bundle_path" ]]; then
    fail "copied app path is not the exact approved isolated path"
fi

for forbidden_added_key in com.apple.security.get-task-allow com.apple.security.cs.debugger com.apple.security.cs.allow-dyld-environment-variables; do
    if /usr/libexec/PlistBuddy -c "Print :$forbidden_added_key" "$update_dir/copied-before/entitlements.plist" >/dev/null 2>&1; then
        fail "current copied app contains forbidden entitlement: $forbidden_added_key"
    fi
done
if [[ ! -f "$embedded_compatibility_policy" || -L "$embedded_compatibility_policy" ]]; then
    fail "copied runtime compatibility policy is missing"
fi
if [[ "$receipt_provenance_classification" != "exact_canonical_schema6_missing_receipt_provenance_rebind" && "$receipt_provenance_classification" != "exact_schema7_complete_update_provenance" && "$receipt_provenance_classification" != "exact_schema8_complete_update_provenance" && "$receipt_provenance_classification" != "exact_schema9_complete_update_provenance" && "$receipt_provenance_classification" != "exact_schema10_complete_update_provenance" ]]; then
    # Historical Schema-6 and exact Schema-7/Schema-8/Schema-9/Schema-10
    # baselines each verify their own source policy. Every generated target is Schema-11.
    verify_compatibility_policy "$embedded_compatibility_policy" "current"
fi
verify_compatibility_policy "$built_compatibility_policy" "built"
/usr/bin/shasum -a 256 "$built_runtime" | /usr/bin/awk '{print $1}' > "$update_dir/built-runtime.sha256"
/usr/bin/shasum -a 256 "$built_compatibility_policy" | /usr/bin/awk '{print $1}' > "$update_dir/built-compatibility-policy.sha256"

# Resolve and bind the signing identity before any copied-app mutation.
signing_identity="$(/usr/bin/security find-identity -v -p codesigning | /usr/bin/awk '/"Apple Development:/ {print $2; exit}')"
if [[ -z "$signing_identity" ]]; then
    fail "the required Apple Development signing identity is unavailable"
fi
initial_identity="$(/usr/bin/awk -F= '/^identity_fingerprint=/{print $2; exit}' "$initial_patch_dir/signing.txt")"
if [[ -z "$initial_identity" || "$signing_identity" != "$initial_identity" ]]; then
    fail "the available Apple Development identity does not match the initial copied-app signing evidence"
fi

rollback_dir="$update_dir/rollback"
/bin/mkdir "$rollback_dir"
print -r -- "rollback_backup=complete_previous_app" > "$rollback_dir/backup.txt"
print -r -- "rollback_pending=true" >> "$rollback_dir/backup.txt"

require_not_running "$update_dir/process-before-staging.txt"
mutation_started="true"
/usr/bin/ditto "$live_copied_app" "$stage_app"
capture_bundle_manifest "$live_copied_app" "$update_dir/copied-before/whole-bundle.manifest"
capture_bundle_manifest "$stage_app" "$update_dir/staged-before.manifest"
if ! /usr/bin/cmp -s "$update_dir/copied-before/whole-bundle.manifest" "$update_dir/staged-before.manifest"; then
    fail "complete staged copy differs from the current copied app before mutation"
fi
bind_copied_paths "$stage_app"

print -r -- "signing_mode=apple_development" > "$update_dir/signing.txt"
print -r -- "identity_fingerprint=$signing_identity" >> "$update_dir/signing.txt"
print -r -- "runtime_signature_operation=project_owned_framework_only" >> "$update_dir/signing.txt"
print -r -- "app_signature_operation=top_level_copied_app_only" >> "$update_dir/signing.txt"
print -r -- "deep_signing=false" >> "$update_dir/signing.txt"

require_not_running "$update_dir/process-before-runtime-copy.txt"
/bin/mv "$embedded_framework" "$rollback_dir/staged-retired-runtime-framework"
/usr/bin/ditto "$built_framework" "$embedded_framework"
capture_bundle_manifest "$built_framework" "$update_dir/built-runtime-framework.manifest"
capture_bundle_manifest "$embedded_framework" "$update_dir/staged-runtime-framework-before-signing.manifest"
if ! /usr/bin/cmp -s "$update_dir/built-runtime-framework.manifest" "$update_dir/staged-runtime-framework-before-signing.manifest"; then
    fail "fresh staged project runtime framework differs from the complete built framework manifest"
fi
if ! /usr/bin/cmp -s "$built_runtime" "$embedded_runtime" || ! /usr/bin/cmp -s "$built_compatibility_policy" "$embedded_compatibility_policy"; then
    fail "fresh built framework was not copied exactly into the approved copied app"
fi
verify_compatibility_policy "$embedded_compatibility_policy" "embedded"
require_not_running "$update_dir/process-before-signing.txt"
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none "$embedded_framework" > "$update_dir/sign-runtime.stdout" 2> "$update_dir/sign-runtime.stderr"; then
    fail "project-owned embedded runtime signing failed"
fi
top_level_entitlements="$update_dir/top-level-current-entitlements.plist"
/bin/cp "$expected_entitlements" "$top_level_entitlements"
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none --entitlements "$top_level_entitlements" "$copied_app" > "$update_dir/sign-app.stdout" 2> "$update_dir/sign-app.stderr"; then
    fail "copied top-level app signing failed"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$update_dir/codesign-verify-after.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$update_dir/runtime-codesign-verify-after.txt" 2>&1
capture_bundle "$copied_app" "$copied_executable" "$update_dir/copied-after"
capture_receipt "$copied_app" "$update_dir/copied-after"
verify_receipt "$copied_app" "copied-after"
capture_onboarding_framework "$copied_onboarding_framework" "$update_dir/copied-after"
verify_onboarding_framework_identity "$update_dir/copied-after" "copied-after"
compare_onboarding_framework_identity "$update_dir/stock-before" "$update_dir/copied-after" "copied-after"
compare_onboarding_framework_identity "$update_dir/copied-before" "$update_dir/copied-after" "copied-after"
verify_onboarding_framework_load_path "$copied_executable" "$update_dir/copied-after" "copied-after"
verify_load_commands "after"
copied_after_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$update_dir/copied-after/main-executable.uuids.txt")"
copied_after_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$update_dir/copied-after/main-executable.uuids.txt")"
if [[ "$copied_after_arm64_uuid" != "$copied_arm64_uuid" || "$copied_after_x86_64_uuid" != "$copied_x86_64_uuid" ]]; then
    fail "copied executable slice UUID changed during the runtime-only update"
fi
verify_compatibility_policy "$embedded_compatibility_policy" "embedded-after-signing"
if ! /usr/bin/cmp -s "$built_compatibility_policy" "$embedded_compatibility_policy"; then
    fail "embedded compatibility policy changed during signing"
fi
if [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")" != "$expected_host_bundle_identifier" ]]; then
    fail "staged copied app did not retain the receipt-compatible Apple ID"
fi
if ! /usr/bin/cmp -s "$update_dir/copied-before/Info.plist.sha256" "$update_dir/copied-after/Info.plist.sha256"; then
    fail "copied app Info.plist changed during the entitlement-only runtime update"
fi
if ! /usr/bin/cmp -s "$update_dir/stock-before/receipt" "$update_dir/copied-after/receipt" || ! /usr/bin/cmp -s "$update_dir/stock-before/receipt.sha256" "$update_dir/copied-after/receipt.sha256"; then
    fail "copied MAS receipt changed during runtime update"
fi
"$entitlement_verifier" "$update_dir/stock-before/entitlements.plist" "$expected_entitlements" "$update_dir/copied-after/entitlements.plist" "$allowlist" > "$update_dir/entitlement-allowlist-after.txt"
/usr/bin/shasum -a 256 "$embedded_runtime" | /usr/bin/awk '{print $1}' > "$update_dir/embedded-runtime-after-signing.sha256"
/usr/bin/shasum -a 256 "$embedded_compatibility_policy" | /usr/bin/awk '{print $1}' > "$update_dir/embedded-compatibility-policy-after-signing.sha256"
capture_bundle_manifest "$stage_app" "$update_dir/staged-verified.manifest"

# The live path remains byte-for-byte untouched until the entire staged app has
# passed identity, receipt, runtime, entitlement, and signature verification.
require_not_running "$update_dir/process-before-atomic-swap.txt"
"$atomic_swap_helper" "$live_copied_app" "$stage_app" > "$update_dir/atomic-swap.txt"
swap_complete="true"
/bin/mv "$stage_app" "$previous_app"
if [[ ! -d "$previous_app" || -L "$previous_app" ]]; then
    fail "the full previous copied app was not retained in provenance"
fi
bind_copied_paths "$live_copied_app"
require_not_running "$update_dir/process-after-atomic-swap.txt"
/usr/bin/codesign --verify --deep --strict --verbose=4 "$live_copied_app" > "$update_dir/codesign-verify-installed.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$update_dir/runtime-codesign-verify-installed.txt" 2>&1
capture_bundle_manifest "$live_copied_app" "$update_dir/copied-installed.manifest"
if ! /usr/bin/cmp -s "$update_dir/staged-verified.manifest" "$update_dir/copied-installed.manifest"; then
    fail "atomically installed app differs from the fully verified staged app"
fi
capture_bundle "$live_copied_app" "$copied_executable" "$update_dir/copied-installed"
capture_receipt "$live_copied_app" "$update_dir/copied-installed"
verify_receipt "$live_copied_app" "copied-installed"
"$entitlement_verifier" "$update_dir/stock-before/entitlements.plist" "$expected_entitlements" "$update_dir/copied-installed/entitlements.plist" "$allowlist" > "$update_dir/entitlement-allowlist-installed.txt"
verify_load_commands "installed"
verify_compatibility_policy "$embedded_compatibility_policy" "embedded-installed"

capture_bundle "$source_app" "$source_executable" "$update_dir/stock-after"
capture_preferences "$update_dir/stock-after"
capture_bundle_manifest "$source_app" "$update_dir/stock-after/whole-bundle.manifest"
capture_receipt "$source_app" "$update_dir/stock-after"
verify_receipt "$source_app" "stock-after"
capture_onboarding_framework "$source_onboarding_framework" "$update_dir/stock-after"
verify_onboarding_framework_identity "$update_dir/stock-after" "stock-after"
compare_onboarding_framework_identity "$update_dir/stock-before" "$update_dir/stock-after" "stock-after"
require_not_running "$update_dir/process-after-update.txt"
if ! /usr/bin/cmp -s "$update_dir/stock-before/whole-bundle.manifest" "$update_dir/stock-after/whole-bundle.manifest" || ! /usr/bin/cmp -s "$update_dir/stock-before/main-executable.sha256" "$update_dir/stock-after/main-executable.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/main-executable.uuids.txt" "$update_dir/stock-after/main-executable.uuids.txt" || ! /usr/bin/cmp -s "$update_dir/stock-before/Info.plist.sha256" "$update_dir/stock-after/Info.plist.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/container-preferences.sha256" "$update_dir/stock-after/container-preferences.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/noncontainer-preferences.sha256" "$update_dir/stock-after/noncontainer-preferences.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/receipt.sha256" "$update_dir/stock-after/receipt.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/receipt" "$update_dir/stock-after/receipt"; then
    fail "stock app or production preference fingerprint changed"
fi
print -r -- "stock_app=unchanged" > "$update_dir/stock-integrity.txt"
print -r -- "stock_whole_bundle_manifest=unchanged" >> "$update_dir/stock-integrity.txt"
print -r -- "stock_container_preferences=unchanged" >> "$update_dir/stock-integrity.txt"
print -r -- "stock_noncontainer_preferences=unchanged" >> "$update_dir/stock-integrity.txt"
print -r -- "stock_info_plist=unchanged" >> "$update_dir/stock-integrity.txt"
print -r -- "stock_mas_receipt=unchanged" >> "$update_dir/stock-integrity.txt"
print -r -- "previous_complete_copy=$previous_app" >> "$rollback_dir/backup.txt"
print -r -- "rollback=not_needed_previous_complete_copy_retained" >> "$rollback_dir/rollback.txt"
print -r -- "rollback_pending=false" >> "$rollback_dir/backup.txt"
rollback_complete="true"
mutation_started="false"
trap - EXIT

print -r -- "status=updated"
print -r -- "copied_app=$live_copied_app"
print -r -- "previous_complete_copy=$previous_app"
print -r -- "provenance=$update_dir"

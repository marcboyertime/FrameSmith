rollback_on_exit() {
    local exit_status="$?"
    if [[ "$exit_status" -eq 0 || "$mutation_started" != "true" || "$rollback_complete" == "true" ]]; then
        return
    fi
    set +e
    /bin/mkdir -p "$rollback_dir"
    print -r -- "rollback=started exit_status=$exit_status swap_complete=$swap_complete" >> "$rollback_dir/rollback.txt"
    local retained_previous=""
    if [[ -d "$previous_app" && ! -L "$previous_app" ]]; then
        retained_previous="$previous_app"
    elif [[ -d "$stage_app" && ! -L "$stage_app" ]]; then
        retained_previous="$stage_app"
    fi
    if [[ "$swap_complete" == "true" && -n "$retained_previous" && -d "$live_copied_app" && ! -L "$live_copied_app" ]]; then
        if "$atomic_swap_helper" "$live_copied_app" "$retained_previous" >> "$rollback_dir/rollback.txt" 2>&1; then
            print -r -- "rollback=restored_previous_complete_copy" >> "$rollback_dir/rollback.txt"
            /usr/bin/codesign --verify --deep --strict --verbose=4 "$live_copied_app" > "$rollback_dir/codesign-verify-rollback.txt" 2>&1
        else
            print -r -- "rollback=failed_atomic_complete_copy_restore" >> "$rollback_dir/rollback.txt"
        fi
    elif [[ -d "$stage_app" && ! -L "$stage_app" ]]; then
        /bin/mv "$stage_app" "$rollback_dir/failed-staged-copy.app"
        print -r -- "rollback=live_copy_never_swapped failed_stage_retained" >> "$rollback_dir/rollback.txt"
    fi
    rollback_complete="true"
    set -e
}

trap rollback_on_exit EXIT

capture_preferences() {
    local output_dir="$1"
    local label preference_path
    for label preference_path in container "$container_preferences_file" noncontainer "$noncontainer_preferences_file"; do
        if [[ -f "$preference_path" && ! -L "$preference_path" ]]; then
            /usr/bin/plutil -convert xml1 -o "$output_dir/$label-preferences.xml" "$preference_path"
        elif [[ ! -e "$preference_path" ]]; then
            print -r -- "absent" > "$output_dir/$label-preferences.xml"
        else
            fail "$label Final Cut preference path is not an ordinary file"
        fi
        /usr/bin/shasum -a 256 "$output_dir/$label-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/$label-preferences.sha256"
    done
    /bin/cp "$output_dir/container-preferences.xml" "$output_dir/stock-preferences.xml"
    /bin/cp "$output_dir/container-preferences.sha256" "$output_dir/stock-preferences.sha256"
}

capture_bundle_manifest() {
    local app_path="$1"
    local output_file="$2"
    if [[ ! -d "$app_path" || -L "$app_path" ]]; then
        fail "bundle manifest target is not a real directory: $app_path"
    fi
    local entry relative digest_line digest full_path target
    {
        print -r -- "FCPCC_BUNDLE_MANIFEST_V2"
        # Batch all file paths into a small number of shasum processes. This
        # preserves byte-level coverage without spawning once per bundle file.
        /usr/bin/find -s "$app_path" -type f -print0 |
            /usr/bin/xargs -0 /usr/bin/shasum -a 256 |
            while IFS= read -r digest_line; do
                digest="${digest_line%% *}"
                full_path="${digest_line#*  }"
                if [[ "$full_path" == "$digest_line" || "$full_path" != "$app_path"/* ]]; then
                    fail "bundle file hash output is malformed or outside the exact bundle root"
                fi
                relative="${full_path#$app_path}"
                print -r -- "F\t$digest\t$relative"
            done
        while IFS= read -r entry; do
            relative="${entry#$app_path}"
            target="$(/usr/bin/readlink "$entry")"
            print -r -- "L\t$relative\t$target"
        done < <(/usr/bin/find -s "$app_path" -type l -print)
        while IFS= read -r entry; do
            relative="${entry#$app_path}"
            [[ -n "$relative" ]] || relative="."
            print -r -- "D\t$relative"
        done < <(/usr/bin/find -s "$app_path" -type d -print)
    } > "$output_file"
}

require_distinct_files() {
    local first="$1"
    local second="$2"
    local label="$3"
    if [[ ! -f "$first" || -L "$first" || ! -f "$second" || -L "$second" ]]; then
        fail "$label inputs are not distinct ordinary files"
    fi
    if [[ "$(/usr/bin/stat -f '%d:%i' "$first")" == "$(/usr/bin/stat -f '%d:%i' "$second")" ]]; then
        fail "$label stock and copied paths resolve to the same device/inode"
    fi
}

require_canonical_directory() {

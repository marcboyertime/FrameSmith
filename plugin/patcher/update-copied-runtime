#!/bin/zsh
# Exact-target updater for the project-owned runtime in the isolated Final Cut copy.
# It never launches Final Cut, opens a library, or deep-signs nested Apple code.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
destination_root="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole"
copied_app="$destination_root/Final Cut Pro - FCPCommandConsole.app"
copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
source_onboarding_framework="$source_app/$onboarding_framework_relative_executable_path"
copied_onboarding_framework="$copied_app/$onboarding_framework_relative_executable_path"
onboarding_framework_load_path="@rpath/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
framework_name="FCPCommandConsoleRuntime.framework"
built_framework="$plugin_dir/build/$framework_name"
built_runtime="$built_framework/Versions/A/FCPCommandConsoleRuntime"
built_compatibility_policy="$built_framework/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
embedded_framework="$copied_app/Contents/Frameworks/$framework_name"
embedded_runtime="$embedded_framework/Versions/A/FCPCommandConsoleRuntime"
embedded_compatibility_policy="$embedded_framework/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
preferences_file="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
provenance_root="/Users/marcboyer/Movies/FCPCommandConsole/provenance"
update_dir="$provenance_root/patch-$(/bin/date -u +%Y%m%dT%H%M%SZ)-update-runtime-$$"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
required_added_entitlement="com.apple.security.cs.disable-library-validation"
removed_entitlements=(
    com.apple.application-identifier
    com.apple.developer.aps-environment
    com.apple.developer.icloud-container-environment
    com.apple.developer.icloud-container-identifiers
    com.apple.developer.icloud-services
    com.apple.developer.team-identifier
    com.apple.security.application-groups
    com.apple.security.automation.apple-events
    com.apple.security.scripting-targets
    com.apple.security.temporary-exception.apple-events
    keychain-access-groups
)

fail() {
    print -u2 -r -- "update-copied-runtime: $1"
    exit 1
}

capture_preferences() {
    local output_dir="$1"
    if [[ -f "$preferences_file" ]]; then
        /usr/bin/plutil -convert xml1 -o "$output_dir/stock-preferences.xml" "$preferences_file"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    else
        print -r -- "absent" > "$output_dir/stock-preferences.xml"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    fi
}

capture_bundle() {
    local app_path="$1"
    local executable_path="$2"
    local output_dir="$3"
    /bin/mkdir -p "$output_dir"
    /bin/cp "$app_path/Contents/Info.plist" "$output_dir/Info.plist"
    /usr/bin/shasum -a 256 "$executable_path" | /usr/bin/awk '{print $1}' > "$output_dir/main-executable.sha256"
    /usr/bin/shasum -a 256 "$app_path/Contents/Info.plist" | /usr/bin/awk '{print $1}' > "$output_dir/Info.plist.sha256"
    /usr/bin/codesign -dvvv "$app_path" > "$output_dir/codesign-metadata.txt" 2>&1
    /usr/bin/codesign -d -r- "$app_path" > "$output_dir/designated-requirement.txt" 2>&1
    /usr/bin/codesign -d --entitlements :- "$app_path" > "$output_dir/entitlements.plist" 2> "$output_dir/entitlements.stderr"
    /usr/bin/otool -arch arm64 -L "$executable_path" > "$output_dir/main-libraries-arm64.txt"
    /usr/bin/otool -arch x86_64 -L "$executable_path" > "$output_dir/main-libraries-x86_64.txt"
    /usr/bin/dwarfdump --uuid "$executable_path" > "$output_dir/main-executable.uuids.txt"
}

capture_onboarding_framework() {
    local framework_path="$1"
    local output_dir="$2"
    /usr/bin/shasum -a 256 "$framework_path" | /usr/bin/awk '{print $1}' > "$output_dir/onboarding-framework.sha256"
    /usr/bin/dwarfdump --uuid "$framework_path" > "$output_dir/onboarding-framework.uuids.txt"
    local framework_sha256="$(/usr/bin/awk '{print $1}' "$output_dir/onboarding-framework.sha256")"
    local framework_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    print -r -- "sha256=$framework_sha256" > "$output_dir/onboarding-framework.identity.txt"
    print -r -- "arm64_uuid=$framework_arm64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
    print -r -- "x86_64_uuid=$framework_x86_64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
}

verify_onboarding_framework_identity() {
    local output_dir="$1"
    local label="$2"
    local framework_sha256="$(/usr/bin/awk -F= '/^sha256=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_arm64_uuid="$(/usr/bin/awk -F= '/^arm64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk -F= '/^x86_64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    if [[ "$framework_sha256" != "$expected_onboarding_framework_sha256" || "$framework_arm64_uuid" != "$expected_onboarding_framework_arm64_uuid" || "$framework_x86_64_uuid" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "$label onboarding framework does not match the reviewed hash and slice UUIDs"
    fi
}

verify_onboarding_framework_load_path() {
    local executable_path="$1"
    local output_dir="$2"
    local label="$3"
    local architecture
    for architecture in arm64 x86_64; do
        /usr/bin/otool -arch "$architecture" -L "$executable_path" > "$output_dir/onboarding-framework-load-commands-$architecture.txt"
        local count="$(/usr/bin/grep -F -c "$onboarding_framework_load_path" "$output_dir/onboarding-framework-load-commands-$architecture.txt" || true)"
        if [[ "$count" != "1" ]]; then
            fail "$label main executable does not directly load exactly one reviewed onboarding framework in $architecture"
        fi
    done
}

compare_onboarding_framework_identity() {
    local first_output_dir="$1"
    local second_output_dir="$2"
    local label="$3"
    if ! /usr/bin/cmp -s "$first_output_dir/onboarding-framework.identity.txt" "$second_output_dir/onboarding-framework.identity.txt"; then
        fail "$label onboarding framework identity differs from stock provenance"
    fi
}

require_not_running() {
    local audit_file="$1"
    if /usr/bin/pgrep -fl 'Final Cut Pro' > "$audit_file"; then
        fail "a Final Cut Pro process is running; updater was not attempted"
    fi
    print -r -- "no Final Cut Pro process observed" > "$audit_file"
}

verify_load_commands() {
    local phase="$1"
    local copied_arm64="$update_dir/copied-load-commands-$phase-arm64.txt"
    local copied_x86_64="$update_dir/copied-load-commands-$phase-x86_64.txt"
    local stock_arm64="$update_dir/stock-libraries-arm64-without-header.txt"
    local stock_x86_64="$update_dir/stock-libraries-x86_64-without-header.txt"
    local filtered_arm64="$update_dir/copied-libraries-$phase-arm64-without-intended-load.txt"
    local filtered_x86_64="$update_dir/copied-libraries-$phase-x86_64-without-intended-load.txt"

    /usr/bin/otool -arch arm64 -L "$copied_executable" > "$copied_arm64"
    /usr/bin/otool -arch x86_64 -L "$copied_executable" > "$copied_x86_64"
    local arm64_count="$(/usr/bin/grep -F -c "$load_path" "$copied_arm64" || true)"
    local x86_64_count="$(/usr/bin/grep -F -c "$load_path" "$copied_x86_64" || true)"
    if [[ "$arm64_count" != "1" || "$x86_64_count" != "1" ]]; then
        fail "expected exactly one intended load command in each architecture"
    fi
    /usr/bin/sed '1d' "$update_dir/stock-before/main-libraries-arm64.txt" > "$stock_arm64"
    /usr/bin/sed '1d' "$update_dir/stock-before/main-libraries-x86_64.txt" > "$stock_x86_64"
    /usr/bin/grep -F -v "$load_path" "$copied_arm64" | /usr/bin/sed '1d' > "$filtered_arm64"
    /usr/bin/grep -F -v "$load_path" "$copied_x86_64" | /usr/bin/sed '1d' > "$filtered_x86_64"
    if ! /usr/bin/cmp -s "$stock_arm64" "$filtered_arm64"; then
        fail "unexpected arm64 main-executable dependency change"
    fi
    if ! /usr/bin/cmp -s "$stock_x86_64" "$filtered_x86_64"; then
        fail "unexpected x86_64 main-executable dependency change"
    fi
}

verify_compatibility_policy() {
    local policy_path="$1"
    local label="$2"
    if ! /usr/bin/plutil -lint "$policy_path" >/dev/null; then
        fail "$label compatibility policy is invalid"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "4" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "com.local.fcpcommandconsole.FinalCut" ]]; then
        fail "$label compatibility policy host bundle identifier is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "12.3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "450152" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostExecutableSHA256' "$policy_path")" != "6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7" ]]; then
        fail "$label compatibility policy host version/build or exact binary identity is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :PreferenceDomain' "$policy_path")" != "kCFPreferencesCurrentApplication" ]]; then
        fail "$label compatibility policy does not use the current application domain"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:0' "$policy_path")" != "CloudContentFirstLaunchCompleted" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:1' "$policy_path")" != "FFCloudContentDisabled" ]]; then
        fail "$label compatibility policy approved key order is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:2' "$policy_path" >/dev/null 2>&1; then
        fail "$label compatibility policy permits more than two preference keys"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceValues:CloudContentFirstLaunchCompleted' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceValues:FFCloudContentDisabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :SynchronizeDeterministically' "$policy_path")" != "true" ]]; then
        fail "$label compatibility policy does not require the reviewed true values and synchronization"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "1" ]]; then
        fail "$label compatibility policy method guard mode or phases are not exact"
    fi
    for removed_policy_key in CompatibilityInstallPhases MethodGuardLogSubsystem MethodGuardLogCategory; do
        if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
            fail "$label compatibility policy retains an obsolete scheduler or logger key"
        fi
    done
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:2' "$policy_path" >/dev/null 2>&1; then
        fail "$label compatibility policy permits more than two preference keys"
    fi

    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "discard_query_block_noop" ]]; then
        fail "$label compatibility policy single onboarding query setter contract is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1' "$policy_path" >/dev/null 2>&1; then
        fail "$label compatibility policy permits an extra method replacement"
    fi
}

if [[ ! -d "$source_app" || ! -f "$source_executable" || ! -f "$source_onboarding_framework" ]]; then
    fail "required stock app is missing"
fi
if [[ ! -d "$copied_app" || -L "$copied_app" || ! -f "$copied_executable" || ! -f "$copied_onboarding_framework" || ! -d "$embedded_framework" || ! -f "$embedded_runtime" ]]; then
    fail "approved copied-app path or current embedded runtime baseline is missing"
fi
if [[ ! -d "$built_framework" || ! -f "$built_runtime" || ! -f "$built_compatibility_policy" || ! -f "$allowlist" || ! -x "$entitlement_verifier" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before update"
fi

source_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$source_app/Contents/Info.plist")"
source_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$source_app/Contents/Info.plist")"
copied_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$copied_app/Contents/Info.plist")"
copied_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$copied_app/Contents/Info.plist")"
if [[ "$source_version" != "12.3" || "$source_build" != "450152" || "$copied_version" != "12.3" || "$copied_build" != "450152" ]]; then
    fail "stock or copied app version/build guard failed (expected 12.3/450152)"
fi
copied_identifier="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")"
copied_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleName' "$copied_app/Contents/Info.plist")"
copied_display_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleDisplayName' "$copied_app/Contents/Info.plist")"
copied_executable_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$copied_app/Contents/Info.plist")"
if [[ "$copied_identifier" != "com.local.fcpcommandconsole.FinalCut" || "$copied_name" != "Final Cut Pro - FCPCommandConsole" || "$copied_display_name" != "Final Cut Pro - FCPCommandConsole" || "$copied_executable_name" != "Final Cut Pro" ]]; then
    fail "copied app metadata does not match the approved isolated identity"
fi

/bin/mkdir -p "$provenance_root"
if [[ -e "$update_dir" ]]; then
    fail "unique update provenance destination already exists"
fi
/bin/mkdir "$update_dir"
print -r -- "source_version=$source_version" > "$update_dir/source-version-build.txt"
print -r -- "source_build=$source_build" >> "$update_dir/source-version-build.txt"
print -r -- "copied_version=$copied_version" >> "$update_dir/source-version-build.txt"
print -r -- "copied_build=$copied_build" >> "$update_dir/source-version-build.txt"
print -r -- "bundle_identifier=$copied_identifier" > "$update_dir/copied-identity.txt"
print -r -- "bundle_name=$copied_name" >> "$update_dir/copied-identity.txt"
print -r -- "display_name=$copied_display_name" >> "$update_dir/copied-identity.txt"
print -r -- "executable_name=$copied_executable_name" >> "$update_dir/copied-identity.txt"
require_not_running "$update_dir/process-before-update.txt"
capture_bundle "$source_app" "$source_executable" "$update_dir/stock-before"
capture_preferences "$update_dir/stock-before"
capture_bundle "$copied_app" "$copied_executable" "$update_dir/copied-before"
capture_onboarding_framework "$source_onboarding_framework" "$update_dir/stock-before"
capture_onboarding_framework "$copied_onboarding_framework" "$update_dir/copied-before"
verify_onboarding_framework_identity "$update_dir/stock-before" "stock-before"
verify_onboarding_framework_identity "$update_dir/copied-before" "copied-before"
compare_onboarding_framework_identity "$update_dir/stock-before" "$update_dir/copied-before" "copied-before"
verify_onboarding_framework_load_path "$source_executable" "$update_dir/stock-before" "stock-before"
verify_onboarding_framework_load_path "$copied_executable" "$update_dir/copied-before" "copied-before"
/usr/bin/shasum -a 256 "$embedded_runtime" | /usr/bin/awk '{print $1}' > "$update_dir/embedded-runtime-before.sha256"
source_executable_sha256="$(/usr/bin/awk '{print $1}' "$update_dir/stock-before/main-executable.sha256")"
source_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$update_dir/stock-before/main-executable.uuids.txt")"
source_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$update_dir/stock-before/main-executable.uuids.txt")"
copied_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$update_dir/copied-before/main-executable.uuids.txt")"
copied_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$update_dir/copied-before/main-executable.uuids.txt")"
if [[ "$source_executable_sha256" != "6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390" || "$source_arm64_uuid" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$source_x86_64_uuid" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$copied_arm64_uuid" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$copied_x86_64_uuid" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" ]]; then
    fail "stock or copied executable does not match the reviewed FCP 12.3 slice identity"
fi
print -r -- "stock_executable_sha256=$source_executable_sha256" > "$update_dir/exact-host-identity.txt"
print -r -- "stock_arm64_uuid=$source_arm64_uuid" >> "$update_dir/exact-host-identity.txt"
print -r -- "stock_x86_64_uuid=$source_x86_64_uuid" >> "$update_dir/exact-host-identity.txt"
print -r -- "copied_arm64_uuid=$copied_arm64_uuid" >> "$update_dir/exact-host-identity.txt"
print -r -- "copied_x86_64_uuid=$copied_x86_64_uuid" >> "$update_dir/exact-host-identity.txt"

initial_patch_dir=""
for candidate in "$provenance_root"/patch-*; do
    if [[ -f "$candidate/stock-before/main-executable.sha256" && -f "$candidate/stock-before/Info.plist.sha256" && -f "$candidate/stock-before/stock-preferences.sha256" && -f "$candidate/copied-main-executable.pre-injection.sha256" ]]; then
        initial_patch_dir="$candidate"
        break
    fi
done
if [[ -z "$initial_patch_dir" || ! -f "$initial_patch_dir/signing.txt" ]]; then
    fail "initial patch provenance or signing evidence is missing"
fi
print -r -- "initial_patch_provenance=$initial_patch_dir" > "$update_dir/initial-provenance.txt"
if ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/main-executable.sha256" "$update_dir/stock-before/main-executable.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/Info.plist.sha256" "$update_dir/stock-before/Info.plist.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/stock-before/stock-preferences.sha256" "$update_dir/stock-before/stock-preferences.sha256" || ! /usr/bin/cmp -s "$initial_patch_dir/copied-main-executable.pre-injection.sha256" "$update_dir/stock-before/main-executable.sha256"; then
    fail "stock app or production preference baseline differs from initial patch evidence"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$update_dir/codesign-verify-before.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$update_dir/runtime-codesign-verify-before.txt" 2>&1
verify_load_commands "before"

for forbidden_added_key in com.apple.security.get-task-allow com.apple.security.cs.debugger com.apple.security.cs.allow-dyld-environment-variables; do
    if /usr/libexec/PlistBuddy -c "Print :$forbidden_added_key" "$update_dir/copied-before/entitlements.plist" >/dev/null 2>&1; then
        fail "current copied app contains forbidden entitlement: $forbidden_added_key"
    fi
done
expected_entitlements="$update_dir/expected-current-entitlements.plist"
/bin/cp "$update_dir/stock-before/entitlements.plist" "$expected_entitlements"
for entitlement_key in "${removed_entitlements[@]}"; do
    /usr/libexec/PlistBuddy -c "Delete :$entitlement_key" "$expected_entitlements" >/dev/null
done
if /usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$expected_entitlements" >/dev/null 2>&1; then
    fail "captured stock policy unexpectedly already contains the required added entitlement"
fi
/usr/libexec/PlistBuddy -c "Add :$required_added_entitlement bool true" "$expected_entitlements" >/dev/null
"$entitlement_verifier" "$update_dir/stock-before/entitlements.plist" "$expected_entitlements" "$update_dir/copied-before/entitlements.plist" "$allowlist" > "$update_dir/entitlement-allowlist-before.txt"
verify_compatibility_policy "$built_compatibility_policy" "built"
/usr/bin/shasum -a 256 "$built_runtime" | /usr/bin/awk '{print $1}' > "$update_dir/built-runtime.sha256"
/usr/bin/shasum -a 256 "$built_compatibility_policy" | /usr/bin/awk '{print $1}' > "$update_dir/built-compatibility-policy.sha256"

signing_identity="$(/usr/bin/security find-identity -v -p codesigning | /usr/bin/awk '/"Apple Development:/ {print $2; exit}')"
if [[ -z "$signing_identity" ]]; then
    fail "the required Apple Development signing identity is unavailable"
fi
initial_identity="$(/usr/bin/awk -F= '/^identity_fingerprint=/{print $2; exit}' "$initial_patch_dir/signing.txt")"
if [[ -z "$initial_identity" || "$signing_identity" != "$initial_identity" ]]; then
    fail "the available Apple Development identity does not match the initial copied-app signing evidence"
fi
print -r -- "signing_mode=apple_development" > "$update_dir/signing.txt"
print -r -- "identity_fingerprint=$signing_identity" >> "$update_dir/signing.txt"
print -r -- "runtime_signature_operation=project_owned_framework_only" >> "$update_dir/signing.txt"
print -r -- "app_signature_operation=top_level_copied_app_only" >> "$update_dir/signing.txt"
print -r -- "deep_signing=false" >> "$update_dir/signing.txt"

require_not_running "$update_dir/process-before-runtime-copy.txt"
/usr/bin/ditto "$built_framework" "$embedded_framework"
if ! /usr/bin/cmp -s "$built_runtime" "$embedded_runtime" || ! /usr/bin/cmp -s "$built_compatibility_policy" "$embedded_compatibility_policy"; then
    fail "fresh built framework was not copied exactly into the approved copied app"
fi
verify_compatibility_policy "$embedded_compatibility_policy" "embedded"
require_not_running "$update_dir/process-before-signing.txt"
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none "$embedded_framework" > "$update_dir/sign-runtime.stdout" 2> "$update_dir/sign-runtime.stderr"; then
    fail "project-owned embedded runtime signing failed"
fi
top_level_entitlements="$update_dir/top-level-current-entitlements.plist"
/bin/cp "$update_dir/copied-before/entitlements.plist" "$top_level_entitlements"
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none --entitlements "$top_level_entitlements" "$copied_app" > "$update_dir/sign-app.stdout" 2> "$update_dir/sign-app.stderr"; then
    fail "copied top-level app signing failed"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$update_dir/codesign-verify-after.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$update_dir/runtime-codesign-verify-after.txt" 2>&1
capture_bundle "$copied_app" "$copied_executable" "$update_dir/copied-after"
capture_onboarding_framework "$copied_onboarding_framework" "$update_dir/copied-after"
verify_onboarding_framework_identity "$update_dir/copied-after" "copied-after"
compare_onboarding_framework_identity "$update_dir/stock-before" "$update_dir/copied-after" "copied-after"
compare_onboarding_framework_identity "$update_dir/copied-before" "$update_dir/copied-after" "copied-after"
verify_onboarding_framework_load_path "$copied_executable" "$update_dir/copied-after" "copied-after"
verify_load_commands "after"
if ! /usr/bin/cmp -s "$update_dir/copied-before/main-executable.uuids.txt" "$update_dir/copied-after/main-executable.uuids.txt"; then
    fail "copied executable slice UUID changed during the runtime-only update"
fi
verify_compatibility_policy "$embedded_compatibility_policy" "embedded-after-signing"
if ! /usr/bin/cmp -s "$built_compatibility_policy" "$embedded_compatibility_policy"; then
    fail "embedded compatibility policy changed during signing"
fi
"$entitlement_verifier" "$update_dir/stock-before/entitlements.plist" "$expected_entitlements" "$update_dir/copied-after/entitlements.plist" "$allowlist" > "$update_dir/entitlement-allowlist-after.txt"
/usr/bin/shasum -a 256 "$embedded_runtime" | /usr/bin/awk '{print $1}' > "$update_dir/embedded-runtime-after-signing.sha256"
/usr/bin/shasum -a 256 "$embedded_compatibility_policy" | /usr/bin/awk '{print $1}' > "$update_dir/embedded-compatibility-policy-after-signing.sha256"

capture_bundle "$source_app" "$source_executable" "$update_dir/stock-after"
capture_preferences "$update_dir/stock-after"
capture_onboarding_framework "$source_onboarding_framework" "$update_dir/stock-after"
verify_onboarding_framework_identity "$update_dir/stock-after" "stock-after"
compare_onboarding_framework_identity "$update_dir/stock-before" "$update_dir/stock-after" "stock-after"
require_not_running "$update_dir/process-after-update.txt"
if ! /usr/bin/cmp -s "$update_dir/stock-before/main-executable.sha256" "$update_dir/stock-after/main-executable.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/main-executable.uuids.txt" "$update_dir/stock-after/main-executable.uuids.txt" || ! /usr/bin/cmp -s "$update_dir/stock-before/Info.plist.sha256" "$update_dir/stock-after/Info.plist.sha256" || ! /usr/bin/cmp -s "$update_dir/stock-before/stock-preferences.sha256" "$update_dir/stock-after/stock-preferences.sha256"; then
    fail "stock app or production preference fingerprint changed"
fi
print -r -- "stock_app=unchanged" > "$update_dir/stock-integrity.txt"
print -r -- "stock_preferences=unchanged" >> "$update_dir/stock-integrity.txt"

print -r -- "status=updated"
print -r -- "copied_app=$copied_app"
print -r -- "provenance=$update_dir"

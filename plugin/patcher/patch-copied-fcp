#!/bin/zsh
# Noninteractive, one-time patcher for the approved isolated Final Cut copy.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
destination_parent="/Users/marcboyer/Applications/SpliceKit"
destination_root="$destination_parent/FCPCommandConsole"
copied_app="$destination_root/Final Cut Pro - FCPCommandConsole.app"
copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
source_onboarding_framework="$source_app/$onboarding_framework_relative_executable_path"
copied_onboarding_framework="$copied_app/$onboarding_framework_relative_executable_path"
expected_host_bundle_identifier="com.apple.FinalCut"
expected_copied_host_bundle_path="$copied_app"
expected_host_version="12.3"
expected_host_build="450152"
expected_stock_pre_injection_host_executable_sha256="6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390"
mas_receipt_relative_path="Contents/_MASReceipt/receipt"
expected_mas_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
onboarding_framework_load_path="@rpath/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
framework_name="FCPCommandConsoleRuntime.framework"
built_framework="$plugin_dir/build/$framework_name"
built_compatibility_policy="$built_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
embedded_framework="$copied_app/Contents/Frameworks/$framework_name"
embedded_runtime="$embedded_framework/Versions/A/FCPCommandConsoleRuntime"
embedded_compatibility_policy="$embedded_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
injector="$plugin_dir/build/fcpcc-insert-dylib"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
preferences_file="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
provenance_root="/Users/marcboyer/Movies/FCPCommandConsole/provenance"
patch_dir="$provenance_root/patch-$(/bin/date -u +%Y%m%dT%H%M%SZ)-$$"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
required_added_entitlement="com.apple.security.cs.disable-library-validation"
removed_entitlements=(
    com.apple.application-identifier
    com.apple.developer.aps-environment
    com.apple.developer.icloud-container-environment
    com.apple.developer.icloud-container-identifiers
    com.apple.developer.icloud-services
    com.apple.developer.team-identifier
    com.apple.security.application-groups
    com.apple.security.assets.movies.read-write
    com.apple.security.assets.music.read-only
    com.apple.security.assets.pictures.read-only
    com.apple.security.automation.apple-events
    com.apple.security.device.usb
    com.apple.security.files.bookmarks.app-scope
    com.apple.security.files.bookmarks.document-scope
    com.apple.security.files.user-selected.read-write
    com.apple.security.network.client
    com.apple.security.network.server
    com.apple.security.personal-information.photos-library
    com.apple.security.scripting-targets
    com.apple.security.temporary-exception.apple-events
    com.apple.security.temporary-exception.audio-unit-host
    com.apple.security.temporary-exception.files.absolute-path.read-write
    com.apple.security.temporary-exception.mach-lookup.global-name
    com.apple.security.temporary-exception.sbpl
    com.apple.security.temporary-exception.shared-preference.read-write
    keychain-access-groups
)
canonical_entitlements=(
    com.apple.security.app-sandbox
    com.apple.security.cs.disable-library-validation
    com.apple.security.device.audio-input
    com.apple.security.device.camera
    com.apple.security.device.microphone
)

fail() {
    print -u2 -r -- "patch-copied-fcp: $1"
    exit 1
}

capture_preferences() {
    local output_dir="$1"
    if [[ -f "$preferences_file" ]]; then
        /usr/bin/plutil -convert xml1 -o "$output_dir/stock-preferences.xml" "$preferences_file"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    else
        print -r -- "absent" > "$output_dir/stock-preferences.xml"
        /usr/bin/shasum -a 256 "$output_dir/stock-preferences.xml" | /usr/bin/awk '{print $1}' > "$output_dir/stock-preferences.sha256"
    fi
}

capture_receipt() {
    local app_path="$1"
    local output_dir="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "MAS receipt is missing or not a regular file: $app_path"
    fi
    /bin/cp "$receipt_path" "$output_dir/receipt"
    /usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}' > "$output_dir/receipt.sha256"
}

verify_receipt() {
    local app_path="$1"
    local label="$2"
    local receipt_path="$app_path/$mas_receipt_relative_path"
    if [[ ! -f "$receipt_path" || -L "$receipt_path" ]]; then
        fail "$label MAS receipt is missing or not a regular file"
    fi
    local receipt_sha256="$(/usr/bin/shasum -a 256 "$receipt_path" | /usr/bin/awk '{print $1}')"
    if [[ "$receipt_sha256" != "$expected_mas_receipt_sha256" ]]; then
        fail "$label MAS receipt SHA-256 is not the reviewed value"
    fi
}

capture_bundle() {
    local app_path="$1"
    local executable_path="$2"
    local output_dir="$3"
    /bin/mkdir -p "$output_dir"
    /bin/cp "$app_path/Contents/Info.plist" "$output_dir/Info.plist"
    /usr/bin/shasum -a 256 "$executable_path" | /usr/bin/awk '{print $1}' > "$output_dir/main-executable.sha256"
    /usr/bin/shasum -a 256 "$app_path/Contents/Info.plist" | /usr/bin/awk '{print $1}' > "$output_dir/Info.plist.sha256"
    /usr/bin/codesign -dvvv "$app_path" > "$output_dir/codesign-metadata.txt" 2>&1
    /usr/bin/codesign -d -r- "$app_path" > "$output_dir/designated-requirement.txt" 2>&1
    /usr/bin/codesign -d --entitlements :- "$app_path" > "$output_dir/entitlements.plist" 2> "$output_dir/entitlements.stderr"
    /usr/bin/otool -arch arm64 -L "$executable_path" > "$output_dir/main-libraries-arm64.txt"
    /usr/bin/otool -arch x86_64 -L "$executable_path" > "$output_dir/main-libraries-x86_64.txt"
}

capture_onboarding_framework() {
    local framework_path="$1"
    local output_dir="$2"
    /usr/bin/shasum -a 256 "$framework_path" | /usr/bin/awk '{print $1}' > "$output_dir/onboarding-framework.sha256"
    /usr/bin/dwarfdump --uuid "$framework_path" > "$output_dir/onboarding-framework.uuids.txt"
    local framework_sha256="$(/usr/bin/awk '{print $1}' "$output_dir/onboarding-framework.sha256")"
    local framework_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$output_dir/onboarding-framework.uuids.txt")"
    print -r -- "sha256=$framework_sha256" > "$output_dir/onboarding-framework.identity.txt"
    print -r -- "arm64_uuid=$framework_arm64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
    print -r -- "x86_64_uuid=$framework_x86_64_uuid" >> "$output_dir/onboarding-framework.identity.txt"
}

verify_onboarding_framework_identity() {
    local output_dir="$1"
    local label="$2"
    local framework_sha256="$(/usr/bin/awk -F= '/^sha256=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_arm64_uuid="$(/usr/bin/awk -F= '/^arm64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    local framework_x86_64_uuid="$(/usr/bin/awk -F= '/^x86_64_uuid=/{print $2; exit}' "$output_dir/onboarding-framework.identity.txt")"
    if [[ "$framework_sha256" != "$expected_onboarding_framework_sha256" || "$framework_arm64_uuid" != "$expected_onboarding_framework_arm64_uuid" || "$framework_x86_64_uuid" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "$label onboarding framework does not match the reviewed hash and slice UUIDs"
    fi
}

verify_onboarding_framework_load_path() {
    local executable_path="$1"
    local output_dir="$2"
    local label="$3"
    local architecture
    for architecture in arm64 x86_64; do
        /usr/bin/otool -arch "$architecture" -L "$executable_path" > "$output_dir/onboarding-framework-load-commands-$architecture.txt"
        local count="$(/usr/bin/grep -F -c "$onboarding_framework_load_path" "$output_dir/onboarding-framework-load-commands-$architecture.txt" || true)"
        if [[ "$count" != "1" ]]; then
            fail "$label main executable does not directly load exactly one reviewed onboarding framework in $architecture"
        fi
    done
}

compare_onboarding_framework_identity() {
    local first_output_dir="$1"
    local second_output_dir="$2"
    local label="$3"
    if ! /usr/bin/cmp -s "$first_output_dir/onboarding-framework.identity.txt" "$second_output_dir/onboarding-framework.identity.txt"; then
        fail "$label onboarding framework identity differs from stock provenance"
    fi
}

verify_compatibility_policy() {
    local policy_path="$1"
    local label="$2"
    if [[ ! -f "$policy_path" ]] || ! /usr/bin/plutil -lint "$policy_path" >/dev/null; then
        fail "$label onboarding compatibility policy is missing or invalid"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "6" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "$expected_host_bundle_identifier" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedCopiedHostBundlePath' "$policy_path")" != "$expected_copied_host_bundle_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "$expected_host_version" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "$expected_host_build" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedStockPreInjectionHostExecutableSHA256' "$policy_path")" != "$expected_stock_pre_injection_host_executable_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptRelativePath' "$policy_path")" != "$mas_receipt_relative_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptSHA256' "$policy_path")" != "$expected_mas_receipt_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "$onboarding_framework_relative_executable_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "$expected_onboarding_framework_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "$expected_onboarding_framework_arm64_uuid" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "$label onboarding compatibility policy host, receipt, or binary identity is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "1" ]]; then
        fail "$label onboarding compatibility policy guard contract is not exact"
    fi
    for removed_policy_key in CompatibilityInstallPhases MethodGuardLogSubsystem MethodGuardLogCategory PreferenceDomain ApprovedPreferenceKeys ApprovedPreferenceValues SynchronizeDeterministically; do
        if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
            fail "$label onboarding compatibility policy retains a retired scheduler, logger, or preference key"
        fi
    done
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "forward_original_setter_async_nil_metadata_provider" ]]; then
        fail "$label onboarding query setter contract is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1' "$policy_path" >/dev/null 2>&1; then
        fail "$label onboarding compatibility policy permits an extra method replacement"
    fi
}

require_not_running() {
    local audit_file="$1"
    if /usr/bin/pgrep -fl 'Final Cut Pro' > "$audit_file"; then
        fail "Final Cut Pro is running; no copy or patch was attempted"
    fi
    print -r -- "no Final Cut Pro process observed" > "$audit_file"
}

verify_entitlement_allowlist() {
    local stock_entitlements="$1"
    local expected_entitlements="$2"
    local signed_entitlements="$3"
    local output_dir="$4"
    local expected_binary="$output_dir/expected-entitlements.bplist"
    local signed_binary="$output_dir/signed-entitlements.bplist"
    local expected_canonical="$output_dir/expected-entitlements.canonical.plist"
    local signed_canonical="$output_dir/signed-entitlements.canonical.plist"

    for entitlement_key in "${removed_entitlements[@]}"; do
        if ! /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$stock_entitlements" >/dev/null 2>&1; then
            fail "captured stock entitlements do not contain required removable key: $entitlement_key"
        fi
        if /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$expected_entitlements" >/dev/null 2>&1; then
            fail "generated local entitlements retained removable key: $entitlement_key"
        fi
        if /usr/libexec/PlistBuddy -c "Print :$entitlement_key" "$signed_entitlements" >/dev/null 2>&1; then
            fail "signed copied app retained removable key: $entitlement_key"
        fi
    done
    if /usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$stock_entitlements" >/dev/null 2>&1; then
        fail "captured stock policy unexpectedly already contains the required added entitlement"
    fi
    for entitlement_file in "$expected_entitlements" "$signed_entitlements"; do
        if [[ "$(/usr/libexec/PlistBuddy -c 'Print :com.apple.security.app-sandbox' "$entitlement_file")" != "false" ]]; then
            fail "copied app entitlement policy must set com.apple.security.app-sandbox=false"
        fi
        if [[ "$(/usr/libexec/PlistBuddy -c "Print :$required_added_entitlement" "$entitlement_file")" != "true" ]]; then
            fail "copied app entitlement policy does not require $required_added_entitlement=true"
        fi
        for preserved_entitlement in com.apple.security.device.audio-input com.apple.security.device.camera com.apple.security.device.microphone; do
            if [[ "$(/usr/libexec/PlistBuddy -c "Print :$preserved_entitlement" "$entitlement_file")" != "true" ]]; then
                fail "copied app entitlement policy does not retain $preserved_entitlement=true"
            fi
        done
    done
    for forbidden_added_key in com.apple.security.get-task-allow com.apple.security.cs.debugger com.apple.security.cs.allow-dyld-environment-variables; do
        if /usr/libexec/PlistBuddy -c "Print :$forbidden_added_key" "$signed_entitlements" >/dev/null 2>&1; then
            fail "forbidden added entitlement is present: $forbidden_added_key"
        fi
    done
    /usr/bin/plutil -convert binary1 -o "$expected_binary" "$expected_entitlements"
    /usr/bin/plutil -convert xml1 -o "$expected_canonical" "$expected_binary"
    /usr/bin/plutil -convert binary1 -o "$signed_binary" "$signed_entitlements"
    /usr/bin/plutil -convert xml1 -o "$signed_canonical" "$signed_binary"
    if ! /usr/bin/cmp -s "$expected_canonical" "$signed_canonical"; then
        fail "signed copied-app entitlement diff contains an unallowed addition, removal, or change"
    fi
    "$entitlement_verifier" "$stock_entitlements" "$expected_entitlements" "$signed_entitlements" "$allowlist" > "$output_dir/entitlement-allowlist.txt"
    /usr/bin/shasum -a 256 "$allowlist" | /usr/bin/awk '{print $1}' > "$output_dir/patch-entitlement-allowlist-config.sha256"
}

create_canonical_entitlements() {
    local output_path="$1"
    /usr/bin/plutil -create xml1 "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.app-sandbox bool false' "$output_path" >/dev/null
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.cs.disable-library-validation bool true' "$output_path" >/dev/null
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.audio-input bool true' "$output_path" >/dev/null
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.camera bool true' "$output_path" >/dev/null
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.microphone bool true' "$output_path" >/dev/null
    /usr/bin/plutil -lint "$output_path" >/dev/null
}

if [[ ! -d "$source_app" || ! -f "$source_executable" || ! -f "$source_onboarding_framework" ]]; then
    fail "required source app is missing"
fi
if [[ -e "$destination_parent" || -e "$destination_root" || -e "$copied_app" ]]; then
    fail "approved destination or its parent already exists; refusing to overwrite or reuse it"
fi
if [[ ! -d "$built_framework" || ! -f "$built_compatibility_policy" || ! -x "$injector" || ! -x "$entitlement_verifier" || ! -f "$allowlist" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before patching"
fi
verify_compatibility_policy "$built_compatibility_policy" "built"

source_version="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' "$source_app/Contents/Info.plist")"
source_build="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleVersion' "$source_app/Contents/Info.plist")"
if [[ "$source_version" != "$expected_host_version" || "$source_build" != "$expected_host_build" ]]; then
    fail "source app version/build guard failed (expected 12.3/450152)"
fi

/bin/mkdir -p "$provenance_root"
if [[ -e "$patch_dir" ]]; then
    fail "unique provenance destination already exists"
fi
/bin/mkdir "$patch_dir"
print -r -- "source_version=$source_version" > "$patch_dir/source-version-build.txt"
print -r -- "source_build=$source_build" >> "$patch_dir/source-version-build.txt"
require_not_running "$patch_dir/process-before-copy.txt"
capture_bundle "$source_app" "$source_executable" "$patch_dir/stock-before"
capture_preferences "$patch_dir/stock-before"
capture_receipt "$source_app" "$patch_dir/stock-before"
verify_receipt "$source_app" "stock"
capture_onboarding_framework "$source_onboarding_framework" "$patch_dir/stock-before"
verify_onboarding_framework_identity "$patch_dir/stock-before" "stock"
verify_onboarding_framework_load_path "$source_executable" "$patch_dir/stock-before" "stock"

/bin/mkdir -p "$destination_root"
/usr/bin/ditto --rsrc --extattr "$source_app" "$copied_app"
require_not_running "$patch_dir/process-before-patch.txt"

if [[ ! -f "$copied_onboarding_framework" ]]; then
    fail "copied onboarding framework is missing before the isolated runtime is added"
fi
capture_onboarding_framework "$copied_onboarding_framework" "$patch_dir/copied-before"
capture_receipt "$copied_app" "$patch_dir/copied-before"
verify_receipt "$copied_app" "copied-before"
verify_onboarding_framework_identity "$patch_dir/copied-before" "copied-before"
compare_onboarding_framework_identity "$patch_dir/stock-before" "$patch_dir/copied-before" "copied-before"
if ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt" "$patch_dir/copied-before/receipt" || ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt.sha256" "$patch_dir/copied-before/receipt.sha256"; then
    fail "copied MAS receipt differs from stock provenance before patching"
fi
verify_onboarding_framework_load_path "$copied_executable" "$patch_dir/copied-before" "copied-before"

/usr/bin/ditto "$copied_executable" "$patch_dir/copied-main-executable.pre-injection"
/usr/bin/shasum -a 256 "$patch_dir/copied-main-executable.pre-injection" | /usr/bin/awk '{print $1}' > "$patch_dir/copied-main-executable.pre-injection.sha256"
if ! /usr/bin/cmp -s "$patch_dir/stock-before/main-executable.sha256" "$patch_dir/copied-main-executable.pre-injection.sha256"; then
    fail "copied executable did not match captured stock executable before modification"
fi

/usr/libexec/PlistBuddy -c "Set :CFBundleIdentifier $expected_host_bundle_identifier" "$copied_app/Contents/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleName Final Cut Pro - FCPCommandConsole' "$copied_app/Contents/Info.plist"
/usr/libexec/PlistBuddy -c 'Set :CFBundleDisplayName Final Cut Pro - FCPCommandConsole' "$copied_app/Contents/Info.plist"
/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$copied_app/Contents/Info.plist" > "$patch_dir/copied-executable-name-preserved.txt"
/usr/bin/plutil -lint "$copied_app/Contents/Info.plist" >/dev/null

/usr/bin/ditto "$built_framework" "$embedded_framework"
if [[ ! -f "$embedded_runtime" ]]; then
    fail "embedded runtime was not copied into the isolated app"
fi

local_entitlements="$patch_dir/local-signing-entitlements.plist"
create_canonical_entitlements "$local_entitlements"

signing_identity="$(/usr/bin/security find-identity -v -p codesigning | /usr/bin/awk '/"Apple Development:/ {print $2; exit}')"
signing_mode="apple_development"
if [[ -z "$signing_identity" ]]; then
    fail "the required Apple Development signing identity is unavailable"
fi
print -r -- "signing_mode=$signing_mode" > "$patch_dir/signing.txt"
print -r -- "identity_fingerprint=$signing_identity" >> "$patch_dir/signing.txt"

require_not_running "$patch_dir/process-before-injection.txt"
if ! "$injector" "$copied_executable" "$load_path" > "$patch_dir/injector.txt" 2>&1; then
    fail "project-owned injector failed; isolated copy remains for inspection"
fi

/usr/bin/otool -arch arm64 -L "$copied_executable" > "$patch_dir/copied-load-commands-arm64.txt"
/usr/bin/otool -arch x86_64 -L "$copied_executable" > "$patch_dir/copied-load-commands-x86_64.txt"
arm64_count="$(/usr/bin/grep -F -c "$load_path" "$patch_dir/copied-load-commands-arm64.txt" || true)"
x86_64_count="$(/usr/bin/grep -F -c "$load_path" "$patch_dir/copied-load-commands-x86_64.txt" || true)"
if [[ "$arm64_count" != "1" || "$x86_64_count" != "1" ]]; then
    fail "expected exactly one intended load command in each architecture"
fi

/usr/bin/sed '1d' "$patch_dir/stock-before/main-libraries-arm64.txt" > "$patch_dir/stock-libraries-arm64-without-header.txt"
/usr/bin/sed '1d' "$patch_dir/stock-before/main-libraries-x86_64.txt" > "$patch_dir/stock-libraries-x86_64-without-header.txt"
/usr/bin/grep -F -v "$load_path" "$patch_dir/copied-load-commands-arm64.txt" | /usr/bin/sed '1d' > "$patch_dir/copied-libraries-arm64-without-intended-load.txt"
/usr/bin/grep -F -v "$load_path" "$patch_dir/copied-load-commands-x86_64.txt" | /usr/bin/sed '1d' > "$patch_dir/copied-libraries-x86_64-without-intended-load.txt"
if ! /usr/bin/cmp -s "$patch_dir/stock-libraries-arm64-without-header.txt" "$patch_dir/copied-libraries-arm64-without-intended-load.txt"; then
    fail "unexpected arm64 main-executable dependency change"
fi
if ! /usr/bin/cmp -s "$patch_dir/stock-libraries-x86_64-without-header.txt" "$patch_dir/copied-libraries-x86_64-without-intended-load.txt"; then
    fail "unexpected x86_64 main-executable dependency change"
fi

if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none "$embedded_framework" > "$patch_dir/sign-runtime.stdout" 2> "$patch_dir/sign-runtime.stderr"; then
    fail "embedded runtime signing failed without changing the entitlement policy"
fi
if ! /usr/bin/codesign --force --sign "$signing_identity" --options runtime --timestamp=none --entitlements "$local_entitlements" "$copied_app" > "$patch_dir/sign-app.stdout" 2> "$patch_dir/sign-app.stderr"; then
    fail "copied app signing failed without changing the entitlement policy"
fi

/usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$patch_dir/codesign-verify.txt" 2>&1
/usr/bin/codesign --verify --strict --verbose=4 "$embedded_framework" > "$patch_dir/runtime-codesign-verify.txt" 2>&1
capture_bundle "$copied_app" "$copied_executable" "$patch_dir/copied-after"
capture_receipt "$copied_app" "$patch_dir/copied-after"
verify_receipt "$copied_app" "copied-after"
if ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt" "$patch_dir/copied-after/receipt" || ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt.sha256" "$patch_dir/copied-after/receipt.sha256"; then
    fail "copied MAS receipt differs from stock provenance after patching"
fi
capture_onboarding_framework "$copied_onboarding_framework" "$patch_dir/copied-after"
verify_onboarding_framework_identity "$patch_dir/copied-after" "copied-after"
compare_onboarding_framework_identity "$patch_dir/stock-before" "$patch_dir/copied-after" "copied-after"
verify_onboarding_framework_load_path "$copied_executable" "$patch_dir/copied-after" "copied-after"
verify_entitlement_allowlist \
    "$patch_dir/stock-before/entitlements.plist" \
    "$local_entitlements" \
    "$patch_dir/copied-after/entitlements.plist" \
    "$patch_dir"
if [[ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$copied_app/Contents/Info.plist")" != "$expected_host_bundle_identifier" ]]; then
    fail "copied app bundle identifier did not retain the Apple receipt-compatible identifier"
fi
verify_compatibility_policy "$embedded_compatibility_policy" "embedded"
if ! /usr/bin/cmp -s "$built_compatibility_policy" "$embedded_compatibility_policy"; then
    fail "embedded onboarding compatibility policy does not match the reviewed build"
fi
capture_bundle "$source_app" "$source_executable" "$patch_dir/stock-after"
capture_preferences "$patch_dir/stock-after"
capture_receipt "$source_app" "$patch_dir/stock-after"
verify_receipt "$source_app" "stock-after"
capture_onboarding_framework "$source_onboarding_framework" "$patch_dir/stock-after"
verify_onboarding_framework_identity "$patch_dir/stock-after" "stock-after"
compare_onboarding_framework_identity "$patch_dir/stock-before" "$patch_dir/stock-after" "stock-after"
require_not_running "$patch_dir/process-after-patch.txt"

if ! /usr/bin/cmp -s "$patch_dir/stock-before/main-executable.sha256" "$patch_dir/stock-after/main-executable.sha256"; then
    fail "stock main executable fingerprint changed"
fi
if ! /usr/bin/cmp -s "$patch_dir/stock-before/Info.plist.sha256" "$patch_dir/stock-after/Info.plist.sha256"; then
    fail "stock Info.plist fingerprint changed"
fi
if ! /usr/bin/cmp -s "$patch_dir/stock-before/stock-preferences.sha256" "$patch_dir/stock-after/stock-preferences.sha256"; then
    fail "stock preference export fingerprint changed"
fi
if ! /usr/bin/cmp -s "$patch_dir/stock-before/Info.plist.sha256" "$patch_dir/stock-after/Info.plist.sha256" || ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt.sha256" "$patch_dir/stock-after/receipt.sha256" || ! /usr/bin/cmp -s "$patch_dir/stock-before/receipt" "$patch_dir/stock-after/receipt"; then
    fail "stock Info.plist or MAS receipt fingerprint changed"
fi

print -r -- "status=patched"
print -r -- "copied_app=$copied_app"
print -r -- "provenance=$patch_dir"

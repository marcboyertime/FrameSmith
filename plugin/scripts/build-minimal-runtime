#!/bin/zsh
# Build only project-owned offline artifacts. This script intentionally has no
# dependency resolution or network behavior.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
build_dir="$plugin_dir/build"
runtime_dir="$plugin_dir/splicekit_minimal"
tool_dir="$plugin_dir/tools/fcpcc-insert-dylib"
patcher_dir="$plugin_dir/patcher"
planner_builder="$plugin_dir/scripts/build-planner-helper"
planner_payload_root="$plugin_dir/build/planner-helper/payload"
framework_dir="$build_dir/FCPCommandConsoleRuntime.framework"
runtime_binary="$framework_dir/Versions/A/FCPCommandConsoleRuntime"
injector_binary="$build_dir/fcpcc-insert-dylib"
entitlement_verifier="$build_dir/fcpcc-entitlement-verify"
atomic_swap_helper="$build_dir/fcpcc-atomic-swap"
compatibility_policy_name="FCPCCOnboardingQueryCompatibility.plist"
runtime_policy_source="$runtime_dir/Resources/$compatibility_policy_name"
runtime_policy_build="$framework_dir/Versions/A/Resources/$compatibility_policy_name"
retired_runtime_policy_build="$framework_dir/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
planner_payload_build="$framework_dir/Versions/A/Resources/PlannerHelperPayload"
planner_helper_name="fcpcommandconsole-planner-helper"
planner_bundle_name="FCPCommandConsole_FCPCommandConsolePlannerHelper.bundle"
planner_manifest_name="planner-helper-manifest.json"
planner_team_identifier="KDV9RC892F"
planner_immutable_resources=(
  "Resources/registry/effects/look.old_television.json"
  "Resources/registry/effects/motion.living_still.json"
  "Resources/registry/effects/native.targeted_rotate_zoom.json"
  "Resources/registry/effects/transition.natural_dissolve.json"
  "Resources/schemas/effect-plan.schema.json"
)

fail() {
  print -u2 -r -- "build-minimal-runtime: $1"
  exit 1
}

verify_audio_unit_validation_containment_policy() {
  local policy_path="$1"
  if ! /usr/bin/plutil -extract AudioUnitValidationContainment json -o - "$policy_path" | /usr/bin/jq -e '
    . == {
      "ActivationEnvironmentValue": "1",
      "ActivationEnvironmentVariable": "FCPCC_BOOTSTRAP_DISPOSABLE_PROJECT",
      "DeterministicRuntimeDiagnostics": "constructor_install_status_process_lifetime",
      "ExecutionEnabled": true,
      "ExpectedFlexoArm64UUID": "AEAE4C0B-7695-3784-A794-AFB4985525A8",
      "ExpectedFlexoRelativeExecutablePath": "Contents/Frameworks/Flexo.framework/Versions/A/Flexo",
      "ExpectedFlexoSHA256": "704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e",
      "ExpectedFlexoX86_64UUID": "525166A8-E6F4-3DCA-B4F9-BD98F16B6552",
      "ExpectedOriginalImplementationOffsetArm64": "0xe66b8c",
      "ExpectedOriginalImplementationOffsetX86_64": "0x13c0be0",
      "InstallPhase": "runtime_constructor_before_disposable_project_bootstrap_scheduling",
      "MethodContractsPinnedIn": "FCPCommandConsoleRuntime.m:FCPCCFlexoSupportsThirdPartyAudioUnitsContract",
      "MethodKind": "class_metaclass",
      "NoAvailabilityRetry": true,
      "NoCachePreferenceOrAudioUnitWrites": true,
      "NoRetryUIFCPXMLOrGenericDispatch": true,
      "ObjectiveCArgumentCount": 2,
      "ObjectiveCReturnTypeArm64": "B",
      "ObjectiveCReturnTypeX86_64": "c",
      "ObjectiveCTypeEncodingArm64": "B16@0:8",
      "ObjectiveCTypeEncodingX86_64": "c16@0:8",
      "OriginalBuiltInRegistrationClass": "FFAudioUnitEffect(AudioUnitRegistration)",
      "OriginalBuiltInRegistrationOffsetArm64": "0x3a9de8",
      "OriginalBuiltInRegistrationSelector": "registerBuiltInAudioUnits",
      "OriginalBuiltInRegistrationTypeEncoding": "v16@0:8",
      "OriginalDeferredRegistrationClass": "FFAudioUnitEffect(AudioUnitRegistration)",
      "OriginalDeferredRegistrationOffsetArm64": "0x3a9fdc",
      "OriginalDeferredRegistrationOffsetX86_64": "0x52c0e0",
      "OriginalDeferredRegistrationSelector": "runDeferredRegistration",
      "OriginalDeferredRegistrationTypeEncoding": "v16@0:8",
      "OriginalSupportedTypeRegistrationClass": "FFAudioUnitInfoCacheBase",
      "OriginalSupportedTypeRegistrationOffsetArm64": "0x399750",
      "OriginalSupportedTypeRegistrationSelector": "forEachSupportedType:",
      "OriginalSupportedTypeRegistrationTypeEncoding": "v24@0:8@?16",
      "ProcessLifetimeOnly": true,
      "Replacement": "return_false_memory_only_no_restore",
      "RequiresCopiedHostContainmentAndUUID": true,
      "RequiresDisposableLibraryBootstrapAbsent": true,
      "RuntimeClass": "Flexo",
      "RuntimeDiscoveryAllowed": false,
      "Selector": "supportsThirdPartyAudioUnits",
      "ThirdPartyAudioUnitsAvailability": "unavailable_only_in_copied_app_process"
    }
  ' >/dev/null; then
    fail "audio-unit validation containment policy is not the exact Schema 16 contract"
  fi
}

verify_disposable_project_bootstrap_policy() {
  local policy_path="$1"
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ExecutionEnabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:MethodContractsPinnedIn' "$policy_path")" != "FCPCommandConsoleRuntime.m:FCPCCDisposableProjectBootstrapContracts" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EnvironmentVariable' "$policy_path")" != "FCPCC_BOOTSTRAP_DISPOSABLE_PROJECT" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EnvironmentValue' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:CanonicalLibraryPath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/FCPCommandConsole Test.fcpbundle" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixturesRootPath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/fixtures" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ProjectName' "$policy_path")" != "FCPCommandConsole Test" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:LifecycleNotification' "$policy_path")" != "NSApplicationDidFinishLaunchingNotification" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:MainQueueBoundedStateMachine' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:MaximumObservationTurns' "$policy_path")" != "24" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ObservationIntervalMilliseconds' "$policy_path")" != "1000" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RequiredPrecreateState' "$policy_path")" != "one_enrolled_library_one_default_event_zero_owned_clips_zero_projects_zero_deep_loaded_sequences" ]]; then
    fail "disposable project bootstrap admission gate is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenAPI' "$policy_path")" != "NSDocumentController.openDocumentWithContentsOfURL:display:completionHandler:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenDisplay' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenRequiresMainQueue' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenAllowedInitialOpenLibraryCount' "$policy_path")" != "0" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenMaximumInvocations' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenRequiredPreopenIdentity' "$policy_path")" != "canonical_path_no_symlink_directory_device_inode_persistent_uid" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenCompletionRequirements' "$policy_path")" != "non_nil_document_nil_error" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenRequiredPostopenState' "$policy_path")" != "exactly_one_enrolled_open_library" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenNoDialogResponderAutomationOrAlternatePath' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenNoRetry' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PublicLibraryOpenNeverCreatesRemovesOrOverwritesLibrary' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:KnownFailedLiveProvenancePath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/provenance/disposable-project-bootstrap-5244F4D3-8B35-4289-9B82-0CFC58CF0829.json" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:KnownFailedLiveReason' "$policy_path")" != "exactly_one_open_library_required" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:KnownFailedLiveMutationCounts' "$policy_path")" != "project_zero_import_zero_append_zero" ]]; then
    fail "disposable project bootstrap public library-open policy is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ActiveSessionOwnership' "$policy_path")" != "single_static_strong_root" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ActiveSessionSetAtLifecycleState' "$policy_path")" != "running_before_async_escape" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ActiveSessionDuplicateStartFailsClosed' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ActiveSessionWeakCompletionBackedByRoot' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ActiveSessionReleaseCondition' "$policy_path")" != "identity_matching_after_finished_timeout_pasteboard_and_provenance_finalization" ]]; then
    fail "disposable project bootstrap active-session lifetime policy is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ProjectCreationClass' "$policy_path")" != "FFProjectDocument" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ProjectCreationSelector' "$policy_path")" != "actionNewProject:name:sequence:actionName:error:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:DeepLoadedSequenceClass' "$policy_path")" != "FFLibrary" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:DeepLoadedSequenceSelector' "$policy_path")" != "_deepLoadedSequences" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EditorLoadClass' "$policy_path")" != "PEEditorContainerModule" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EditorLoadSelector' "$policy_path")" != "loadEditorForSequence:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ImportClass' "$policy_path")" != "FFMediaEventProject" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:NewClipSelector' "$policy_path")" != "newClipFromURL:manageFileType:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:AddOwnedClipSelector' "$policy_path")" != "addOwnedClipsObject:" ]]; then
    fail "disposable project bootstrap project, sequence, editor, or import route is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PasteboardClass' "$policy_path")" != "FFPasteboard" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PasteboardInitSelector' "$policy_path")" != "initWithName:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PasteboardWriteSelector' "$policy_path")" != "writeRangesOfMedia:options:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RangeFactoryClass' "$policy_path")" != "FigTimeRangeAndObject" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RangeFactorySelector' "$policy_path")" != "rangeAndObjectWithRange:andObject:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EditActionClass' "$policy_path")" != "FFEditAction" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EditActionSelector' "$policy_path")" != "editActionOfKind:backTimed:trackType:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:EditActionKind' "$policy_path")" != "2" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:BackTimed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:TrackType' "$policy_path")" != "all" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:TimelineClass' "$policy_path")" != "FFAnchoredTimelineModule" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:TimelinePerformEditSelector' "$policy_path")" != "performEditAction:fromPasteboardWithName:fromAnimation:" ]]; then
    fail "disposable project bootstrap append route is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ExpectedProCoreRelativeExecutablePath' "$policy_path")" != "Contents/Frameworks/ProCore.framework/Versions/A/ProCore" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ExpectedProCoreSHA256' "$policy_path")" != "567ef84ab789b5bbd44f7e4b5dfbb9640d397adf62ee3c2aeeb6a14330d62d17" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ExpectedProCoreArm64UUID' "$policy_path")" != "D55AA47E-F2E7-33A7-AFB5-C3F1475D1515" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ExpectedProCoreX86_64UUID' "$policy_path")" != "D189280F-E77A-31DF-9BDF-1479B7EE4766" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:NoAutoRetry' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:PostMutationFailureStatus' "$policy_path")" != "partial_unverified" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RollbackClaim' "$policy_path")" != "not_attempted_no_rollback_claimed" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:NoFixedFrameRatePrecondition' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RecordActualProjectFormat' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:RequiredPostappendVerification' "$policy_path")" != "exact_fixture_order_exact_adjacency_exact_imported_media_identifiers" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ProvenanceDirectory' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/provenance" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:ProvenanceSchemaVersion' "$policy_path")" != "1" ]]; then
    fail "disposable project bootstrap identity, recovery, or evidence contract is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixturePaths:0' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/fixtures/clip-a.mov" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixturePaths:1' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/fixtures/clip-b.mov" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixturePaths:2' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/fixtures/living-still.png" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixtureSHA256:0' "$policy_path")" != "cd44c0c9565c8231ec421541f4a4877f340eae7db5129fb46ffa14f0bf871444" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixtureSHA256:1' "$policy_path")" != "a38a03bf0ababfedc56c6086479c34649a8fea8b2435b04c4901f3987c66f67c" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixtureSHA256:2' "$policy_path")" != "170df5348f53221de630c7d7b385e6189f53a27baa2f2246ec7df4f379ed2567" ]] || /usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixturePaths:3' "$policy_path" >/dev/null 2>&1 || /usr/libexec/PlistBuddy -c 'Print :DisposableProjectBootstrap:FixtureSHA256:3' "$policy_path" >/dev/null 2>&1; then
    fail "disposable project bootstrap fixture order or SHA-256 evidence is not exact"
  fi
}

verify_disposable_project_resume_policy() {
  local policy_path="$1"
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:ExecutionEnabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:EnvironmentVariable' "$policy_path")" != "FCPCC_RESUME_DISPOSABLE_PROJECT" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:EnvironmentValue' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:CreateEnvironmentVariable' "$policy_path")" != "FCPCC_BOOTSTRAP_DISPOSABLE_PROJECT" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:CreateArmMustBeAbsent' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:LibraryCreateArmMustBeAbsent' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:Operation' "$policy_path")" != "disposable_project_resume" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:ProjectCreationSelectorMustNeverBeInvoked' "$policy_path")" != "actionNewProject:name:sequence:actionName:error:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:KnownPartialLiveProvenancePath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/provenance/disposable-project-bootstrap-B42DFA39-B63E-4050-9CDD-B4E2B00DACBA.json" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:NoAutoRetry' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:RollbackClaim' "$policy_path")" != "not_attempted_no_rollback_claimed" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenAdmitted' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenAPI' "$policy_path")" != "NSDocumentController.openDocumentWithContentsOfURL:display:completionHandler:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenMaximumInvocations' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenAllowedInitialOpenLibraryCount' "$policy_path")" != "0" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenRequiredPostopenState' "$policy_path")" != "exactly_one_enrolled_open_library" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenNeverCreatesRemovesOrOverwritesLibrary' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:PublicLibraryOpenNoRetry' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:RequiredOwnedClipCount' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:RequiredOwnedProjectClass' "$policy_path")" != "FFAnchoredSequence" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:OwnedClipsIncludeExistingProject' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:ProjectSetObservationRecordedOnly' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:SequenceDisplayNameClass' "$policy_path")" != "FFAnchoredSequence" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:SequenceIdentifierClass' "$policy_path")" != "FFBinObject" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:SequenceClassChain' "$policy_path")" != "FFAnchoredSequence_FFMediaState_FFMedia_FFBinObject" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableProjectResume:SequenceIsNotAnFFAnchoredObject' "$policy_path")" != "true" ]]; then
    fail "Schema 16 disposable project resume policy is not exact"
  fi
}

verify_planner_helper_policy() {
  local policy_path="$1"
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ExecutionEnabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:PanelBindingEnabled' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:FixedRelativePayloadRoot' "$policy_path")" != "Versions/A/Resources/PlannerHelperPayload" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ExecutableName' "$policy_path")" != "$planner_helper_name" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ResourceBundleName' "$policy_path")" != "$planner_bundle_name" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ManifestName' "$policy_path")" != "$planner_manifest_name" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:Architecture' "$policy_path")" != "arm64" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:SignatureRequirement' "$policy_path")" != "Apple Development" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:TeamIdentifier' "$policy_path")" != "$planner_team_identifier" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:MainThreadInvocationRejected' "$policy_path")" != "true" ]]; then
    fail "planner-helper bridge identity, execution, or thread policy is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ManifestMaximumBytes' "$policy_path")" != "65536" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:InputMaximumBytes' "$policy_path")" != "262144" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:OutputMaximumBytes' "$policy_path")" != "524288" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:StderrMaximumBytes' "$policy_path")" != "65536" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:MaximumBundleBytes' "$policy_path")" != "100000000" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:MaximumResourceBytes' "$policy_path")" != "10000000" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:DefaultTimeoutSeconds' "$policy_path")" != "5" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:MaximumTimeoutSeconds' "$policy_path")" != "60" ]]; then
    fail "planner-helper bridge byte, bundle, resource, or timeout bounds are not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:NoShell' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:NoNetwork' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:NoCallerExecutable' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:NoCallerPayloadRoot' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:AllowedProcessAPI' "$policy_path")" != "NSTask" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:AllowedNSTaskSource' "$policy_path")" != "FCPCCPlannerHelperBridge.m" || "$(/usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:Protocol' "$policy_path")" != "single_utf8_json_line_request_single_utf8_json_line_response" ]]; then
    fail "planner-helper bridge process and protocol policy is not exact"
  fi
  local index expected actual
  for (( index = 0; index < ${#planner_immutable_resources[@]}; index++ )); do
    expected="${planner_immutable_resources[$((index + 1))]}"
    actual="$(/usr/libexec/PlistBuddy -c "Print :PlannerHelperBridge:ImmutableResources:$index" "$policy_path")"
    [[ "$actual" == "$expected" ]] || fail "planner-helper bridge immutable resource order is not exact"
  done
  if /usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ImmutableResources:5' "$policy_path" >/dev/null 2>&1; then
    fail "planner-helper bridge permits an unexpected immutable resource"
  fi
}

verify_planner_helper_payload() {
  local payload_root="$1"
  local helper="$payload_root/$planner_helper_name"
  local bundle="$payload_root/$planner_bundle_name"
  local manifest="$payload_root/$planner_manifest_name"
  [[ -x "$planner_builder" ]] || fail "planner-helper builder is missing or not executable"
  [[ -d "$payload_root" && ! -L "$payload_root" && -f "$helper" && ! -L "$helper" && -d "$bundle" && ! -L "$bundle" && -f "$manifest" && ! -L "$manifest" ]] || fail "planner-helper payload root is incomplete"
  local entries actual_entries expected_entries
  actual_entries="$(/usr/bin/find "$payload_root" -mindepth 1 -maxdepth 1 -print | /usr/bin/sed "s|^$payload_root/||" | /usr/bin/sort)"
  expected_entries="$(printf '%s\n' "$planner_helper_name" "$planner_bundle_name" "$planner_manifest_name" | /usr/bin/sort)"
  [[ "$actual_entries" == "$expected_entries" ]] || fail "planner-helper payload root contains an unexpected entry"
  /usr/bin/lipo "$helper" -verify_arch arm64 >/dev/null 2>&1 || fail "planner-helper executable is not arm64"
  [[ "$(/usr/bin/lipo -archs "$helper")" == "arm64" ]] || fail "planner-helper executable contains an unexpected architecture"
  /usr/bin/codesign --strict --verify "$helper" >/dev/null || fail "planner-helper executable signature is invalid"
  local metadata="$build_dir/planner-helper-codesign-metadata.txt"
  /usr/bin/codesign -dvvv "$helper" > /dev/null 2> "$metadata" || fail "planner-helper executable signature metadata is unavailable"
  /usr/bin/grep -E -q '^Authority=Apple Development:.+$' "$metadata" || fail "planner-helper executable is not Apple Development signed"
  /usr/bin/grep -E -q "^TeamIdentifier=$planner_team_identifier$" "$metadata" || fail "planner-helper executable signing team is not the reviewed product team"
  if /usr/bin/grep -E -q '^Signature=adhoc$|flags=.*adhoc' "$metadata"; then
    fail "planner-helper executable has an ad-hoc signature"
  fi
  /usr/bin/jq -e --arg product "$planner_helper_name" --arg bundle "$planner_bundle_name" --arg team "$planner_team_identifier" --argjson resources "$(printf '%s\n' "${planner_immutable_resources[@]}" | /usr/bin/jq -R . | /usr/bin/jq -s .)" '
    type == "object" and .schema_version == 1 and .product == $product and .configuration == "release" and .architecture == "arm64" and
    (.executable | type == "object" and .relative_path == $product and .team_identifier == $team and (.architectures == ["arm64"])) and
    (.resource_bundle | type == "object" and .relative_path == $bundle and .signed == false and (.resources | type == "array" and length == 5 and map(.relative_path) == $resources))
  ' "$manifest" >/dev/null || fail "planner-helper manifest identity or immutable resource set is not exact"
  local relative expected_hash actual_hash
  for relative in "${planner_immutable_resources[@]}"; do
    expected_hash="$(/usr/bin/jq -er --arg path "$relative" '.resource_bundle.resources[] | select(.relative_path == $path) | .sha256' "$manifest")" || fail "planner-helper manifest omitted an immutable resource"
    actual_hash="$(/usr/bin/shasum -a 256 "$bundle/$relative" | /usr/bin/awk '{print $1}')"
    [[ "$expected_hash" == "$actual_hash" ]] || fail "planner-helper immutable resource hash differs from manifest"
  done
}

verify_compatibility_policy() {
  local policy_path="$1"
  /usr/bin/plutil -lint "$policy_path" >/dev/null || fail "compatibility policy is invalid"
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "16" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "com.apple.FinalCut" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedCopiedHostBundlePath' "$policy_path")" != "/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "12.3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "450152" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedStockPreInjectionHostExecutableSHA256' "$policy_path")" != "6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptRelativePath' "$policy_path")" != "Contents/_MASReceipt/receipt" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptSHA256' "$policy_path")" != "2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7" ]]; then
    fail "compatibility policy copied-host, receipt, or onboarding identity is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:0' "$policy_path")" != "constructor_main_thread_immediate_attempt" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:1' "$policy_path")" != "application_will_finish_launching_availability_retry" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "2" ]]; then
    fail "compatibility policy guard mode or phases are not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:ExecutionEnabled' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:MethodContractsPinnedIn' "$policy_path")" != "FCPCommandConsoleRuntime.m:FCPCCNativeTargetedRotateZoomStaticContracts" || "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:ExpectedFlexoSHA256' "$policy_path")" != "704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e" || "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:CandidatePixelConvention' "$policy_path")" != "product_normalized_top_left_to_centered_pixels_x_right_y_up" || "$(/usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:SetterOptions' "$policy_path")" != "0" ]]; then
    fail "native targeted rotate zoom policy is not the reviewed disabled exact-contract gate"
  fi
  for required_live_proof in candidate_pixel_coordinate_convention full_transform_keyframe_enumeration_and_exact_removal project_owned_undo_scope_and_exact_last_assistant_undo three_property_readback_and_lossless_rollback; do
    if ! /usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:RequiredLiveProofs' "$policy_path" | /usr/bin/grep -F -q "$required_live_proof"; then
      fail "native targeted rotate zoom policy is missing a required live proof: $required_live_proof"
    fi
  done
  if /usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:RequiredLiveProofs:4' "$policy_path" >/dev/null 2>&1; then
    fail "native targeted rotate zoom policy permits an unreviewed live-proof bypass"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ExecutionEnabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:MethodContractsPinnedIn' "$policy_path")" != "FCPCommandConsoleRuntime.m:FCPCCDisposableLibraryDocumentCreateContract" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:EnvironmentVariable' "$policy_path")" != "FCPCC_BOOTSTRAP_DISPOSABLE_LIBRARY" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:EnvironmentValue' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:CanonicalParentPath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:CanonicalTargetPath' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/FCPCommandConsole Test.fcpbundle" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ProvenanceDirectory' "$policy_path")" != "/Users/marcboyer/Movies/FCPCommandConsole/provenance" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:LifecycleNotification' "$policy_path")" != "NSApplicationDidFinishLaunchingNotification" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ModelClass' "$policy_path")" != "FFLibraryDocument" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:Selector' "$policy_path")" != "initWithURL:createDefaultEvent:error:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ObjectiveCTypeEncodingArm64' "$policy_path")" != "@36@0:8@16B24^@28" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ObjectiveCTypeEncodingX86_64' "$policy_path")" != "@36@0:8@16c24^@28" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1d9278" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x2abf80" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ExpectedFlexoSHA256' "$policy_path")" != "704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:CreateDefaultEvent' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:RequiredActiveLibraryCountBeforeCreate' "$policy_path")" != "0" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:RequiredActiveLibraryCountAfterCreate' "$policy_path")" != "1" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:TargetMustBeAbsent' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:NoSymlinkComponents' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:NoRetries' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:NeverOverwriteOrRemove' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:RequiredPostcreateIdentity' "$policy_path")" != "canonical_path_device_inode_persistent_uid" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:ProvenanceSchemaVersion' "$policy_path")" != "1" ]]; then
    fail "disposable library bootstrap policy is not the reviewed exact one-shot contract"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:PublicRegistrationAPI' "$policy_path")" != "NSDocumentController.addDocument:" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:PublicPresentationAPIs:0' "$policy_path")" != "NSDocument.makeWindowControllers" || "$(/usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:PublicPresentationAPIs:1' "$policy_path")" != "NSDocument.showWindows" ]] || /usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:PublicPresentationAPIs:2' "$policy_path" >/dev/null 2>&1; then
    fail "disposable library bootstrap public document API contract is not exact"
  fi
  verify_disposable_project_bootstrap_policy "$policy_path"
  verify_disposable_project_resume_policy "$policy_path"
  verify_audio_unit_validation_containment_policy "$policy_path"
  if /usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:2' "$policy_path" >/dev/null 2>&1; then
    fail "compatibility policy permits an unreviewed install phase"
  fi
  for removed_policy_key in CompatibilityInstallPhase MethodGuardLogSubsystem MethodGuardLogCategory PreferenceDomain ApprovedPreferenceKeys ApprovedPreferenceValues SynchronizeDeterministically; do
    if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
      fail "compatibility policy retains an obsolete scheduler, logger, or preference key"
    fi
  done
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "forward_original_setter_async_nil_metadata_provider" ]]; then
    fail "compatibility policy single onboarding query setter contract is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:RuntimeClass' "$policy_path")" != "CCFirstLaunchHelper" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:Selector' "$policy_path")" != "setupAndPresentFirstLaunchIfNeededWithCompletionHandler:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ObjectiveCTypeEncoding' "$policy_path")" != 'v24@0:8@?<v@?@"NSError">16' || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x924e8" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0xc74c0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:Replacement' "$policy_path")" != "immediate_noop_return_without_completion_access" ]]; then
    fail "compatibility policy cloud first-launch replacement contract is not exact"
  fi
  if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ObjectiveCArgumentCount' "$policy_path" >/dev/null 2>&1; then
    fail "compatibility policy retains an invalid Cloud nested-block argument-count condition"
  fi
  if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:2' "$policy_path" >/dev/null 2>&1; then
    fail "compatibility policy permits an extra method replacement"
  fi
  verify_planner_helper_policy "$policy_path"
}

/bin/mkdir -p "$build_dir"
/bin/mkdir -p "$framework_dir/Versions/A/Resources"

[[ -x "$planner_builder" ]] || fail "planner-helper builder is missing or not executable"
"$planner_builder" --build >/dev/null
"$planner_builder" --verify-existing >/dev/null
verify_planner_helper_payload "$planner_payload_root"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -dynamiclib \
  -fobjc-arc \
  -fmodules \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  -Werror=unguarded-availability-new \
  -Wl,-fatal_warnings \
  -framework Cocoa \
  -framework Security \
  -framework CoreFoundation \
  -install_name @rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime \
  -I "$runtime_dir/Sources" \
  "$runtime_dir/Sources/FCPCommandConsoleRuntime.m" \
  "$runtime_dir/Sources/FCPCCPlannerHelperBridge.m" \
  -o "$runtime_binary"

/bin/cp "$runtime_dir/Resources/FCPCommandConsoleRuntime-Info.plist" "$framework_dir/Versions/A/Resources/Info.plist"
/bin/cp "$repo_dir/config/fcpcommandconsole-library-manifest.json" "$framework_dir/Versions/A/Resources/FCPCommandConsoleLibraryManifest.json"
/bin/cp "$runtime_dir/Resources/LATER_INTEGRATION_INTERFACE.json" "$framework_dir/Versions/A/Resources/LATER_INTEGRATION_INTERFACE.json"
/bin/cp "$runtime_policy_source" "$runtime_policy_build"
/bin/rm -f "$retired_runtime_policy_build"
/bin/rm -rf -- "$planner_payload_build"
/bin/mkdir -p "$planner_payload_build"
/bin/cp -p "$planner_payload_root/$planner_helper_name" "$planner_payload_build/$planner_helper_name"
/bin/cp -R -p "$planner_payload_root/$planner_bundle_name" "$planner_payload_build/$planner_bundle_name"
/bin/cp -p "$planner_payload_root/$planner_manifest_name" "$planner_payload_build/$planner_manifest_name"
verify_planner_helper_payload "$planner_payload_build"
verify_planner_helper_policy "$runtime_policy_build"
/bin/ln -sfn A "$framework_dir/Versions/Current"
/bin/ln -sfn Versions/Current/FCPCommandConsoleRuntime "$framework_dir/FCPCommandConsoleRuntime"
/bin/ln -sfn Versions/Current/Resources "$framework_dir/Resources"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -std=c11 \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  "$tool_dir/src/main.c" \
  -o "$injector_binary"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -fobjc-arc \
  -fmodules \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  -framework Foundation \
  "$patcher_dir/verify-entitlement-allowlist.m" \
  -o "$entitlement_verifier"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -std=c11 \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  "$patcher_dir/fcpcc-atomic-swap.c" \
  -o "$atomic_swap_helper"

/usr/bin/plutil -lint "$framework_dir/Versions/A/Resources/Info.plist" >/dev/null
verify_compatibility_policy "$runtime_policy_build"
/usr/bin/lipo "$runtime_binary" -verify_arch arm64
/usr/bin/lipo "$runtime_binary" -verify_arch x86_64
/usr/bin/lipo "$injector_binary" -verify_arch arm64
/usr/bin/lipo "$injector_binary" -verify_arch x86_64
/usr/bin/lipo "$entitlement_verifier" -verify_arch arm64
/usr/bin/lipo "$entitlement_verifier" -verify_arch x86_64
/usr/bin/lipo "$atomic_swap_helper" -verify_arch arm64
/usr/bin/lipo "$atomic_swap_helper" -verify_arch x86_64

source_hash="$(/usr/bin/shasum -a 256 "$tool_dir/src/main.c" | /usr/bin/awk '{print $1}')"
runtime_hash="$(/usr/bin/shasum -a 256 "$runtime_binary" | /usr/bin/awk '{print $1}')"
injector_hash="$(/usr/bin/shasum -a 256 "$injector_binary" | /usr/bin/awk '{print $1}')"
printf 'runtime=FCPCommandConsoleRuntime architectures=arm64,x86_64 sha256=%s\n' "$runtime_hash"
printf 'injector=fcpcc-insert-dylib source_sha256=%s binary_sha256=%s\n' "$source_hash" "$injector_hash"
printf 'entitlement_verifier=fcpcc-entitlement-verify architectures=arm64,x86_64\n'
printf 'atomic_swap_helper=fcpcc-atomic-swap architectures=arm64,x86_64 renameatx_np=RENAME_SWAP\n'

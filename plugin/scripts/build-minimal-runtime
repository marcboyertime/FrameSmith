#!/bin/zsh
# Build only project-owned offline artifacts. This script intentionally has no
# dependency resolution or network behavior.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
build_dir="$plugin_dir/build"
runtime_dir="$plugin_dir/splicekit_minimal"
tool_dir="$plugin_dir/tools/fcpcc-insert-dylib"
patcher_dir="$plugin_dir/patcher"
framework_dir="$build_dir/FCPCommandConsoleRuntime.framework"
runtime_binary="$framework_dir/Versions/A/FCPCommandConsoleRuntime"
injector_binary="$build_dir/fcpcc-insert-dylib"
entitlement_verifier="$build_dir/fcpcc-entitlement-verify"

fail() {
  print -u2 -r -- "build-minimal-runtime: $1"
  exit 1
}

verify_compatibility_policy() {
  local policy_path="$1"
  local -a expected_classes
  local -a expected_selectors
  local -a expected_kinds
  local -a expected_argument_counts
  local -a expected_return_types
  local -a expected_type_encodings
  local -a expected_replacements

  expected_classes=(
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro23CloudContentFeatureFlag'
    '_TtC13Final_Cut_Pro23CloudContentFeatureFlag'
    'CCFirstLaunchHelper'
  )
  expected_selectors=(
    'updateCatalogAndRegistry'
    'isCloudContentEnabled'
    'isRunningSubscriptionApp'
    'startListeningForApplicationDidBecomeActiveNotifications'
    'isEnabled'
    'shouldShowFirstLaunchExperience'
    'setupAndPresentFirstLaunchIfNeededWithCompletionHandler:'
  )
  expected_kinds=(instance instance instance instance class class instance)
  expected_argument_counts=(2 2 2 2 2 2 3)
  expected_return_types=(v B B v B B v)
  expected_type_encodings=(
    'v16@0:8'
    'B16@0:8'
    'B16@0:8'
    'v16@0:8'
    'B16@0:8'
    'B16@0:8'
    'v24@0:8@?<v@?@"NSError">16'
  )
  expected_replacements=(void_noop return_false return_false void_noop return_false return_false completion_nil_success)

  /usr/bin/plutil -lint "$policy_path" >/dev/null || fail "compatibility policy is invalid"
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "com.local.fcpcommandconsole.FinalCut" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "12.3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "450152" || "$(/usr/libexec/PlistBuddy -c 'Print :PreferenceDomain' "$policy_path")" != "kCFPreferencesCurrentApplication" ]]; then
    fail "compatibility policy host or preference domain is not exact"
  fi
  if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:0' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:1' "$policy_path")" != "will_finish_launching_once" ]]; then
    fail "compatibility policy guard mode or phases are not exact"
  fi
  if /usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:2' "$policy_path" >/dev/null 2>&1; then
    fail "compatibility policy permits an extra install phase"
  fi

  local index
  for index in {1..7}; do
    local policy_index=$((index - 1))
    if [[ "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:RuntimeClass" "$policy_path")" != "${expected_classes[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:Selector" "$policy_path")" != "${expected_selectors[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:MethodKind" "$policy_path")" != "${expected_kinds[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCArgumentCount" "$policy_path")" != "${expected_argument_counts[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCReturnType" "$policy_path")" != "${expected_return_types[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCTypeEncoding" "$policy_path")" != "${expected_type_encodings[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:Replacement" "$policy_path")" != "${expected_replacements[index]}" ]]; then
      fail "compatibility policy replacement $policy_index is not the fixed reviewed contract"
    fi
  done
  if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:7' "$policy_path" >/dev/null 2>&1; then
    fail "compatibility policy permits an extra method replacement"
  fi
}

/bin/mkdir -p "$build_dir"
/bin/mkdir -p "$framework_dir/Versions/A/Resources"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -dynamiclib \
  -fobjc-arc \
  -fmodules \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  -Werror=unguarded-availability-new \
  -Wl,-fatal_warnings \
  -framework Cocoa \
  -install_name @rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime \
  -I "$runtime_dir/Sources" \
  "$runtime_dir/Sources/FCPCommandConsoleRuntime.m" \
  -o "$runtime_binary"

/bin/cp "$runtime_dir/Resources/FCPCommandConsoleRuntime-Info.plist" "$framework_dir/Versions/A/Resources/Info.plist"
/bin/cp "$repo_dir/config/fcpcommandconsole-library-manifest.json" "$framework_dir/Versions/A/Resources/FCPCommandConsoleLibraryManifest.json"
/bin/cp "$runtime_dir/Resources/LATER_INTEGRATION_INTERFACE.json" "$framework_dir/Versions/A/Resources/LATER_INTEGRATION_INTERFACE.json"
/bin/cp "$runtime_dir/Resources/FCPCCIsolatedCloudContentCompatibility.plist" "$framework_dir/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
/bin/ln -sfn A "$framework_dir/Versions/Current"
/bin/ln -sfn Versions/Current/FCPCommandConsoleRuntime "$framework_dir/FCPCommandConsoleRuntime"
/bin/ln -sfn Versions/Current/Resources "$framework_dir/Resources"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -std=c11 \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  "$tool_dir/src/main.c" \
  -o "$injector_binary"

/usr/bin/clang \
  -arch arm64 \
  -arch x86_64 \
  -mmacosx-version-min=13.0 \
  -fobjc-arc \
  -fmodules \
  -Wall \
  -Wextra \
  -Werror \
  -Wstrict-prototypes \
  -framework Foundation \
  "$patcher_dir/verify-entitlement-allowlist.m" \
  -o "$entitlement_verifier"

/usr/bin/plutil -lint "$framework_dir/Versions/A/Resources/Info.plist" >/dev/null
verify_compatibility_policy "$framework_dir/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
/usr/bin/lipo "$runtime_binary" -verify_arch arm64
/usr/bin/lipo "$runtime_binary" -verify_arch x86_64
/usr/bin/lipo "$injector_binary" -verify_arch arm64
/usr/bin/lipo "$injector_binary" -verify_arch x86_64
/usr/bin/lipo "$entitlement_verifier" -verify_arch arm64
/usr/bin/lipo "$entitlement_verifier" -verify_arch x86_64

source_hash="$(/usr/bin/shasum -a 256 "$tool_dir/src/main.c" | /usr/bin/awk '{print $1}')"
runtime_hash="$(/usr/bin/shasum -a 256 "$runtime_binary" | /usr/bin/awk '{print $1}')"
injector_hash="$(/usr/bin/shasum -a 256 "$injector_binary" | /usr/bin/awk '{print $1}')"
printf 'runtime=FCPCommandConsoleRuntime architectures=arm64,x86_64 sha256=%s\n' "$runtime_hash"
printf 'injector=fcpcc-insert-dylib source_sha256=%s binary_sha256=%s\n' "$source_hash" "$injector_hash"
printf 'entitlement_verifier=fcpcc-entitlement-verify architectures=arm64,x86_64\n'

#!/bin/zsh
# Offline audits for the minimal runtime and isolated-copy patcher.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
runtime_source="$plugin_dir/splicekit_minimal/Sources"
runtime_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
runtime_policy_source="$plugin_dir/splicekit_minimal/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
runtime_policy_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
injector="$plugin_dir/build/fcpcc-insert-dylib"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
runtime_updater="$plugin_dir/patcher/update-copied-runtime"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
preferences_file="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
test_dir="$(/usr/bin/mktemp -d /tmp/fcpcc-offline-tests.XXXXXX)"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
rg_bin="$(command -v rg || true)"

fail() {
    print -u2 -r -- "run-offline-tests: $1"
    exit 1
}

require_absent() {
    local expression="$1"
    local scope="$2"
    if "$rg_bin" -n -i --glob '*.[mh]' "$expression" "$scope" >/dev/null; then
        fail "forbidden runtime surface matched: $expression"
    fi
}

if [[ ! -x "$injector" || ! -x "$entitlement_verifier" || ! -f "$runtime_build" || ! -f "$runtime_policy_source" || ! -f "$runtime_policy_build" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before tests"
fi
if [[ -z "$rg_bin" ]]; then
    fail "rg is required for source audits"
fi
if [[ ! -d "$source_app" || ! -f "$source_executable" ]]; then
    fail "required source app is missing"
fi

stock_main_before="$(/usr/bin/shasum -a 256 "$source_executable" | /usr/bin/awk '{print $1}')"
stock_info_before="$(/usr/bin/shasum -a 256 "$source_app/Contents/Info.plist" | /usr/bin/awk '{print $1}')"
if [[ -f "$preferences_file" ]]; then
    /usr/bin/plutil -convert xml1 -o "$test_dir/preferences-before.xml" "$preferences_file"
else
    print -r -- "absent" > "$test_dir/preferences-before.xml"
fi
preferences_before="$(/usr/bin/shasum -a 256 "$test_dir/preferences-before.xml" | /usr/bin/awk '{print $1}')"

for forbidden in \
    'NSSelectorFromString' \
    'performSelector' \
    'objc_msgSend' \
    'valueForKey:' \
    'setValue:forKey:' \
    'dlopen' \
    'dlsym' \
    'NSTask' \
    'socket' \
    'bind' \
    '\blisten[[:space:]]*\(' \
    'accept' \
    'NSURLSession' \
    'CFNetwork' \
    'WKWebView' \
    'ScreenCaptureKit' \
    'CGWindowList' \
    'sendAction:' \
    'FCPXML' \
    'NSUserDefaults' \
    'objc_getClassList' \
    'class_copyMethodList' \
    'NSClassFromString' \
    'NSSelectorFromString' \
    'method_exchangeImplementations' \
    'method_setImplementation' \
    'strstr' \
    'Sentry' \
    'telemetry' \
    '\\bLua\\b' \
    '\\bPython\\b' \
    'breakpoint' \
    'automation' \
    'swizzle'; do
    require_absent "$forbidden" "$runtime_source"
done

for required_identifier in \
    'native.targeted_rotate_zoom' \
    'look.old_television' \
    'transition.natural_dissolve' \
    'motion.living_still'; do
    if ! "$rg_bin" -F -q "$required_identifier" "$runtime_source/FCPCommandConsoleRuntime.m"; then
        fail "missing required fixed effect identifier: $required_identifier"
    fi
done
if [[ "$("$rg_bin" -o '(native\.targeted_rotate_zoom|look\.old_television|transition\.natural_dissolve|motion\.living_still)' "$runtime_source/FCPCommandConsoleRuntime.m" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "4" ]]; then
    fail "fixed effect identifier domain is not exactly four values"
fi
if ! "$rg_bin" -F -q '[self.applyButton setEnabled:NO];' "$runtime_source/FCPCommandConsoleRuntime.m"; then
    fail "panel Apply is not explicitly disabled by default"
fi
if "$rg_bin" -F 'setEnabled:YES' "$runtime_source/FCPCommandConsoleRuntime.m" >/dev/null; then
    fail "panel code can enable a mutation control"
fi
if [[ "$("$rg_bin" -F -o 'return FCPCCMutationResult.unsupportedUnverified;' "$runtime_source/FCPCommandConsoleRuntime.m" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" -lt 2 ]]; then
    fail "mutation stubs do not fail closed"
fi
if ! "$rg_bin" -F -q 'enumerateCompleteOpenLibrarySet' "$runtime_source/FCPCommandConsoleRuntime.m"; then
    fail "fixed open-library traversal seam is absent"
fi
if ! "$rg_bin" -F -q 'openLibrarySet.libraries.count != 1' "$runtime_source/FCPCommandConsoleRuntime.m"; then
    fail "exactly-one-library gate is absent"
fi
for manifest_field in canonical_path expected_device expected_inode persistent_uid; do
    if ! "$rg_bin" -F -q "$manifest_field" "$repo_dir/config/fcpcommandconsole-library-manifest.json"; then
        fail "library manifest field missing: $manifest_field"
    fi
done

runtime_implementation="$runtime_source/FCPCommandConsoleRuntime.m"
if "$rg_bin" -n -i -F 'com.apple.FinalCut' "$runtime_source" >/dev/null; then
    fail "runtime contains the production Final Cut preference domain"
fi
if "$rg_bin" -n -i -F 'defaults' "$runtime_source" >/dev/null; then
    fail "runtime invokes or names defaults"
fi
preference_write_count="$("$rg_bin" -F -c 'CFPreferencesSetAppValue' "$runtime_implementation")"
if [[ "$preference_write_count" != "2" ]]; then
    fail "runtime does not have exactly two isolated preference writes"
fi
preference_write_lines="$("$rg_bin" -n -F 'CFPreferencesSetAppValue' "$runtime_implementation")"
if ! print -r -- "$preference_write_lines" | "$rg_bin" -F -q 'FCPCCCloudContentFirstLaunchCompletedKey' || ! print -r -- "$preference_write_lines" | "$rg_bin" -F -q 'FCPCCFFCloudContentDisabledKey'; then
    fail "runtime preference writes are not restricted to the two approved fixed keys"
fi
host_gate_line="$("$rg_bin" -n -F 'FCPCCGateStatus *containment = [[[FCPCCRuntimeContainmentGate alloc] init] evaluate];' "$runtime_implementation" | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
host_guard_line="$("$rg_bin" -n -F 'if (!containment.isVerified)' "$runtime_implementation" | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
first_preference_write_line="$(print -r -- "$preference_write_lines" | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
synchronize_line="$("$rg_bin" -n -F 'CFPreferencesAppSynchronize(kCFPreferencesCurrentApplication)' "$runtime_implementation" | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
if [[ -z "$host_gate_line" || -z "$host_guard_line" || -z "$first_preference_write_line" || -z "$synchronize_line" || "$host_gate_line" -ge "$host_guard_line" || "$host_guard_line" -ge "$first_preference_write_line" || "$first_preference_write_line" -ge "$synchronize_line" ]]; then
    fail "exact-host containment gate does not precede isolated preference writes and synchronization"
fi
constructor_tail="$(/usr/bin/sed -n '/static void FCPCCInstallRuntime(void)/,$p' "$runtime_implementation")"
if print -r -- "$constructor_tail" | "$rg_bin" -F -q 'showPanel:' || print -r -- "$constructor_tail" | "$rg_bin" -F -q 'showWindow:' || print -r -- "$constructor_tail" | "$rg_bin" -F -q 'makeKeyAndOrderFront:'; then
    fail "runtime constructor auto-shows the panel"
fi
if ! print -r -- "$constructor_tail" | "$rg_bin" -F -q 'FCPCCInstallIsolatedCloudContentMethodCompatibility();'; then
    fail "runtime constructor does not attempt the fixed CloudContent method guard"
fi
method_guard_attempt_source="$(/usr/bin/sed -n '/static void FCPCCAttemptIsolatedCloudContentMethodCompatibility/,/static void FCPCCInstallIsolatedCloudContentMethodCompatibility/p' "$runtime_implementation")"
method_guard_gate_line="$(print -r -- "$method_guard_attempt_source" | "$rg_bin" -n -F 'FCPCCGateStatus *containment = [[[FCPCCRuntimeContainmentGate alloc] init] evaluate];' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
method_guard_guard_line="$(print -r -- "$method_guard_attempt_source" | "$rg_bin" -n -F 'if (!containment.isVerified)' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
method_guard_install_line="$(print -r -- "$method_guard_attempt_source" | "$rg_bin" -n -F 'FCPCCInstallCloudContentCompatibilityEntry(&FCPCCCloudContentCompatibilityEntries[index], index, status);' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
if [[ -z "$method_guard_gate_line" || -z "$method_guard_guard_line" || -z "$method_guard_install_line" || "$method_guard_gate_line" -ge "$method_guard_guard_line" || "$method_guard_guard_line" -ge "$method_guard_install_line" ]]; then
    fail "exact-host containment gate does not precede every fixed method-guard installation"
fi
method_guard_registration_source="$(/usr/bin/sed -n '/static void FCPCCInstallIsolatedCloudContentMethodCompatibility/,/^}/p' "$runtime_implementation")"
if [[ "$(print -r -- "$method_guard_registration_source" | "$rg_bin" -F -o 'NSApplicationWillFinishLaunchingNotification' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$(print -r -- "$method_guard_registration_source" | "$rg_bin" -F -o 'dispatch_async(dispatch_get_main_queue(), ^{' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]] || ! print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'FCPCCAttemptIsolatedCloudContentMethodCompatibility(FCPCCCloudContentAttemptPhaseConstructor);' || ! print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'FCPCCAttemptIsolatedCloudContentMethodCompatibility(FCPCCCloudContentAttemptPhaseWillFinishLaunching);' || ! print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'FCPCCAttemptIsolatedCloudContentMethodCompatibility(FCPCCCloudContentAttemptPhaseMainQueue);'; then
    fail "method guard does not use exactly constructor, single will-finish, and one main-queue attempts"
fi
if ! "$rg_bin" -F -q 'if (status.willFinishLaunchingAttempts != 0)' "$runtime_implementation"; then
    fail "method guard will-finish retry is not explicitly one-shot"
fi
if ! "$rg_bin" -F -q 'if (status.mainQueueAttempts != 0)' "$runtime_implementation" || ! "$rg_bin" -F -q 'static const NSUInteger FCPCCCloudContentCompatibilityMaximumAttempts = 3;' "$runtime_implementation"; then
    fail "method guard main-queue retry or fixed three-attempt bound is missing"
fi
runtime_constructor_source="$(/usr/bin/sed -n '/__attribute__((constructor))/,/^}/p' "$runtime_implementation")"
guard_install_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F 'FCPCCInstallIsolatedCloudContentMethodCompatibility();' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
menu_enqueue_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F '[[FCPCCRuntime sharedRuntime] installMenuWhenReady];' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
if [[ -z "$guard_install_line" || -z "$menu_enqueue_line" || "$guard_install_line" -ge "$menu_enqueue_line" ]]; then
    fail "guard main-queue scheduling is not registered before menu scheduling"
fi
if print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'installMenuWhenReady' || print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'showPanel:' || print -r -- "$method_guard_registration_source" | "$rg_bin" -F -q 'FCPCCLibraryInvariantGate'; then
    fail "main-queue method-guard block may not show UI or access a library"
fi
for forbidden_method_guard_surface in 'dispatch_after' 'NSTimer' 'performSelector:afterDelay:' '@try'; do
    if "$rg_bin" -F -q "$forbidden_method_guard_surface" "$runtime_implementation"; then
        fail "runtime method guard contains a forbidden polling or exception-suppression surface: $forbidden_method_guard_surface"
    fi
done
/usr/bin/plutil -lint "$runtime_policy_source" >/dev/null
/usr/bin/plutil -lint "$runtime_policy_build" >/dev/null
for policy_path in "$runtime_policy_source" "$runtime_policy_build"; do
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "com.local.fcpcommandconsole.FinalCut" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "12.3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "450152" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostExecutableSHA256' "$policy_path")" != "6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :PreferenceDomain' "$policy_path")" != "kCFPreferencesCurrentApplication" ]]; then
        fail "compatibility policy host or isolated preference domain is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:0' "$policy_path")" != "CloudContentFirstLaunchCompleted" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:1' "$policy_path")" != "FFCloudContentDisabled" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceValues:CloudContentFirstLaunchCompleted' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceValues:FFCloudContentDisabled' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :SynchronizeDeterministically' "$policy_path")" != "true" ]]; then
        fail "compatibility policy does not contain exactly the two reviewed true values"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedPreferenceKeys:2' "$policy_path" >/dev/null 2>&1; then
        fail "compatibility policy permits more than two preference keys"
    fi
done
expected_replacement_classes=(
    '_TtC13Final_Cut_Pro25DemoProjectDownloadHelper'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro19CloudContentCatalog'
    '_TtC13Final_Cut_Pro23CloudContentFeatureFlag'
    '_TtC13Final_Cut_Pro23CloudContentFeatureFlag'
    'CCFirstLaunchHelper'
)
expected_replacement_selectors=(
    'fetchDefaultDemoProjectWithCompletionHandler:'
    'isCloudContentEnabled'
    'isRunningSubscriptionApp'
    'startListeningForApplicationDidBecomeActiveNotifications'
    'isEnabled'
    'shouldShowFirstLaunchExperience'
    'setupAndPresentFirstLaunchIfNeededWithCompletionHandler:'
)
expected_replacement_kinds=(instance instance instance instance class class instance)
expected_replacement_argument_counts=(3 2 2 2 2 2 3)
expected_replacement_return_types=(v B B v B B v)
expected_replacement_type_encodings=(
    'v24@0:8@?<v@?@"_TtC13Final_Cut_Pro23CloudContentDemoProject"@"NSError">16'
    'B16@0:8'
    'B16@0:8'
    'v16@0:8'
    'B16@0:8'
    'B16@0:8'
    'v24@0:8@?<v@?@"NSError">16'
)
expected_replacement_contracts=(completion_nil_project_local_error return_false return_false void_noop return_false return_false completion_nil_success)
for policy_path in "$runtime_policy_source" "$runtime_policy_build"; do
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:0' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:1' "$policy_path")" != "will_finish_launching_once" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:2' "$policy_path")" != "main_queue_once" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :MethodGuardLogSubsystem' "$policy_path")" != "com.local.fcpcommandconsole.runtime" || "$(/usr/libexec/PlistBuddy -c 'Print :MethodGuardLogCategory' "$policy_path")" != "cloud_content_method_guard" ]]; then
        fail "compatibility policy method guard mode or install phases are not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:3' "$policy_path" >/dev/null 2>&1; then
        fail "compatibility policy permits an extra method-guard install phase"
    fi
    for index in {1..7}; do
        policy_index=$((index - 1))
        if [[ "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:RuntimeClass" "$policy_path")" != "${expected_replacement_classes[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:Selector" "$policy_path")" != "${expected_replacement_selectors[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:MethodKind" "$policy_path")" != "${expected_replacement_kinds[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCArgumentCount" "$policy_path")" != "${expected_replacement_argument_counts[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCReturnType" "$policy_path")" != "${expected_replacement_return_types[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:ObjectiveCTypeEncoding" "$policy_path")" != "${expected_replacement_type_encodings[index]}" || "$(/usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$policy_index:Replacement" "$policy_path")" != "${expected_replacement_contracts[index]}" ]]; then
            fail "compatibility policy method replacement $policy_index is not the exact reviewed contract"
        fi
    done
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:7' "$policy_path" >/dev/null 2>&1; then
        fail "compatibility policy permits an extra method replacement"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0xce540" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x107ca0" ]]; then
        fail "compatibility policy demo-project bridge implementation offsets are not exact"
    fi
    for index in {1..6}; do
        if /usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$index:ExpectedOriginalImplementationOffsetArm64" "$policy_path" >/dev/null 2>&1 || /usr/libexec/PlistBuddy -c "Print :ApprovedMethodReplacements:$index:ExpectedOriginalImplementationOffsetX86_64" "$policy_path" >/dev/null 2>&1; then
            fail "compatibility policy permits an unexpected implementation-offset contract"
        fi
    done
done
if ! /usr/bin/cmp -s "$runtime_policy_source" "$runtime_policy_build"; then
    fail "built compatibility policy differs from the project-owned source policy"
fi

for required_guard_fragment in \
    'static const FCPCCCloudContentCompatibilityEntry FCPCCCloudContentCompatibilityEntries[]' \
    'static const NSUInteger FCPCCCloudContentCompatibilityEntryCount' \
    'FCPCCInstallCloudContentCompatibilityEntry' \
    'FCPCCAttemptIsolatedCloudContentMethodCompatibility' \
    'method_getNumberOfArguments' \
    'method_copyReturnType' \
    'method_getTypeEncoding' \
    'class_replaceMethod' \
    'sel_registerName(entry->selectorName)' \
    'objc_getClass(entry->runtimeClassName)' \
    'FCPCCCloudContentCompleteFirstLaunch' \
    'FCPCCCloudContentCompleteDemoProjectUnavailable' \
    'FCPCCCloudContentOriginalImplementationMatches' \
    'dladdr((const void *)originalImplementation, &implementationImage)' \
    'completion(nil, error);' \
    'FCPCCCloudContentAttemptPhaseMainQueue' \
    'FCPCCCloudContentCompatibilityMaximumAttempts = 3' \
    'os_log_create("com.local.fcpcommandconsole.runtime", "cloud_content_method_guard")' \
    'phase=%{public}s dispositions=%{public}s'; do
    if ! "$rg_bin" -F -q "$required_guard_fragment" "$runtime_implementation"; then
        fail "runtime is missing required fixed method-guard operation: $required_guard_fragment"
    fi
done
if [[ "$("$rg_bin" -F -o 'class_replaceMethod' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o 'sel_registerName(entry->selectorName)' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o 'objc_getClass(entry->runtimeClassName)' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "runtime method guard is not limited to the one fixed installation path"
fi
method_guard_entries_source="$(/usr/bin/sed -n '/static const FCPCCCloudContentCompatibilityEntry FCPCCCloudContentCompatibilityEntries\[\] = {/,/^};/p' "$runtime_implementation")"
demo_project_runtime_class_count="$(print -r -- "$method_guard_entries_source" | "$rg_bin" -F -o '        "_TtC13Final_Cut_Pro25DemoProjectDownloadHelper",' | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
catalog_runtime_class_count="$(print -r -- "$method_guard_entries_source" | "$rg_bin" -F -o '        "_TtC13Final_Cut_Pro19CloudContentCatalog",' | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
feature_runtime_class_count="$(print -r -- "$method_guard_entries_source" | "$rg_bin" -F -o '        "_TtC13Final_Cut_Pro23CloudContentFeatureFlag",' | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
first_launch_runtime_class_count="$(print -r -- "$method_guard_entries_source" | "$rg_bin" -F -o '        "CCFirstLaunchHelper",' | /usr/bin/wc -l | /usr/bin/tr -d ' ')"
if [[ "$demo_project_runtime_class_count" != "1" || "$catalog_runtime_class_count" != "3" || "$feature_runtime_class_count" != "2" || "$first_launch_runtime_class_count" != "1" ]]; then
    fail "runtime method guard class allowlist cardinality is not exactly 1 demo-project, 3 catalog, 2 feature-flag, and 1 first-launch entries"
fi
for selector_literal in \
    '"fetchDefaultDemoProjectWithCompletionHandler:"' \
    '"isCloudContentEnabled"' \
    '"isRunningSubscriptionApp"' \
    '"startListeningForApplicationDidBecomeActiveNotifications"' \
    '"isEnabled"' \
    '"shouldShowFirstLaunchExperience"' \
    '"setupAndPresentFirstLaunchIfNeededWithCompletionHandler:"'; do
    if [[ "$("$rg_bin" -F -o "$selector_literal" "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
        fail "runtime method guard selector allowlist is not exact: $selector_literal"
    fi
done
if [[ "$("$rg_bin" -F -o '"v16@0:8"' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o '"B16@0:8"' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "4" || "$("$rg_bin" -F -o '"v24@0:8@?<v@?@\"_TtC13Final_Cut_Pro23CloudContentDemoProject\"@\"NSError\">16"' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o '"v24@0:8@?<v@?@\"NSError\">16"' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "runtime method guard type-encoding cardinality is not exact"
fi
if "$rg_bin" -F -q 'completion(nil, nil);' "$runtime_implementation"; then
    fail "demo-project compatibility bridge may not report a nil result as success"
fi
if [[ "$("$rg_bin" -F -o 'FCPCCLogCloudContentMethodCompatibilityAttempt(phase, status);' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "2" || "$(printf '%s' "$method_guard_registration_source" | "$rg_bin" -F -o 'dispatch_async(dispatch_get_main_queue(), ^{' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "method guard diagnostics or main-queue scheduling is not bounded to the reviewed one-shot shape"
fi


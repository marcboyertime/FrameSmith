#!/bin/zsh
# Offline audits for the minimal runtime and isolated-copy patcher.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
runtime_source="$plugin_dir/splicekit_minimal/Sources"
runtime_implementation="$runtime_source/FCPCommandConsoleRuntime.m"
runtime_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
runtime_policy_source="$plugin_dir/splicekit_minimal/Resources/FCPCCOnboardingQueryCompatibility.plist"
runtime_policy_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
retired_runtime_policy_source="$plugin_dir/splicekit_minimal/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
retired_runtime_policy_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
injector="$plugin_dir/build/fcpcc-insert-dylib"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
runtime_updater="$plugin_dir/patcher/update-copied-runtime"
runtime_verifier="$plugin_dir/patcher/verify-copied-fcp"
initial_patcher="$plugin_dir/patcher/patch-copied-fcp"
repair_patcher="$plugin_dir/patcher/repair-library-validation-entitlement"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
source_app="/Applications/Final Cut Pro.app"
source_executable="$source_app/Contents/MacOS/Final Cut Pro"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
source_onboarding_framework="$source_app/$onboarding_framework_relative_executable_path"
mas_receipt_relative_path="Contents/_MASReceipt/receipt"
source_mas_receipt="$source_app/$mas_receipt_relative_path"
onboarding_framework_load_path="@rpath/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
expected_mas_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
test_dir="$(/usr/bin/mktemp -d /tmp/fcpcc-offline-tests.XXXXXX)"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
rg_bin="$(command -v rg || true)"

fail() {
    print -u2 -r -- "run-offline-tests: $1"
    exit 1
}

require_absent() {
    local expression="$1"
    local scope="$2"
    if "$rg_bin" -n -i --glob '*.[mh]' "$expression" "$scope" >/dev/null; then
        fail "forbidden runtime surface matched: $expression"
    fi
}

require_fragment() {
    local fragment="$1"
    local path="$2"
    local label="$3"
    if ! "$rg_bin" -F -q "$fragment" "$path"; then
        fail "$label is missing required fragment: $fragment"
    fi
}

if [[ ! -x "$injector" || ! -x "$entitlement_verifier" || ! -f "$runtime_build" || ! -f "$runtime_policy_source" || ! -f "$runtime_policy_build" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before tests"
fi
if [[ -z "$rg_bin" ]]; then
    fail "rg is required for source audits"
fi
if [[ ! -d "$source_app" || ! -f "$source_executable" || ! -f "$source_onboarding_framework" || ! -f "$source_mas_receipt" ]]; then
    fail "required source app or reviewed onboarding framework is missing"
fi

stock_main_before="$(/usr/bin/shasum -a 256 "$source_executable" | /usr/bin/awk '{print $1}')"
stock_info_before="$(/usr/bin/shasum -a 256 "$source_app/Contents/Info.plist" | /usr/bin/awk '{print $1}')"
stock_onboarding_before="$(/usr/bin/shasum -a 256 "$source_onboarding_framework" | /usr/bin/awk '{print $1}')"
/usr/bin/dwarfdump --uuid "$source_onboarding_framework" > "$test_dir/stock-onboarding-framework.uuids.txt"
stock_onboarding_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$test_dir/stock-onboarding-framework.uuids.txt")"
stock_onboarding_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$test_dir/stock-onboarding-framework.uuids.txt")"
stock_mas_receipt_before="$(/usr/bin/shasum -a 256 "$source_mas_receipt" | /usr/bin/awk '{print $1}')"
if [[ "$stock_onboarding_before" != "$expected_onboarding_framework_sha256" || "$stock_onboarding_arm64_uuid" != "$expected_onboarding_framework_arm64_uuid" || "$stock_onboarding_x86_64_uuid" != "$expected_onboarding_framework_x86_64_uuid" || "$stock_mas_receipt_before" != "$expected_mas_receipt_sha256" ]]; then
    fail "stock onboarding framework hash or slice UUID does not match the reviewed contract"
fi
for architecture in arm64 x86_64; do
    /usr/bin/otool -arch "$architecture" -L "$source_executable" > "$test_dir/stock-main-libraries-$architecture.txt"
    onboarding_framework_load_count="$(/usr/bin/grep -F -c "$onboarding_framework_load_path" "$test_dir/stock-main-libraries-$architecture.txt" || true)"
    if [[ "$onboarding_framework_load_count" != "1" ]]; then
        fail "stock main executable does not directly load exactly one reviewed onboarding framework in $architecture"
    fi
done
for forbidden in \
    'NSSelectorFromString' \
    'performSelector' \
    'objc_msgSend' \
    'valueForKey:' \
    'setValue:forKey:' \
    'dlopen' \
    'dlsym' \
    'NSTask' \
    '\bsocket[[:space:]]*\(' \
    '\bbind[[:space:]]*\(' \
    '\blisten[[:space:]]*\(' \
    '\baccept[[:space:]]*\(' \
    'NSURLSession' \
    'CFNetwork' \
    'WKWebView' \
    'ScreenCaptureKit' \
    'CGWindowList' \
    'sendAction:' \
    'FCPXML' \
    'NSUserDefaults' \
    'objc_getClassList' \
    'class_copyMethodList' \
    'NSClassFromString' \
    'method_exchangeImplementations' \
    'method_setImplementation' \
    'strstr' \
    'Sentry' \
    'telemetry' \
    '\bLua\b' \
    '\bPython\b' \
    'breakpoint' \
    'automation' \
    'swizzle'; do
    require_absent "$forbidden" "$runtime_source"
done

for required_identifier in \
    'native.targeted_rotate_zoom' \
    'look.old_television' \
    'transition.natural_dissolve' \
    'motion.living_still'; do
    require_fragment "$required_identifier" "$runtime_implementation" "runtime"
done
if [[ "$("$rg_bin" -o '(native\.targeted_rotate_zoom|look\.old_television|transition\.natural_dissolve|motion\.living_still)' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "4" ]]; then
    fail "fixed effect identifier domain is not exactly four values"
fi
require_fragment '[self.applyButton setEnabled:NO];' "$runtime_implementation" "runtime"
if "$rg_bin" -F 'setEnabled:YES' "$runtime_implementation" >/dev/null; then
    fail "panel code can enable a mutation control"
fi
if [[ "$("$rg_bin" -F -o 'return FCPCCMutationResult.unsupportedUnverified;' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" -lt 2 ]]; then
    fail "mutation stubs do not fail closed"
fi
for manifest_field in canonical_path expected_device expected_inode persistent_uid; do
    require_fragment "$manifest_field" "$repo_dir/config/fcpcommandconsole-library-manifest.json" "library manifest"
done

if "$rg_bin" -n -i -F 'defaults' "$runtime_source" >/dev/null; then
    fail "runtime invokes or names defaults"
fi
for forbidden_preference_surface in \
    'CFPreferences' \
    'CloudContentFirstLaunchCompleted' \
    'FFCloudContentDisabled' \
    'kCFPreferencesCurrentApplication'; do
    if "$rg_bin" -F -q "$forbidden_preference_surface" "$runtime_implementation"; then
        fail "runtime retains a shared Final Cut preference surface: $forbidden_preference_surface"
    fi
done
if ! "$rg_bin" -F -q 'FCPCCExpectedHostBundleIdentifier = @"com.apple.FinalCut"' "$runtime_implementation" || ! "$rg_bin" -F -q 'FCPCCExpectedCopiedHostBundlePath' "$runtime_implementation"; then
    fail "runtime does not require the receipt-compatible identifier and exact copied path"
fi

for required_runtime_fragment in \
    'FCPCCExpectedOnboardingFrameworkRelativeExecutablePath' \
    'FCPCCExpectedOnboardingCoordinatorClassName' \
    'FCPCCExpectedOnboardingQuerySetterName' \
    'FCPCCExpectedOnboardingQuerySetterTypeEncoding' \
    'FCPCCExpectedMASReceiptRelativePath' \
    'FCPCCExpectedMASReceiptSHA256' \
    '636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce' \
    'FCPCCExpectedOnboardingFrameworkArm64UUID' \
    'FCPCCExpectedOnboardingFrameworkX86_64UUID' \
    '0x1313c' \
    '0x13cc0' \
    'FCPCCLoadedMachOImageHasExpectedUUID' \
    'FCPCCFileSHA256MatchesExpectedHex' \
    'FCPCCCopiedHostImageUUIDMatches' \
    'FCPCCOnboardingFrameworkIdentityForImplementation' \
    'FCPCCOnboardingDemoProjectInfoCompletion' \
    'FCPCCOnboardingQueryDemoProjectInfoProvider' \
    'FCPCCOnboardingQueryDemoProjectInfoSetter' \
    'FCPCCVerifiedOnboardingQueryDemoProjectInfoSetter' \
    'FCPCCCompleteOnboardingDemoProjectInfoAsyncWithNil' \
    'FCPCCForwardOnboardingQueryDemoProjectInfoSetterWithAsyncNilMetadata' \
    'FCPCCInstallOnboardingQueryCompatibility'; do
    require_fragment "$required_runtime_fragment" "$runtime_implementation" "runtime exact onboarding compatibility"
done
host_identity_source="$(/usr/bin/sed -n '/static BOOL FCPCCCopiedHostImageUUIDMatches/,/^}/p' "$runtime_implementation")"
for required_host_identity_fragment in \
    '_dyld_get_image_name(0)' \
    '_dyld_get_image_header(0)' \
    'FCPCCExpectedCurrentArchitectureHostUUID()' \
    'FCPCCExpectedCopiedHostBundlePath' \
    'Contents/MacOS/Final Cut Pro' \
    'FCPCCLoadedMachOImageHasExpectedUUID'; do
    if ! print -r -- "$host_identity_source" | "$rg_bin" -F -q "$required_host_identity_fragment"; then
        fail "runtime copied-host identity check is missing: $required_host_identity_fragment"
    fi
done
containment_gate_source="$(/usr/bin/sed -n '/static BOOL FCPCCCopiedHostMASReceiptMatches/,/@end/p' "$runtime_implementation")"
for required_containment_gate_fragment in \
    'NSBundle.mainBundle.bundlePath' \
    'FCPCCExpectedCopiedHostBundlePath' \
    'FCPCCExpectedMASReceiptRelativePath' \
    'FCPCCFileSHA256MatchesExpectedHex(receiptPath, FCPCCExpectedMASReceiptSHA256)' \
    'exactCopiedHostPath' \
    'exactRuntimePath' \
    'FCPCCCopiedHostMASReceiptMatches()'; do
    if ! print -r -- "$containment_gate_source" | "$rg_bin" -F -q "$required_containment_gate_fragment"; then
        fail "runtime copied-host containment check is missing: $required_containment_gate_fragment"
    fi
done
framework_identity_source="$(/usr/bin/sed -n '/static FCPCCOnboardingFrameworkIdentityDisposition FCPCCOnboardingFrameworkIdentityForImplementation/,/^}/p' "$runtime_implementation")"
for required_framework_identity_fragment in \
    'dladdr((const void *)implementation, &image)' \
    'FCPCCExpectedOnboardingFrameworkExecutablePath()' \
    'FCPCCFileSHA256MatchesExpectedHex(loadedPath, FCPCCExpectedOnboardingFrameworkSHA256)' \
    'FCPCCExpectedCurrentArchitectureOnboardingFrameworkUUID()' \
    'FCPCCLoadedMachOImageHasExpectedUUID' \
    'FCPCCExpectedCurrentArchitectureOnboardingQuerySetterOffset()' \
    'actualOffset != expectedOffset'; do
    if ! print -r -- "$framework_identity_source" | "$rg_bin" -F -q "$required_framework_identity_fragment"; then
        fail "runtime onboarding framework identity check is missing: $required_framework_identity_fragment"
    fi
done
runtime_constructor_source="$(/usr/bin/sed -n '/__attribute__((constructor))/,/^}/p' "$runtime_implementation")"
if print -r -- "$runtime_constructor_source" | "$rg_bin" -F -q 'showPanel:' || print -r -- "$runtime_constructor_source" | "$rg_bin" -F -q 'showWindow:' || print -r -- "$runtime_constructor_source" | "$rg_bin" -F -q 'makeKeyAndOrderFront:'; then
    fail "runtime constructor auto-shows the panel"
fi
compatibility_install_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F '(void)FCPCCInstallOnboardingQueryCompatibility();' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
menu_enqueue_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F '[[FCPCCRuntime sharedRuntime] installMenuWhenReady];' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
constructor_containment_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F 'FCPCCRuntimeContainmentGate alloc' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
constructor_reject_line="$(print -r -- "$runtime_constructor_source" | "$rg_bin" -n -F 'if (!containment.isVerified)' | /usr/bin/head -n 1 | /usr/bin/cut -d: -f1)"
if [[ -z "$constructor_containment_line" || -z "$constructor_reject_line" || -z "$compatibility_install_line" || -z "$menu_enqueue_line" || "$constructor_containment_line" -ge "$constructor_reject_line" || "$constructor_reject_line" -ge "$compatibility_install_line" || "$compatibility_install_line" -ge "$menu_enqueue_line" ]]; then
    fail "exact copied-host containment does not precede the compatibility bridge and menu scheduling"
fi
query_compatibility_source="$(/usr/bin/sed -n '/static NSString \*FCPCCInstallOnboardingQueryCompatibility/,/^}/p' "$runtime_implementation")"
for required_query_compatibility_fragment in \
    'dispatch_once(&onceToken, ^{' \
    'FCPCCRuntimeContainmentGate alloc' \
    'FCPCCCopiedHostImageUUIDMatches()' \
    'objc_getClass(FCPCCExpectedOnboardingCoordinatorClassName.UTF8String)' \
    'sel_registerName(FCPCCExpectedOnboardingQuerySetterName.UTF8String)' \
    'class_getInstanceMethod(targetClass, selector)' \
    'class_getClassMethod(targetClass, selector)' \
    'method_getNumberOfArguments(method) != 3' \
    'method_copyReturnType(method)' \
    'method_getTypeEncoding(method)' \
    'method_getImplementation(method)' \
    'FCPCCOnboardingFrameworkIdentityForImplementation(originalImplementation)' \
    'FCPCCVerifiedOnboardingQueryDemoProjectInfoSetter = (FCPCCOnboardingQueryDemoProjectInfoSetter)originalImplementation;' \
    'class_replaceMethod(targetClass,' \
    'FCPCCForwardOnboardingQueryDemoProjectInfoSetterWithAsyncNilMetadata' \
    'onboarding_query_compatibility=installed'; do
    if ! print -r -- "$query_compatibility_source" | "$rg_bin" -F -q "$required_query_compatibility_fragment"; then
        fail "runtime single onboarding query compatibility is missing: $required_query_compatibility_fragment"
    fi
done
if print -r -- "$query_compatibility_source" | "$rg_bin" -F -q 'dispatch_async' || print -r -- "$query_compatibility_source" | "$rg_bin" -F -q 'NSApplicationWillFinishLaunchingNotification'; then
    fail "onboarding query compatibility contains a delayed or launch-notification retry"
fi
if [[ "$(print -r -- "$query_compatibility_source" | "$rg_bin" -F -o 'class_replaceMethod' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$(print -r -- "$query_compatibility_source" | "$rg_bin" -F -o 'objc_getClass(' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$(print -r -- "$query_compatibility_source" | "$rg_bin" -F -o 'sel_registerName(' | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "onboarding query compatibility is not limited to one exact replacement path"
fi
query_completion_source="$(/usr/bin/sed -n '/static void FCPCCCompleteOnboardingDemoProjectInfoAsyncWithNil/,/^}/p' "$runtime_implementation")"
if ! print -r -- "$query_completion_source" | "$rg_bin" -F -q 'dispatch_async(dispatch_get_main_queue(), ^{' || ! print -r -- "$query_completion_source" | "$rg_bin" -F -q 'completion(nil);' || print -r -- "$query_completion_source" | "$rg_bin" -F -q 'NSError' || print -r -- "$query_completion_source" | "$rg_bin" -F -q 'CloudContent'; then
    fail "query completion does not remain the reviewed asynchronous nil-metadata path"
fi
query_setter_wrapper_source="$(/usr/bin/sed -n '/static void FCPCCForwardOnboardingQueryDemoProjectInfoSetterWithAsyncNilMetadata/,/^}/p' "$runtime_implementation")"
if ! print -r -- "$query_setter_wrapper_source" | "$rg_bin" -F -q '(void)queryDemoProjectInfo;' || ! print -r -- "$query_setter_wrapper_source" | "$rg_bin" -F -q 'FCPCCVerifiedOnboardingQueryDemoProjectInfoSetter' || ! print -r -- "$query_setter_wrapper_source" | "$rg_bin" -F -q 'originalSetter(self, command, nilMetadataProvider);'; then
    fail "query compatibility wrapper does not retain and invoke the verified original setter"
fi
if "$rg_bin" -n -i -F 'FCPCCDiscardOnboardingQueryDemoProjectInfo' "$runtime_implementation" >/dev/null || "$rg_bin" -n -i -F 'discard_query_block_noop' "$runtime_implementation" "$runtime_policy_source" >/dev/null; then
    fail "retired query-discard behavior remains reachable"
fi
for forbidden_runtime_surface in \
    'FCPCCCloudContentCompatibilityEntry' \
    'FCPCCInstallCloudContentCompatibilityEntry' \
    'FCPCCAttemptIsolatedCloudContentMethodCompatibility' \
    'FCPCCCloudContentAttemptPhase' \
    'DemoProjectDownloadHelper' \
    'CloudContentCatalog' \
    'CloudContentFeatureFlag' \
    'CCFirstLaunchHelper' \
    'fetchDefaultDemoProjectWithCompletionHandler:' \
    'isCloudContentEnabled' \
    'isRunningSubscriptionApp' \
    'startListeningForApplicationDidBecomeActiveNotifications' \
    'shouldShowFirstLaunchExperience' \
    'setupAndPresentFirstLaunchIfNeededWithCompletionHandler:' \
    'NSApplicationWillFinishLaunchingNotification' \
    'main_queue_once' \
    'will_finish_launching_once' \
    'dispatch_after' \
    'NSTimer' \
    'performSelector:afterDelay:' \
    '@try' \
    'os_log'; do
    if "$rg_bin" -F -q "$forbidden_runtime_surface" "$runtime_implementation"; then
        fail "runtime retains a forbidden retired scheduler or broad replacement surface: $forbidden_runtime_surface"
    fi
done

/usr/bin/plutil -lint "$runtime_policy_source" >/dev/null
/usr/bin/plutil -lint "$runtime_policy_build" >/dev/null
if [[ -e "$retired_runtime_policy_source" || -e "$retired_runtime_policy_build" ]]; then
    fail "retired isolated preference policy remains present"
fi
for policy_path in "$runtime_policy_source" "$runtime_policy_build"; do
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :SchemaVersion' "$policy_path")" != "6" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBundleIdentifier' "$policy_path")" != "com.apple.FinalCut" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedCopiedHostBundlePath' "$policy_path")" != "/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostVersion' "$policy_path")" != "12.3" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostBuild' "$policy_path")" != "450152" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedStockPreInjectionHostExecutableSHA256' "$policy_path")" != "6d29cb4326c2f35c96fbc57f29741fba8b5156265e188b19c975bc6cefba8390" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostArm64UUID' "$policy_path")" != "AD024067-E145-3988-AFF9-BD33391C416D" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedHostX86_64UUID' "$policy_path")" != "2ACCBD11-6965-3D09-BD87-9A900FDC740E" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptRelativePath' "$policy_path")" != "$mas_receipt_relative_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedMASReceiptSHA256' "$policy_path")" != "$expected_mas_receipt_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkRelativeExecutablePath' "$policy_path")" != "$onboarding_framework_relative_executable_path" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkSHA256' "$policy_path")" != "$expected_onboarding_framework_sha256" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkArm64UUID' "$policy_path")" != "$expected_onboarding_framework_arm64_uuid" || "$(/usr/libexec/PlistBuddy -c 'Print :ExpectedOnboardingFrameworkX86_64UUID' "$policy_path")" != "$expected_onboarding_framework_x86_64_uuid" ]]; then
        fail "compatibility policy copied-host, receipt, or onboarding identity is not exact"
    fi
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ImmutableCompileTimeAllowlist' "$policy_path")" != "true" || "$(/usr/libexec/PlistBuddy -c 'Print :RuntimeDiscoveryAllowed' "$policy_path")" != "false" || "$(/usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$policy_path")" != "constructor" || "$(/usr/libexec/PlistBuddy -c 'Print :MaximumMethodGuardAttempts' "$policy_path")" != "1" ]]; then
        fail "compatibility policy single constructor gate mode is not exact"
    fi
    for removed_policy_key in CompatibilityInstallPhases MethodGuardLogSubsystem MethodGuardLogCategory PreferenceDomain ApprovedPreferenceKeys ApprovedPreferenceValues SynchronizeDeterministically; do
        if /usr/libexec/PlistBuddy -c "Print :$removed_policy_key" "$policy_path" >/dev/null 2>&1; then
            fail "compatibility policy retains an obsolete scheduler, logger, or preference key"
        fi
    done
    if [[ "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:RuntimeClass' "$policy_path")" != "POFDesktopOnboardingCoordinator" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Selector' "$policy_path")" != "setQueryDemoProjectInfo:" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:MethodKind' "$policy_path")" != "instance" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCArgumentCount' "$policy_path")" != "3" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCReturnType' "$policy_path")" != "v" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ObjectiveCTypeEncoding' "$policy_path")" != "v24@0:8@?16" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64' "$policy_path")" != "0x1313c" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64' "$policy_path")" != "0x13cc0" || "$(/usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:0:Replacement' "$policy_path")" != "forward_original_setter_async_nil_metadata_provider" ]]; then
        fail "compatibility policy single onboarding query setter contract is not exact"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1' "$policy_path" >/dev/null 2>&1; then
        fail "compatibility policy permits an extra method replacement"
    fi
done
if ! /usr/bin/cmp -s "$runtime_policy_source" "$runtime_policy_build"; then
    fail "built compatibility policy differs from the project-owned source policy"
fi

/usr/bin/strings "$runtime_build" > "$test_dir/runtime-binary-strings.txt"
for required_runtime_binary_string in \
    'com.apple.FinalCut' \
    '/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app' \
    '12.3' \
    '450152' \
    'Contents/_MASReceipt/receipt' \
    '2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e' \
    'Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne' \
    'POFDesktopOnboardingCoordinator' \
    'setQueryDemoProjectInfo:' \
    'v24@0:8@?16' \
    '636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce' \
    'onboarding_query_compatibility=installed'; do
    if ! /usr/bin/grep -F -x -q "$required_runtime_binary_string" "$test_dir/runtime-binary-strings.txt"; then
        fail "built runtime is missing required exact binary string: $required_runtime_binary_string"
    fi
done
for retired_runtime_binary_string in \
    'com.local.fcpcommandconsole.FinalCut' \
    'CloudContentFirstLaunchCompleted' \
    'FFCloudContentDisabled' \
    'onboarding_query_gate=installed' \
    'discard_query_block_noop'; do
    if /usr/bin/grep -F -x -q "$retired_runtime_binary_string" "$test_dir/runtime-binary-strings.txt"; then
        fail "built runtime retains retired compatibility binary string: $retired_runtime_binary_string"
    fi
done

for patcher_script in "$initial_patcher" "$runtime_updater" "$runtime_verifier" "$repair_patcher"; do

#!/bin/zsh
# Offline audits for the minimal runtime and isolated-copy patcher.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd)"
plugin_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$plugin_dir")"
runtime_source="$plugin_dir/splicekit_minimal/Sources"
runtime_header="$runtime_source/FCPCommandConsoleRuntime.h"
runtime_implementation="$runtime_source/FCPCommandConsoleRuntime.m"
runtime_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
runtime_policy_source="$plugin_dir/splicekit_minimal/Resources/FCPCCOnboardingQueryCompatibility.plist"
runtime_policy_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
cloud_first_launch_encoding_probe_source="$plugin_dir/tests/CloudFirstLaunchEncodingProbe.m"
retired_runtime_policy_source="$plugin_dir/splicekit_minimal/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
retired_runtime_policy_build="$plugin_dir/build/FCPCommandConsoleRuntime.framework/Versions/A/Resources/FCPCCIsolatedCloudContentCompatibility.plist"
injector="$plugin_dir/build/fcpcc-insert-dylib"
entitlement_verifier="$plugin_dir/build/fcpcc-entitlement-verify"
runtime_updater="$plugin_dir/patcher/update-copied-runtime"
runtime_verifier="$plugin_dir/patcher/verify-copied-fcp"
initial_patcher="$plugin_dir/patcher/patch-copied-fcp"
repair_patcher="$plugin_dir/patcher/repair-library-validation-entitlement"
allowlist="$repo_dir/config/patch-entitlement-allowlist.json"
reviewed_copied_app="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app"
reviewed_copied_executable="$reviewed_copied_app/Contents/MacOS/Final Cut Pro"
onboarding_framework_relative_executable_path="Contents/Frameworks/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
reviewed_copied_onboarding_framework="$reviewed_copied_app/$onboarding_framework_relative_executable_path"
flexo_framework_relative_executable_path="Contents/Frameworks/Flexo.framework/Versions/A/Flexo"
reviewed_copied_flexo_framework="$reviewed_copied_app/$flexo_framework_relative_executable_path"
mas_receipt_relative_path="Contents/_MASReceipt/receipt"
reviewed_copied_mas_receipt="$reviewed_copied_app/$mas_receipt_relative_path"
onboarding_framework_load_path="@rpath/ProOnboardingFlowModelOne.framework/Versions/A/ProOnboardingFlowModelOne"
expected_onboarding_framework_sha256="636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce"
expected_onboarding_framework_arm64_uuid="45D8AC9D-D544-3CD1-90DB-532DFAAA0E0D"
expected_onboarding_framework_x86_64_uuid="FCAA9A11-C6A5-3EC9-9E65-ADCA14F086F7"
expected_mas_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
test_dir="$(/bin/realpath "$(/usr/bin/mktemp -d /tmp/fcpcc-offline-tests.XXXXXX)")"
load_path="@rpath/FCPCommandConsoleRuntime.framework/Versions/A/FCPCommandConsoleRuntime"
rg_bin="$(command -v rg || true)"

fail() {
    print -u2 -r -- "run-offline-tests: $1"
    exit 1
}

require_absent() {
    local expression="$1"
    local scope="$2"
    if "$rg_bin" -n -i --glob '*.[mh]' "$expression" "$scope" >/dev/null; then
        fail "forbidden runtime surface matched: $expression"
    fi
}

require_fragment() {
    local fragment="$1"
    local path="$2"
    local label="$3"
    if ! "$rg_bin" -F -q -- "$fragment" "$path"; then
        fail "$label is missing required fragment: $fragment"
    fi
}

if [[ ! -x "$injector" || ! -x "$entitlement_verifier" || ! -f "$runtime_build" || ! -f "$runtime_policy_source" || ! -f "$runtime_policy_build" ]]; then
    fail "run plugin/scripts/build-minimal-runtime successfully before tests"
fi
if [[ -z "$rg_bin" ]]; then
    fail "rg is required for source audits"
fi
if [[ ! -d "$reviewed_copied_app" || ! -f "$reviewed_copied_executable" || ! -f "$reviewed_copied_onboarding_framework" || ! -f "$reviewed_copied_flexo_framework" || ! -f "$reviewed_copied_mas_receipt" ]]; then
    fail "reviewed copied FCP 12.3 artifact or its pinned framework is missing"
fi
if [[ ! -f "$cloud_first_launch_encoding_probe_source" ]]; then
    fail "Cloud first-launch encoding regression probe is missing"
fi

# The automatic Cloud Content first-launch route is pinned from the exact
# reviewed copied Final Cut Pro 12.3 executable. These are static inspections
# only; the current stock app is deliberately not an input to this test.
/usr/bin/otool -arch arm64 -o -v "$reviewed_copied_executable" > "$test_dir/fcp-12-3-cloud-first-launch-objc-arm64.txt"
/usr/bin/otool -arch x86_64 -o -v "$reviewed_copied_executable" > "$test_dir/fcp-12-3-cloud-first-launch-objc-x86_64.txt"
/usr/bin/otool -arch arm64 -tvV "$reviewed_copied_executable" > "$test_dir/fcp-12-3-cloud-first-launch-disassembly-arm64.txt"
/usr/bin/otool -arch x86_64 -tvV "$reviewed_copied_executable" > "$test_dir/fcp-12-3-cloud-first-launch-disassembly-x86_64.txt"
/usr/bin/otool -arch x86_64 -s __DATA __objc_selrefs "$reviewed_copied_executable" > "$test_dir/fcp-12-3-cloud-first-launch-selrefs-x86_64.txt"
for arm64_metadata_fragment in \
    'CCFirstLaunchHelper' \
    '__INSTANCE_METHODS_CCFirstLaunchHelper' \
    'v24@0:8@?<v@?@"NSError">16' \
    'imp     0xfff9de5c (0x1000924e8)'; do
    if ! "$rg_bin" -F -q -- "$arm64_metadata_fragment" "$test_dir/fcp-12-3-cloud-first-launch-objc-arm64.txt"; then
        fail "installed Final Cut Pro 12.3 arm64 first-launch metadata drifted: $arm64_metadata_fragment"
    fi
done
for x86_64_metadata_fragment in \
    'CCFirstLaunchHelper' \
    '__INSTANCE_METHODS_CCFirstLaunchHelper' \
    'v24@0:8@?<v@?@"NSError">16' \
    'imp     0x1000c74c0'; do
    if ! "$rg_bin" -F -q -- "$x86_64_metadata_fragment" "$test_dir/fcp-12-3-cloud-first-launch-objc-x86_64.txt"; then
        fail "installed Final Cut Pro 12.3 x86_64 first-launch metadata drifted: $x86_64_metadata_fragment"
    fi
done
if [[ "$("$rg_bin" -F -o '__INSTANCE_METHODS_CCFirstLaunchHelper' "$test_dir/fcp-12-3-cloud-first-launch-objc-arm64.txt" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o '__INSTANCE_METHODS_CCFirstLaunchHelper' "$test_dir/fcp-12-3-cloud-first-launch-objc-x86_64.txt" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "installed Final Cut Pro 12.3 Cloud first-launch metadata is not pinned to one instance-method list per slice"
fi
for arm64_route_fragment in \
    '-[PEAppController presentMainWindowOnAppLaunch:]:' \
    '000000010003b648' \
    '"_objc_msgSend$setupAndPresentFirstLaunchIfNeededWithCompletionHandler:"' \
    '000000010003b64c' \
    '___48-[PEAppController presentMainWindowOnAppLaunch:]_block_invoke:' \
    '000000010003c32c' \
    '_objc_msgSend$startListeningForApplicationDidBecomeActiveNotifications'; do
    if ! "$rg_bin" -F -q -- "$arm64_route_fragment" "$test_dir/fcp-12-3-cloud-first-launch-disassembly-arm64.txt"; then
        fail "installed Final Cut Pro 12.3 arm64 first-launch route drifted: $arm64_route_fragment"
    fi
done
for x86_64_route_fragment in \
    '-[PEAppController presentMainWindowOnAppLaunch:]:' \
    '000000010004f19c' \
    '0x15d8e5(%rip)' \
    '000000010004f1ad' \
    '000000010004f1b0' \
    '___48-[PEAppController presentMainWindowOnAppLaunch:]_block_invoke:' \
    '00000001000503c8' \
    '0x10e80a(%rip)'; do
    if ! "$rg_bin" -F -q -- "$x86_64_route_fragment" "$test_dir/fcp-12-3-cloud-first-launch-disassembly-x86_64.txt"; then
        fail "installed Final Cut Pro 12.3 x86_64 first-launch route drifted: $x86_64_route_fragment"
    fi
done
for x86_64_selector_fragment in \
    '00000001001aca78' \
    '75 b3 12 00 00 00 10 00 66 52 13 00 00 00 10 00' \
    '00000001001aca88' \
    'c2 39 13 00 00 00 10 00 de 84 11 00 00 00 10 00'; do
    if ! "$rg_bin" -F -q -- "$x86_64_selector_fragment" "$test_dir/fcp-12-3-cloud-first-launch-selrefs-x86_64.txt"; then
        fail "installed Final Cut Pro 12.3 x86_64 first-launch selector reference drifted: $x86_64_selector_fragment"
    fi
done
if [[ "$("$rg_bin" -F -o '_objc_msgSend$startListeningForApplicationDidBecomeActiveNotifications' "$test_dir/fcp-12-3-cloud-first-launch-disassembly-arm64.txt" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" || "$("$rg_bin" -F -o '00000001000503c8' "$test_dir/fcp-12-3-cloud-first-launch-disassembly-x86_64.txt" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "1" ]]; then
    fail "installed Final Cut Pro 12.3 first-launch completion has more than one automatic listener route"
fi

/usr/bin/otool -arch arm64 -o -v "$reviewed_copied_flexo_framework" > "$test_dir/fcp-12-3-flexo-objc-arm64.txt"
for installed_flexo_fragment in \
    'v64@0:8{?=qiIq}16^d40^d48^d56' \
    'v68@0:8{?=qiIq}16d40d48d56I64' \
    '0x3e6a10) -[FFHeXForm3DEffect getPixelPositionAtTime:x:y:z:]' \
    '0x3e6a84) -[FFHeXForm3DEffect getRotationAtTime:x:y:z:]' \
    '0x3e6ac0) -[FFHeXForm3DEffect getScaleAtTime:x:y:z:]' \
    '0x3e6c2c) -[FFHeXForm3DEffect setPixelPositionAtTime:curveX:curveY:curveZ:options:]' \
    '0x3e6ce8) -[FFHeXForm3DEffect setRotationAtTime:curveX:curveY:curveZ:options:]' \
    '0x3e6d24) -[FFHeXForm3DEffect setScaleAtTime:curveX:curveY:curveZ:options:]' \
    '0x156684) -[FFEffectStack actionBegin:animationHint:deferUpdates:]' \
    '0x1566c0) -[FFEffectStack actionEnd:save:error:]' \
    '0x32cdc4) -[FFUndoHandler undoableBegin:]' \
    '0x32cf84) -[FFUndoHandler undoableEnd:save:error:]'; do
    if ! "$rg_bin" -F -q "$installed_flexo_fragment" "$test_dir/fcp-12-3-flexo-objc-arm64.txt"; then
        fail "installed Final Cut Pro 12.3 Flexo metadata drifted: $installed_flexo_fragment"
    fi
done

reviewed_copied_main_before="$(/usr/bin/shasum -a 256 "$reviewed_copied_executable" | /usr/bin/awk '{print $1}')"
reviewed_copied_info_before="$(/usr/bin/shasum -a 256 "$reviewed_copied_app/Contents/Info.plist" | /usr/bin/awk '{print $1}')"
reviewed_copied_onboarding_before="$(/usr/bin/shasum -a 256 "$reviewed_copied_onboarding_framework" | /usr/bin/awk '{print $1}')"
/usr/bin/dwarfdump --uuid "$reviewed_copied_onboarding_framework" > "$test_dir/reviewed-copied-onboarding-framework.uuids.txt"
reviewed_copied_onboarding_arm64_uuid="$(/usr/bin/awk '/\(arm64\)/ {print $2; exit}' "$test_dir/reviewed-copied-onboarding-framework.uuids.txt")"
reviewed_copied_onboarding_x86_64_uuid="$(/usr/bin/awk '/\(x86_64\)/ {print $2; exit}' "$test_dir/reviewed-copied-onboarding-framework.uuids.txt")"
reviewed_copied_mas_receipt_before="$(/usr/bin/shasum -a 256 "$reviewed_copied_mas_receipt" | /usr/bin/awk '{print $1}')"
if [[ "$reviewed_copied_onboarding_before" != "$expected_onboarding_framework_sha256" || "$reviewed_copied_onboarding_arm64_uuid" != "$expected_onboarding_framework_arm64_uuid" || "$reviewed_copied_onboarding_x86_64_uuid" != "$expected_onboarding_framework_x86_64_uuid" || "$reviewed_copied_mas_receipt_before" != "$expected_mas_receipt_sha256" ]]; then
    fail "reviewed copied onboarding framework hash or slice UUID does not match the pinned contract"
fi
for architecture in arm64 x86_64; do
    /usr/bin/otool -arch "$architecture" -L "$reviewed_copied_executable" > "$test_dir/reviewed-copied-main-libraries-$architecture.txt"
    onboarding_framework_load_count="$(/usr/bin/grep -F -c "$onboarding_framework_load_path" "$test_dir/reviewed-copied-main-libraries-$architecture.txt" || true)"
    if [[ "$onboarding_framework_load_count" != "1" ]]; then
        fail "reviewed copied main executable does not directly load exactly one pinned onboarding framework in $architecture"
    fi
done
for forbidden in \
    'NSSelectorFromString' \
    'performSelector' \
    'objc_msgSend' \
    'valueForKey:' \
    'setValue:forKey:' \
    'dlopen' \
    'dlsym' \
    'NSTask' \
    '\bsocket[[:space:]]*\(' \
    '\bbind[[:space:]]*\(' \
    '\blisten[[:space:]]*\(' \
    '\baccept[[:space:]]*\(' \
    'NSURLSession' \
    'CFNetwork' \
    'WKWebView' \
    'ScreenCaptureKit' \
    'CGWindowList' \
    'sendAction:' \
    'FCPXML' \
    'NSUserDefaults' \
    'objc_getClassList' \
    'class_copyMethodList' \
    'NSClassFromString' \
    'method_exchangeImplementations' \
    'method_setImplementation' \
    'strstr' \
    'Sentry' \
    'telemetry' \
    '\bLua\b' \
    '\bPython\b' \
    'breakpoint' \
    'automation' \
    'swizzle'; do
    require_absent "$forbidden" "$runtime_source"
done

for required_identifier in \
    'native.targeted_rotate_zoom' \
    'look.old_television' \
    'transition.natural_dissolve' \
    'motion.living_still'; do
    require_fragment "$required_identifier" "$runtime_implementation" "runtime"
done
if [[ "$("$rg_bin" -o '(native\.targeted_rotate_zoom|look\.old_television|transition\.natural_dissolve|motion\.living_still)' "$runtime_implementation" | /usr/bin/wc -l | /usr/bin/tr -d ' ')" != "4" ]]; then
    fail "fixed effect identifier domain is not exactly four values"
fi
require_fragment '[self.applyButton setEnabled:NO];' "$runtime_implementation" "runtime"
if "$rg_bin" -F 'setEnabled:YES' "$runtime_implementation" >/dev/null; then
    fail "panel code can enable a mutation control"
fi
for required_mutation_fragment in \
    'FCPCCMutationPayload' \
    'FCPCCNativeTargetedRotateZoomTransaction' \
    'clipLocalTime' \
    'normalizedPosition' \
    'nativePixelPositionConversionVerified'; do
    require_fragment "$required_mutation_fragment" "$runtime_header" "typed mutation interface"
done
for required_mutation_fragment in \
    'unsupported_pending_live_contract_missing_exact_native_easing_and_native_undo_rollback_contracts' \
    'native_targeted_rotate_zoom_preview_plan_ready'; do
    require_fragment "$required_mutation_fragment" "$runtime_implementation" "typed mutation implementation"
done
for required_mutation_fragment in \
    'getPixelPositionAtTime:x:y:z:' \
    'getRotationAtTime:x:y:z:' \
    'getScaleAtTime:x:y:z:' \
    'setPixelPositionAtTime:curveX:curveY:curveZ:options:' \
    'setRotationAtTime:curveX:curveY:curveZ:options:' \
    'setScaleAtTime:curveX:curveY:curveZ:options:' \
    'v64@0:8{?=qiIq}16^d40^d48^d56' \
    'v68@0:8{?=qiIq}16d40d48d56I64' \
    '0x3e6a10' \
    '0x3e6a84' \
    '0x3e6ac0' \
    '0x3e6c2c' \
    '0x3e6ce8' \
    '0x3e6d24' \
    '0x156684' \
    '0x1566c0' \
    '0x32cdc4' \
    '0x32cf84'; do
    require_fragment "$required_mutation_fragment" "$runtime_implementation" "FCP 12.3 static mutation provenance"
done
for obsolete_mutation_selector in \
    'getPixelPosition:atTime:options:' \
    'getRotation:atTime:options:' \
    'getScale:atTime:options:' \
    'setPixelPosition:atTime:options:' \
    'setRotation:atTime:options:' \
    'setScale:atTime:options:'; do
    if "$rg_bin" -F -q "$obsolete_mutation_selector" "$runtime_implementation"; then
        fail "mutation provenance retains an upstream spelling rather than installed FCP 12.3 metadata: $obsolete_mutation_selector"
    fi
done
if "$rg_bin" -F -q 'NSDictionary<NSString *, id> *beforeState' "$runtime_header" || "$rg_bin" -F -q 'NSDictionary<NSString *, id> *afterState' "$runtime_header"; then
    fail "mutation interface still accepts arbitrary dictionary state"
fi
mutation_controller_source="$(/usr/bin/sed -n '/@implementation FCPCCMutationController/,/^@end$/p' "$runtime_implementation")"
for forbidden_mutation_controller_fragment in \
    'FCPCCResolveFixedMethod' \
    'FCPCCReceiverUsesValidatedMethod' \
    'objc_getClass' \
    'sel_registerName' \
    'class_getInstanceMethod' \
    'FCPCCObjectGetter' \
    'FCPCCCMTimeGetter' \
    'FCPCCSelectedItemsGetter'; do
    if print -r -- "$mutation_controller_source" | "$rg_bin" -F -q "$forbidden_mutation_controller_fragment"; then
        fail "plan/apply resolves a private class, selector, or model method: $forbidden_mutation_controller_fragment"
    fi
done
for required_mutation_controller_fragment in \
    '[self planTransaction:transaction]' \
    'FCPCCReadOnlyHostGatePasses(&hostReason)' \
    'applyTransaction:(FCPCCNativeTargetedRotateZoomTransaction *)transaction' \
    'nativeMutationPerformed:NO'; do
    if ! print -r -- "$mutation_controller_source" | "$rg_bin" -F -q "$required_mutation_controller_fragment"; then
        fail "typed mutation controller is missing its fail-closed barrier: $required_mutation_controller_fragment"
    fi
done
native_targeted_adapter_source="$(/usr/bin/sed -n '/@implementation FCPCCNativeTargetedRotateZoomAdapter/,/^@end$/p' "$runtime_implementation")"
for required_native_targeted_adapter_fragment in \
    'enumerateCompleteOpenLibrarySet' \
    'captureContextForVerifiedLibraryInvariant:' \
    'FCPCCNativeTargetedRotateZoomRecaptureMatchesTransaction' \
    'FCPCCNativeMutationLiveContractProven(&liveContractReason)' \
    'FCPCCMutationDispositionUnsupportedPendingLiveContract' \
    'nativeMutationPerformed:NO'; do
    if ! print -r -- "$native_targeted_adapter_source" | "$rg_bin" -F -q "$required_native_targeted_adapter_fragment"; then
        fail "native targeted adapter is missing its immediate recapture or fail-closed barrier: $required_native_targeted_adapter_fragment"
    fi
done
panel_apply_source="$(/usr/bin/sed -n '/- (void)apply:(id)sender {/,/- (void)undo:/p' "$runtime_implementation")"
if ! print -r -- "$panel_apply_source" | "$rg_bin" -F -q 'unavailableWithoutPanelBinding'; then
    fail "disabled panel apply path does not return an explicit unavailable result"
fi
for forbidden_panel_apply_fragment in \
    'FCPCCNativeTargetedRotateZoomRequest' \
    'FCPCCNativeTargetedRotateZoomTransaction' \
    'FCPCCFixedModelTraversalAdapter' \
    'initWithNormalizedTargetPoint' \
    'CMTimeMake' \
    '1.2'; do
    if print -r -- "$panel_apply_source" | "$rg_bin" -F -q "$forbidden_panel_apply_fragment"; then
        fail "disabled panel fabricates a native request: $forbidden_panel_apply_fragment"
    fi
done
for manifest_field in canonical_path expected_device expected_inode persistent_uid; do
    require_fragment "$manifest_field" "$repo_dir/config/fcpcommandconsole-library-manifest.json" "library manifest"
done

if "$rg_bin" -n -i -F 'defaults' "$runtime_source" >/dev/null; then
    fail "runtime invokes or names defaults"
fi
for forbidden_preference_surface in \
    'CFPreferences' \
    'CloudContentFirstLaunchCompleted' \
    'FFCloudContentDisabled' \
    'kCFPreferencesCurrentApplication'; do
    if "$rg_bin" -F -q "$forbidden_preference_surface" "$runtime_implementation"; then
        fail "runtime retains a shared Final Cut preference surface: $forbidden_preference_surface"
    fi
done
if ! "$rg_bin" -F -q 'FCPCCExpectedHostBundleIdentifier = @"com.apple.FinalCut"' "$runtime_implementation" || ! "$rg_bin" -F -q 'FCPCCExpectedCopiedHostBundlePath' "$runtime_implementation"; then
    fail "runtime does not require the receipt-compatible identifier and exact copied path"
fi

for required_runtime_fragment in \
    'FCPCCExpectedOnboardingFrameworkRelativeExecutablePath' \
    'FCPCCExpectedOnboardingCoordinatorClassName' \
    'FCPCCExpectedOnboardingQuerySetterName' \
    'FCPCCExpectedOnboardingQuerySetterTypeEncoding' \
    'FCPCCExpectedMASReceiptRelativePath' \
    'FCPCCExpectedMASReceiptSHA256' \
    '636cc140036217ab1f39d998ac53faaf2dd8682c091f3c041dbde594d1f2dfce' \
    'FCPCCExpectedOnboardingFrameworkArm64UUID' \
    'FCPCCExpectedOnboardingFrameworkX86_64UUID' \
    '0x1313c' \
    '0x13cc0' \
    'FCPCCLoadedMachOImageHasExpectedUUID' \
    'FCPCCFileSHA256MatchesExpectedHex' \
    'FCPCCCopiedHostImageUUIDMatches' \
    'FCPCCOnboardingFrameworkIdentityForImplementation' \
    'FCPCCOnboardingDemoProjectInfoCompletion' \
    'FCPCCOnboardingQueryDemoProjectInfoProvider' \
    'FCPCCOnboardingQueryDemoProjectInfoSetter' \
    'FCPCCVerifiedOnboardingQueryDemoProjectInfoSetter' \
    'FCPCCCompleteOnboardingDemoProjectInfoAsyncWithNil' \
    'FCPCCForwardOnboardingQueryDemoProjectInfoSetterWithAsyncNilMetadata' \
    'FCPCCInstallOnboardingQueryCompatibility' \
    'FCPCCExpectedCloudFirstLaunchHelperClassName' \
    'FCPCCExpectedCloudFirstLaunchSetupSelectorName' \
    'FCPCCExpectedCloudFirstLaunchSetupTypeEncoding' \
    'FCPCCExpectedCurrentArchitectureCloudFirstLaunchSetupOffset' \
    '0x924e8' \
    '0xc74c0' \
    'FCPCCCopiedHostIdentityForImplementation' \
    'FCPCCSuppressCloudFirstLaunchRegistration' \
    'FCPCCAttemptCloudFirstLaunchRegistrationSuppression' \
    'FCPCCBeginCloudFirstLaunchRegistrationSuppression'; do
    require_fragment "$required_runtime_fragment" "$runtime_implementation" "runtime exact onboarding compatibility"
done
host_identity_source="$(/usr/bin/sed -n '/static BOOL FCPCCCopiedHostImageUUIDMatches/,/^}/p' "$runtime_implementation")"
for required_host_identity_fragment in \
    '_dyld_get_image_name(0)' \
    '_dyld_get_image_header(0)' \
    'FCPCCExpectedCurrentArchitectureHostUUID()' \
    'FCPCCExpectedCopiedHostBundlePath' \
    'Contents/MacOS/Final Cut Pro' \
    'FCPCCLoadedMachOImageHasExpectedUUID'; do
    if ! print -r -- "$host_identity_source" | "$rg_bin" -F -q "$required_host_identity_fragment"; then
        fail "runtime copied-host identity check is missing: $required_host_identity_fragment"
    fi
done
containment_gate_source="$(/usr/bin/sed -n '/static BOOL FCPCCCopiedHostMASReceiptMatches/,/@end/p' "$runtime_implementation")"
for required_containment_gate_fragment in \
    'NSBundle.mainBundle.bundlePath' \
    'FCPCCExpectedCopiedHostBundlePath' \
    'FCPCCExpectedMASReceiptRelativePath' \
    'FCPCCFileSHA256MatchesExpectedHex(receiptPath, FCPCCExpectedMASReceiptSHA256)' \
    'exactCopiedHostPath' \
    'exactRuntimePath' \
    'FCPCCCopiedHostMASReceiptMatches()'; do
    if ! print -r -- "$containment_gate_source" | "$rg_bin" -F -q "$required_containment_gate_fragment"; then
        fail "runtime copied-host containment check is missing: $required_containment_gate_fragment"
    fi
done
framework_identity_source="$(/usr/bin/sed -n '/static FCPCCOnboardingFrameworkIdentityDisposition FCPCCOnboardingFrameworkIdentityForImplementation/,/^}/p' "$runtime_implementation")"
for required_framework_identity_fragment in \
    'dladdr((const void *)implementation, &image)' \
    'FCPCCExpectedOnboardingFrameworkExecutablePath()' \
    'FCPCCFileSHA256MatchesExpectedHex(loadedPath, FCPCCExpectedOnboardingFrameworkSHA256)' \
    'FCPCCExpectedCurrentArchitectureOnboardingFrameworkUUID()' \
    'FCPCCLoadedMachOImageHasExpectedUUID' \
    'FCPCCExpectedCurrentArchitectureOnboardingQuerySetterOffset()' \
    'actualOffset != expectedOffset'; do
    if ! print -r -- "$framework_identity_source" | "$rg_bin" -F -q "$required_framework_identity_fragment"; then
        fail "runtime onboarding framework identity check is missing: $required_framework_identity_fragment"

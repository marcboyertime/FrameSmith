    'DisposableProjectResume:PublicLibraryOpenMaximumInvocations' \
    'DisposableProjectResume:PublicLibraryOpenNeverCreatesRemovesOrOverwritesLibrary' \
    'DisposableProjectResume:PublicLibraryOpenNoRetry' \
    'DisposableProjectResume:RequiredOwnedClipCount' \
    'DisposableProjectResume:RequiredOwnedProjectClass' \
    'DisposableProjectResume:OwnedClipsIncludeExistingProject' \
    'DisposableProjectResume:ProjectSetObservationRecordedOnly' \
    'DisposableProjectResume:SequenceDisplayNameClass' \
    'DisposableProjectResume:SequenceIdentifierClass' \
    'DisposableProjectResume:SequenceClassChain' \
    'DisposableProjectResume:SequenceIsNotAnFFAnchoredObject' \
    'not_attempted_no_rollback_claimed' \
    'verify_audio_unit_validation_containment_policy' \
    'AudioUnitValidationContainment' \
    'ExpectedFlexoSHA256' \
    '704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e' \
    'ExpectedFlexoArm64UUID' \
    'AEAE4C0B-7695-3784-A794-AFB4985525A8' \
    'ExpectedFlexoX86_64UUID' \
    '525166A8-E6F4-3DCA-B4F9-BD98F16B6552' \

#!/bin/zsh
# Focused offline checks for the guarded copied-Final-Cut launcher.
# These tests never invoke the launcher or either Final Cut executable.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd -P)"
scripts_dir="$(/usr/bin/dirname "$script_dir")"
repo_dir="$(/usr/bin/dirname "$scripts_dir")"
launcher="$scripts_dir/launch-isolated-fcpcommandconsole"
profile="$repo_dir/config/fcpcommandconsole-isolation.sb"
copied_app="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app"
rg_bin="$(command -v rg || true)"
test_dir="$(/bin/realpath "$(/usr/bin/mktemp -d /tmp/fcpcc-isolated-launcher-tests.XXXXXX)")"

fail() {
    print -u2 -r -- "run-isolated-launcher-tests: $1"
    exit 1
}

cleanup() {
    [[ "$test_dir" == /private/tmp/fcpcc-isolated-launcher-tests.* ]] || return
    /bin/rm -rf -- "$test_dir"
}
trap cleanup EXIT

require_fragment() {
    local fragment="$1" path="$2" label="$3"
    "$rg_bin" -F -q -- "$fragment" "$path" || fail "$label is missing: $fragment"
}

[[ -n "$rg_bin" ]] || fail "rg is required"
[[ -f "$launcher" ]] || fail "guarded launcher is missing"
[[ -f "$profile" ]] || fail "committed sandbox profile is missing"
[[ -x /usr/bin/sandbox-exec ]] || fail "sandbox-exec is unavailable"
/bin/zsh -n "$launcher"

for required_launcher_fragment in \
    'copied_app="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app"' \
    'copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"' \
    '--preflight-only|--launch|--launch-bootstrap-disposable-library|--launch-bootstrap-disposable-project|--launch-resume-disposable-project' \
    'require_not_running' \
    'interpret_process_probe_status' \
    'pgrep_status=0' \
    'pgrep_status=1' \
    'pgrep_status=$pgrep_status' \
    'codesign --verify --deep --strict --verbose=4' \
    'expected_copied_cdhash_full="dc11c6ea4b38c392ed183329c43b9080995846373ee0d8090e89c291fb96fc6c"' \
    'verify_reviewed_copied_cdhash' \
    'CandidateCDHashFull' \
    'create_five_entitlements' \
    'SchemaVersion)" == "16"' \
    'verify_disposable_project_resume_policy' \
    'DisposableProjectResume:ExecutionEnabled' \
    'DisposableProjectResume:EnvironmentVariable' \
    'FCPCC_RESUME_DISPOSABLE_PROJECT' \

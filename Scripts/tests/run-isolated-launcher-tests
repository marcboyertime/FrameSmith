    'DisposableProjectResume:ProjectCreationSelectorMustNeverBeInvoked' \
    'DisposableProjectResume:NilPendingOnlyAtEditorReadinessBoundaries' \
    'DisposableProjectResume:NoAutoRetry' \
    'DisposableProjectResume:RollbackClaim' \

#!/bin/zsh
# Guarded direct launcher for the one reviewed copied Final Cut Pro app.
# It performs no UI automation and never opens a library itself.

set -euo pipefail

script_dir="$(cd "$(/usr/bin/dirname "$0")" && /bin/pwd -P)"
repo_dir="$(/usr/bin/dirname "$script_dir")"
profile="$repo_dir/config/fcpcommandconsole-isolation.sb"
stock_app="/Applications/Final Cut Pro.app"
stock_executable="$stock_app/Contents/MacOS/Final Cut Pro"
copied_app="/Users/marcboyer/Applications/SpliceKit/FCPCommandConsole/Final Cut Pro - FCPCommandConsole.app"
copied_executable="$copied_app/Contents/MacOS/Final Cut Pro"
runtime_framework="$copied_app/Contents/Frameworks/FCPCommandConsoleRuntime.framework"
runtime_binary="$runtime_framework/Versions/A/FCPCommandConsoleRuntime"
runtime_policy="$runtime_framework/Versions/A/Resources/FCPCCOnboardingQueryCompatibility.plist"
planner_payload_root="$runtime_framework/Versions/A/Resources/PlannerHelperPayload"
planner_helper="$planner_payload_root/fcpcommandconsole-planner-helper"
planner_bundle="$planner_payload_root/FCPCommandConsole_FCPCommandConsolePlannerHelper.bundle"
planner_manifest="$planner_payload_root/planner-helper-manifest.json"
planner_team_identifier="KDV9RC892F"
planner_immutable_resources=(
    "Resources/registry/effects/look.old_television.json"
    "Resources/registry/effects/motion.living_still.json"
    "Resources/registry/effects/native.targeted_rotate_zoom.json"
    "Resources/registry/effects/transition.natural_dissolve.json"
    "Resources/schemas/effect-plan.schema.json"
)
entitlement_verifier="$repo_dir/plugin/build/fcpcc-entitlement-verify"
runtime_root="/Users/marcboyer/Movies/FCPCommandConsole"
allowed_library="$runtime_root/FCPCommandConsole Test.fcpbundle"
fixtures_root="$runtime_root/fixtures"
fixture_a="$fixtures_root/clip-a.mov"
fixture_b="$fixtures_root/clip-b.mov"
fixture_living_still="$fixtures_root/living-still.png"
fixture_a_sha256="cd44c0c9565c8231ec421541f4a4877f340eae7db5129fb46ffa14f0bf871444"
fixture_b_sha256="a38a03bf0ababfedc56c6086479c34649a8fea8b2435b04c4901f3987c66f67c"
fixture_living_still_sha256="170df5348f53221de630c7d7b385e6189f53a27baa2f2246ec7df4f379ed2567"
isolated_home="$runtime_root/isolated-final-cut-home"
normal_container_preferences="/Users/marcboyer/Library/Containers/com.apple.FinalCut/Data/Library/Preferences/com.apple.FinalCut.plist"
normal_user_preferences="/Users/marcboyer/Library/Preferences/com.apple.FinalCut.plist"
expected_version="12.3"
expected_build="450152"
expected_copied_cdhash_full="21e99732e747821cb4aa06467b195f33247a15fad7535ea132e77609c3820b44"
expected_receipt_sha256="2e8a161e71eb0c7dbf94aee945234fe27c43665938f64a60d6615b153b3d8d8e"
receipt_relative_path="Contents/_MASReceipt/receipt"

fail() {
    print -u2 -r -- "launch-isolated-fcpcommandconsole: $1"
    exit 1
}

usage() {
    print -u2 -r -- "usage: launch-isolated-fcpcommandconsole --preflight-only|--launch|--launch-bootstrap-disposable-library|--launch-bootstrap-disposable-project"
    exit 64
}

require_exact_directory() {
    local path="$1" label="$2" canonical
    [[ -d "$path" && ! -L "$path" ]] || fail "$label is missing, non-directory, or symlink: $path"
    canonical="$(/bin/realpath "$path")" || fail "$label cannot be canonicalized: $path"
    [[ "$canonical" == "$path" ]] || fail "$label is noncanonical or traverses a symlink: $path"
}

require_exact_regular_file() {
    local path="$1" label="$2" canonical
    [[ -f "$path" && ! -L "$path" ]] || fail "$label is missing, non-regular, or symlink: $path"
    canonical="$(/bin/realpath "$path")" || fail "$label cannot be canonicalized: $path"
    [[ "$canonical" == "$path" ]] || fail "$label is noncanonical or traverses a symlink: $path"
}

verify_disposable_project_bootstrap_fixtures() {
    require_exact_directory "$fixtures_root" "disposable project fixtures root"
    require_exact_regular_file "$fixture_a" "disposable project fixture clip-a"
    require_exact_regular_file "$fixture_b" "disposable project fixture clip-b"
    require_exact_regular_file "$fixture_living_still" "disposable project fixture living-still"
    [[ "$(/usr/bin/shasum -a 256 "$fixture_a" | /usr/bin/awk '{print $1}')" == "$fixture_a_sha256" ]] || fail "disposable project fixture clip-a SHA-256 is not reviewed"
    [[ "$(/usr/bin/shasum -a 256 "$fixture_b" | /usr/bin/awk '{print $1}')" == "$fixture_b_sha256" ]] || fail "disposable project fixture clip-b SHA-256 is not reviewed"
    [[ "$(/usr/bin/shasum -a 256 "$fixture_living_still" | /usr/bin/awk '{print $1}')" == "$fixture_living_still_sha256" ]] || fail "disposable project fixture living-still SHA-256 is not reviewed"
}


}

verify_planner_helper_policy() {
    [[ "$(plist_value "$runtime_policy" 'PlannerHelperBridge:ExecutionEnabled')" == "true" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:PanelBindingEnabled')" == "false" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:FixedRelativePayloadRoot')" == "Versions/A/Resources/PlannerHelperPayload" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:ExecutableName')" == "fcpcommandconsole-planner-helper" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:ResourceBundleName')" == "FCPCommandConsole_FCPCommandConsolePlannerHelper.bundle" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:ManifestName')" == "planner-helper-manifest.json" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:Architecture')" == "arm64" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:SignatureRequirement')" == "Apple Development" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:TeamIdentifier')" == "$planner_team_identifier" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:MainThreadInvocationRejected')" == "true" ]] || fail "embedded planner-helper bridge identity, execution, or thread policy is not reviewed"
    [[ "$(plist_value "$runtime_policy" 'PlannerHelperBridge:ManifestMaximumBytes')" == "65536" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:InputMaximumBytes')" == "262144" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:OutputMaximumBytes')" == "524288" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:StderrMaximumBytes')" == "65536" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:MaximumBundleBytes')" == "100000000" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:MaximumResourceBytes')" == "10000000" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:DefaultTimeoutSeconds')" == "5" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:MaximumTimeoutSeconds')" == "60" ]] || fail "embedded planner-helper bridge byte, bundle, resource, or timeout bounds are not reviewed"
    [[ "$(plist_value "$runtime_policy" 'PlannerHelperBridge:NoShell')" == "true" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:NoNetwork')" == "true" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:NoCallerExecutable')" == "true" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:NoCallerPayloadRoot')" == "true" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:AllowedProcessAPI')" == "NSTask" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:AllowedNSTaskSource')" == "FCPCCPlannerHelperBridge.m" && "$(plist_value "$runtime_policy" 'PlannerHelperBridge:Protocol')" == "single_utf8_json_line_request_single_utf8_json_line_response" ]] || fail "embedded planner-helper bridge process and protocol policy is not reviewed"
    local index expected
    for (( index = 0; index < ${#planner_immutable_resources[@]}; index++ )); do
        expected="${planner_immutable_resources[$((index + 1))]}"
        [[ "$(plist_value "$runtime_policy" "PlannerHelperBridge:ImmutableResources:$index")" == "$expected" ]] || fail "embedded planner-helper immutable resource order is not reviewed"
    done
    if /usr/libexec/PlistBuddy -c 'Print :PlannerHelperBridge:ImmutableResources:5' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded planner-helper policy permits an unreviewed immutable resource"
    fi
}

verify_planner_helper_payload() {
    require_exact_directory "$planner_payload_root" "embedded planner-helper payload root"
    require_exact_regular_file "$planner_helper" "embedded planner-helper executable"
    require_exact_directory "$planner_bundle" "embedded planner-helper resource bundle"
    require_exact_regular_file "$planner_manifest" "embedded planner-helper manifest"
    local actual_entries expected_entries
    actual_entries="$(/usr/bin/find "$planner_payload_root" -mindepth 1 -maxdepth 1 -print | /usr/bin/sed "s|^$planner_payload_root/||" | /usr/bin/sort)"
    expected_entries="$(printf '%s\n' fcpcommandconsole-planner-helper FCPCommandConsole_FCPCommandConsolePlannerHelper.bundle planner-helper-manifest.json | /usr/bin/sort)"
    [[ "$actual_entries" == "$expected_entries" ]] || fail "embedded planner-helper payload root contains an unexpected entry"
    /usr/bin/lipo "$planner_helper" -verify_arch arm64 >/dev/null 2>&1 || fail "embedded planner-helper executable is not arm64"
    [[ "$(/usr/bin/lipo -archs "$planner_helper")" == "arm64" ]] || fail "embedded planner-helper executable contains an unexpected architecture"
    /usr/bin/codesign --strict --verify "$planner_helper" >/dev/null || fail "embedded planner-helper signature is invalid"
    local helper_metadata helper_sha manifest_helper_sha candidate cdhash manifest_candidate manifest_cdhash
    helper_metadata="$(/usr/bin/codesign -dvvv "$planner_helper" 2>&1)" || fail "embedded planner-helper signature metadata is unavailable"
    print -r -- "$helper_metadata" | /usr/bin/grep -E -q '^Authority=Apple Development:.+$' || fail "embedded planner-helper is not Apple Development signed"
    print -r -- "$helper_metadata" | /usr/bin/grep -E -q "^TeamIdentifier=$planner_team_identifier$" || fail "embedded planner-helper signing team is not the reviewed product team"
    if print -r -- "$helper_metadata" | /usr/bin/grep -E -q '^Signature=adhoc$|flags=.*adhoc'; then
        fail "embedded planner-helper has an ad-hoc signature"
    fi
    helper_sha="$(/usr/bin/shasum -a 256 "$planner_helper" | /usr/bin/awk '{print $1}')"
    manifest_helper_sha="$(/usr/bin/jq -er '.executable.sha256' "$planner_manifest")"
    [[ "$helper_sha" == "$manifest_helper_sha" ]] || fail "embedded planner-helper executable hash differs from manifest"
    [[ "$(/usr/bin/jq -er '.executable.team_identifier' "$planner_manifest")" == "$planner_team_identifier" ]] || fail "embedded planner-helper manifest team is not the reviewed product team"
    candidate="$(print -r -- "$helper_metadata" | /usr/bin/sed -n 's/^CandidateCDHashFull sha256=\([0-9A-Fa-f]*\)$/\1/p' | /usr/bin/head -n 1)"
    cdhash="$(print -r -- "$helper_metadata" | /usr/bin/sed -n 's/^CDHash=\([0-9A-Fa-f]*\)$/\1/p' | /usr/bin/head -n 1)"
    manifest_candidate="$(/usr/bin/jq -er '.executable.candidate_cdhash_full' "$planner_manifest")"
    manifest_cdhash="$(/usr/bin/jq -er '.executable.cdhash' "$planner_manifest")"
    [[ "$candidate" == "$manifest_candidate" && "$cdhash" == "$manifest_cdhash" ]] || fail "embedded planner-helper code-directory hash differs from manifest"
    local top_level path relative expected_hash actual_hash
    while IFS= read -r top_level; do
        [[ "${top_level##*/}" == "Resources" && -d "$top_level" && ! -L "$top_level" ]] || fail "embedded planner-helper bundle contains an unexpected top-level entry"
    done < <(/usr/bin/find "$planner_bundle" -mindepth 1 -maxdepth 1 -print)
    while IFS= read -r path; do
        fail "embedded planner-helper bundle contains a symlink: $path"
    done < <(/usr/bin/find "$planner_bundle" -type l -print)
    local actual_resources expected_resources
    actual_resources="$(/usr/bin/find "$planner_bundle/Resources" -type f -print | /usr/bin/sed "s|^$planner_bundle/||" | /usr/bin/sort)"
    expected_resources="$(printf '%s\n' "${planner_immutable_resources[@]}" | /usr/bin/sort)"
    [[ "$actual_resources" == "$expected_resources" ]] || fail "embedded planner-helper immutable resource set is not exact"
    for relative in "${planner_immutable_resources[@]}"; do
        path="$planner_bundle/$relative"
        require_exact_regular_file "$path" "embedded planner-helper immutable resource"
        expected_hash="$(/usr/bin/jq -er --arg path "$relative" '.resource_bundle.resources[] | select(.relative_path == $path) | .sha256' "$planner_manifest")"
        actual_hash="$(/usr/bin/shasum -a 256 "$path" | /usr/bin/awk '{print $1}')"
        [[ "$expected_hash" == "$actual_hash" ]] || fail "embedded planner-helper immutable resource hash differs from manifest"
    done
}

make_or_require_exact_directory() {
    local path="$1" label="$2" parent
    if [[ -e "$path" || -L "$path" ]]; then
        require_exact_directory "$path" "$label"
        return
    fi
    parent="${path:h}"
    require_exact_directory "$parent" "$label parent"
    /bin/mkdir "$path"
    require_exact_directory "$path" "$label"
}

is_exact_fcp_process_path() {
    local process_path="$1"
    [[ "$process_path" == "$stock_executable" || "$process_path" == "$copied_executable" ]]
}

require_not_running() {
    local audit_path="$1" pgrep_status interpretation probe_snapshot process_path
    local probe_error="false" process_match="false"
    probe_snapshot="$audit_path.process-snapshot"
    if ! /bin/ps -axo pid=,comm= > "$probe_snapshot" 2> "$audit_path.process-stderr"; then
        pgrep_status=2
    else
        pgrep_status=1
        while IFS=' ' read -r process_pid process_name; do
            [[ "$process_pid" == <-> && "$process_name" == "Final Cut Pro" ]] || continue
            if ! process_path="$(/usr/sbin/lsof -a -p "$process_pid" -d txt -Fn 2>> "$audit_path.lsof-stderr" | /usr/bin/sed -n 's/^n//p' | /usr/bin/head -n 1)"; then
                probe_error="true"
                continue
            fi
            if [[ -z "$process_path" ]]; then
                probe_error="true"
                continue
            fi
            if is_exact_fcp_process_path "$process_path"; then
                process_match="true"
                pgrep_status=0
                print -r -- "pid=$process_pid process_name=$process_name executable=$process_path exact_target=true" >> "$audit_path"
            else
                print -r -- "pid=$process_pid process_name=$process_name executable=$process_path exact_target=false ignored=true" >> "$audit_path"
            fi
        done < "$probe_snapshot"
        [[ "$probe_error" == "true" && "$process_match" != "true" ]] && pgrep_status=2
    fi
    if [[ "$pgrep_status" -eq 0 ]]; then
        print -r -- "pgrep_status=0 process_match=true" >> "$audit_path"
    elif [[ "$pgrep_status" -eq 1 ]]; then
        print -r -- "no Final Cut Pro process observed (pgrep_status=1 exact_executable_identity=true)" >> "$audit_path"
    else
        print -r -- "pgrep_status=$pgrep_status process_probe_error=true exact_executable_identity=true" >> "$audit_path"
    fi
    if [[ "$pgrep_status" -eq 1 ]]; then
        return 0
    fi
    interpretation=1
    [[ "$pgrep_status" -eq 2 ]] && interpretation=2
    case "$interpretation" in
        1) fail "a Final Cut Pro process is running; stock and copied app must both be closed (audit=$audit_path)" ;;
        2) fail "Final Cut Pro process probe failed with status=$pgrep_status (audit=$audit_path)" ;;
        *) fail "unexpected process probe interpretation=$interpretation (audit=$audit_path)" ;;
    esac
}

interpret_process_probe_status() {
    local pgrep_status="$1" audit_path="$2"
    case "$pgrep_status" in
        0)
            print -r -- "pgrep_status=0 process_match=true" >> "$audit_path"
            return 1
            ;;
        1)
            print -r -- "no Final Cut Pro process observed (pgrep_status=1)" >> "$audit_path"
            return 0
            ;;
        *)
            print -r -- "pgrep_status=$pgrep_status process_probe_error=true" >> "$audit_path"
            return 2
            ;;
    esac
}

plist_value() {
    /usr/libexec/PlistBuddy -c "Print :$2" "$1"
}

capture_normal_preferences() {
    local output_dir="$1"
    /bin/mkdir -p "$output_dir"
    local -a labels=(container user)
    local -a paths=("$normal_container_preferences" "$normal_user_preferences")
    local index label preference_path
    for index in 1 2; do
        label="${labels[$index]}"
        preference_path="${paths[$index]}"
        if [[ -e "$preference_path" || -L "$preference_path" ]]; then
            require_exact_regular_file "$preference_path" "normal $label preference"
            print -r -- "present" > "$output_dir/$label.state"
            /usr/bin/shasum -a 256 "$preference_path" | /usr/bin/awk '{print $1}' > "$output_dir/$label.raw.sha256"
            /usr/bin/plutil -convert xml1 -o "$output_dir/$label.normalized.plist" "$preference_path"
            /usr/bin/shasum -a 256 "$output_dir/$label.normalized.plist" | /usr/bin/awk '{print $1}' > "$output_dir/$label.normalized.sha256"
        else
            print -r -- "absent" > "$output_dir/$label.state"
            print -r -- "absent" > "$output_dir/$label.raw.sha256"
            print -r -- "absent" > "$output_dir/$label.normalized.sha256"
        fi
    done
}

compare_normal_preferences() {
    local before_dir="$1" after_dir="$2" child_status="${3:-preflight}" label
    for label in container user; do
        /usr/bin/cmp -s "$before_dir/$label.state" "$after_dir/$label.state" || fail "normal $label preference presence changed (child_status=$child_status)"
        /usr/bin/cmp -s "$before_dir/$label.raw.sha256" "$after_dir/$label.raw.sha256" || fail "normal $label preference raw bytes changed (child_status=$child_status)"
        /usr/bin/cmp -s "$before_dir/$label.normalized.sha256" "$after_dir/$label.normalized.sha256" || fail "normal $label preference normalized plist changed (child_status=$child_status)"
    done
}

create_five_entitlements() {
    local output_path="$1"
    /usr/bin/plutil -create xml1 "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.app-sandbox bool false' "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.cs.disable-library-validation bool true' "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.audio-input bool true' "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.camera bool true' "$output_path"
    /usr/libexec/PlistBuddy -c 'Add :com.apple.security.device.microphone bool true' "$output_path"
}

verify_reviewed_copied_cdhash() {
    local metadata_path="$1" expected_hash="$2" label="$3" observed_hash
    observed_hash="$(/usr/bin/awk -F= '/^CandidateCDHashFull sha256=/{print $2; exit}' "$metadata_path")"
    if [[ -z "$observed_hash" ]]; then
        print -u2 -r -- "$label is missing CandidateCDHashFull metadata: $metadata_path"
        return 1
    fi
    if [[ "$observed_hash" != "$expected_hash" ]]; then
        print -u2 -r -- "$label CandidateCDHashFull drifted: expected=$expected_hash observed=$observed_hash"
        return 1
    fi
    print -r -- "candidate_cdhash_full=$observed_hash" > "${metadata_path:h}/cdhash-full.txt"
    return 0
}

verify_exact_copied_entitlements() {
    local output_dir="$1"
    local entitlements_path="$output_dir/copied-entitlements.plist"
    local json_path="$output_dir/copied-entitlements.json"
    /usr/bin/codesign -d --entitlements :- "$copied_app" > "$entitlements_path" 2> "$output_dir/copied-entitlements.stderr"
    /usr/bin/plutil -convert json -o "$json_path" "$entitlements_path"
    if ! /usr/bin/jq -e '
        type == "object"
        and (keys == [
            "com.apple.security.app-sandbox",
            "com.apple.security.cs.disable-library-validation",
            "com.apple.security.device.audio-input",
            "com.apple.security.device.camera",
            "com.apple.security.device.microphone"
        ])
        and .["com.apple.security.app-sandbox"] == false
        and .["com.apple.security.cs.disable-library-validation"] == true
        and .["com.apple.security.device.audio-input"] == true
        and .["com.apple.security.device.camera"] == true
        and .["com.apple.security.device.microphone"] == true
    ' "$json_path" > "$output_dir/copied-entitlements-verified.json"; then
        fail "copied Final Cut entitlements are not the exact reviewed five-key endpoint"
    fi
}

verify_copied_identity() {
    local output_dir="$1"
    require_exact_directory "$copied_app" "copied Final Cut app"
    require_exact_regular_file "$copied_executable" "copied Final Cut executable"
    require_exact_regular_file "$copied_app/Contents/Info.plist" "copied Final Cut Info.plist"
    [[ "$(plist_value "$copied_app/Contents/Info.plist" CFBundleShortVersionString)" == "$expected_version" && "$(plist_value "$copied_app/Contents/Info.plist" CFBundleVersion)" == "$expected_build" && "$(plist_value "$copied_app/Contents/Info.plist" CFBundleIdentifier)" == "com.apple.FinalCut" ]] || fail "copied Final Cut identity is not reviewed"
    local copied_receipt="$copied_app/$receipt_relative_path"
    require_exact_regular_file "$copied_receipt" "copied Final Cut MAS receipt"
    [[ "$(/usr/bin/shasum -a 256 "$copied_receipt" | /usr/bin/awk '{print $1}')" == "$expected_receipt_sha256" ]] || fail "copied MAS receipt hash is not reviewed"
    /usr/bin/codesign --verify --deep --strict --verbose=4 "$copied_app" > "$output_dir/copied-codesign-verify.txt" 2>&1
    /usr/bin/codesign -dvvv "$copied_app" > "$output_dir/copied-codesign-metadata.txt" 2>&1
    if ! verify_reviewed_copied_cdhash "$output_dir/copied-codesign-metadata.txt" "$expected_copied_cdhash_full" "copied Final Cut"; then
        fail "copied Final Cut top-level code-sign CDHashFull is not the reviewed artifact identity"
    fi
    require_exact_directory "$runtime_framework" "embedded runtime framework"
    require_exact_regular_file "$runtime_binary" "embedded runtime binary"
    require_exact_regular_file "$runtime_policy" "embedded runtime policy"
    /usr/bin/plutil -lint "$runtime_policy" > "$output_dir/runtime-policy-lint.txt"
    [[ "$(plist_value "$runtime_policy" SchemaVersion)" == "15" && "$(plist_value "$runtime_policy" ExpectedHostBundleIdentifier)" == "com.apple.FinalCut" && "$(plist_value "$runtime_policy" ExpectedCopiedHostBundlePath)" == "$copied_app" && "$(plist_value "$runtime_policy" ExpectedHostVersion)" == "$expected_version" && "$(plist_value "$runtime_policy" ExpectedHostBuild)" == "$expected_build" && "$(plist_value "$runtime_policy" ExpectedMASReceiptRelativePath)" == "$receipt_relative_path" && "$(plist_value "$runtime_policy" ExpectedMASReceiptSHA256)" == "$expected_receipt_sha256" && "$(plist_value "$runtime_policy" ImmutableCompileTimeAllowlist)" == "true" && "$(plist_value "$runtime_policy" RuntimeDiscoveryAllowed)" == "false" && "$(plist_value "$runtime_policy" 'CompatibilityInstallPhases:0')" == "constructor_main_thread_immediate_attempt" && "$(plist_value "$runtime_policy" 'CompatibilityInstallPhases:1')" == "application_will_finish_launching_availability_retry" && "$(plist_value "$runtime_policy" MaximumMethodGuardAttempts)" == "2" ]] || fail "embedded runtime policy is not reviewed"
    verify_audio_unit_validation_containment_policy "$runtime_policy"
    verify_planner_helper_policy
    verify_planner_helper_payload
    [[ "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:ExecutionEnabled')" == "false" && "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:RuntimeDiscoveryAllowed')" == "false" && "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:MethodContractsPinnedIn')" == "FCPCommandConsoleRuntime.m:FCPCCNativeTargetedRotateZoomStaticContracts" && "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:ExpectedFlexoSHA256')" == "704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e" && "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:CandidatePixelConvention')" == "product_normalized_top_left_to_centered_pixels_x_right_y_up" && "$(plist_value "$runtime_policy" 'NativeTargetedRotateZoomAdapter:SetterOptions')" == "0" ]] || fail "embedded native targeted rotate zoom gate is not reviewed"
    for required_live_proof in candidate_pixel_coordinate_convention full_transform_keyframe_enumeration_and_exact_removal project_owned_undo_scope_and_exact_last_assistant_undo three_property_readback_and_lossless_rollback; do
        /usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:RequiredLiveProofs' "$runtime_policy" | /usr/bin/grep -F -q "$required_live_proof" || fail "embedded native targeted rotate zoom gate omits $required_live_proof"
    done
    if /usr/libexec/PlistBuddy -c 'Print :NativeTargetedRotateZoomAdapter:RequiredLiveProofs:4' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded native targeted rotate zoom gate permits an unreviewed proof"
    fi
    [[ "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ExecutionEnabled')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:RuntimeDiscoveryAllowed')" == "false" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:MethodContractsPinnedIn')" == "FCPCommandConsoleRuntime.m:FCPCCDisposableLibraryDocumentCreateContract" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:EnvironmentVariable')" == "FCPCC_BOOTSTRAP_DISPOSABLE_LIBRARY" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:EnvironmentValue')" == "1" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:CanonicalParentPath')" == "$runtime_root" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:CanonicalTargetPath')" == "$allowed_library" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ProvenanceDirectory')" == "$runtime_root/provenance" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:LifecycleNotification')" == "NSApplicationDidFinishLaunchingNotification" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ModelClass')" == "FFLibraryDocument" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:Selector')" == "initWithURL:createDefaultEvent:error:" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ObjectiveCTypeEncodingArm64')" == "@36@0:8@16B24^@28" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ObjectiveCTypeEncodingX86_64')" == "@36@0:8@16c24^@28" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ExpectedOriginalImplementationOffsetArm64')" == "0x1d9278" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ExpectedOriginalImplementationOffsetX86_64')" == "0x2abf80" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ExpectedFlexoSHA256')" == "704557a28dcd2668f9991fa6c4b601ecfe4e926161abdf3848bf235da73cb99e" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:CreateDefaultEvent')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:RequiredActiveLibraryCountBeforeCreate')" == "0" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:RequiredActiveLibraryCountAfterCreate')" == "1" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:TargetMustBeAbsent')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:NoSymlinkComponents')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:NoRetries')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:NeverOverwriteOrRemove')" == "true" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:RequiredPostcreateIdentity')" == "canonical_path_device_inode_persistent_uid" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:ProvenanceSchemaVersion')" == "1" ]] || fail "embedded disposable-library bootstrap policy is not reviewed"
    [[ "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:PublicRegistrationAPI')" == "NSDocumentController.addDocument:" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:PublicPresentationAPIs:0')" == "NSDocument.makeWindowControllers" && "$(plist_value "$runtime_policy" 'DisposableLibraryBootstrap:PublicPresentationAPIs:1')" == "NSDocument.showWindows" ]] || fail "embedded disposable-library bootstrap public document APIs are not reviewed"
    if /usr/libexec/PlistBuddy -c 'Print :DisposableLibraryBootstrap:PublicPresentationAPIs:2' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded disposable-library bootstrap policy permits an unreviewed presentation API"
    fi
    verify_disposable_project_bootstrap_policy
    if /usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhase' "$runtime_policy" >/dev/null 2>&1 || /usr/libexec/PlistBuddy -c 'Print :CompatibilityInstallPhases:2' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded runtime policy permits an unreviewed install phase"
    fi
    [[ "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:RuntimeClass')" == "POFDesktopOnboardingCoordinator" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:Selector')" == "setQueryDemoProjectInfo:" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:MethodKind')" == "instance" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:ObjectiveCArgumentCount')" == "3" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:ObjectiveCReturnType')" == "v" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:ObjectiveCTypeEncoding')" == "v24@0:8@?16" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetArm64')" == "0x1313c" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:ExpectedOriginalImplementationOffsetX86_64')" == "0x13cc0" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:0:Replacement')" == "forward_original_setter_async_nil_metadata_provider" ]] || fail "embedded onboarding replacement policy is not reviewed"
    [[ "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:RuntimeClass')" == "CCFirstLaunchHelper" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:Selector')" == "setupAndPresentFirstLaunchIfNeededWithCompletionHandler:" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:MethodKind')" == "instance" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:ObjectiveCReturnType')" == "v" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:ObjectiveCTypeEncoding')" == 'v24@0:8@?<v@?@"NSError">16' && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:ExpectedOriginalImplementationOffsetArm64')" == "0x924e8" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:ExpectedOriginalImplementationOffsetX86_64')" == "0xc74c0" && "$(plist_value "$runtime_policy" 'ApprovedMethodReplacements:1:Replacement')" == "immediate_noop_return_without_completion_access" ]] || fail "embedded cloud first-launch replacement policy is not reviewed"
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:1:ObjectiveCArgumentCount' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded runtime policy retains an invalid Cloud nested-block argument-count condition"
    fi
    if /usr/libexec/PlistBuddy -c 'Print :ApprovedMethodReplacements:2' "$runtime_policy" >/dev/null 2>&1; then
        fail "embedded runtime policy permits an unreviewed method replacement"
    fi
    /usr/bin/shasum -a 256 "$runtime_binary" | /usr/bin/awk '{print $1}' > "$output_dir/runtime.sha256"
    verify_exact_copied_entitlements "$output_dir"
}

prepare_isolation_paths() {
    require_exact_directory "$runtime_root" "FCPCommandConsole runtime root"
    make_or_require_exact_directory "$runtime_root/provenance" "FCPCommandConsole provenance root"
    make_or_require_exact_directory "$isolated_home" "isolated Final Cut home"
    make_or_require_exact_directory "$isolated_home/Library" "isolated Final Cut Library directory"
    make_or_require_exact_directory "$isolated_home/Library/Preferences" "isolated Final Cut Preferences directory"
    make_or_require_exact_directory "$isolated_home/Library/Caches" "isolated Final Cut Caches directory"
    make_or_require_exact_directory "$isolated_home/Library/Saved Application State" "isolated Final Cut Saved Application State directory"
    make_or_require_exact_directory "$isolated_home/tmp" "isolated temporary directory"
    local allowed_parent="${allowed_library:h}"
    require_exact_directory "$allowed_parent" "disposable library parent"
    if [[ -e "$allowed_library" || -L "$allowed_library" ]]; then
        require_exact_directory "$allowed_library" "allowed disposable library"
    fi
}

run_profile_probes() {
    local output_dir="$1"
    local probe_root="$output_dir/sandbox-probes"
    local denied_bundle="$probe_root/production-fixture.fcpbundle"
    local probe_allowed="$probe_root/FCPCommandConsole Test.fcpbundle"
    /bin/mkdir -p "$denied_bundle" "$probe_allowed"
    require_exact_directory "$probe_root" "sandbox-probe root"
    require_exact_directory "$denied_bundle" "denied sandbox-probe bundle"
    require_exact_directory "$probe_allowed" "allowed sandbox-probe bundle"
    /usr/bin/touch "$denied_bundle/metadata-probe" "$probe_allowed/metadata-probe"
    local -a test_args=(-f "$profile" -D "ALLOWED_LIBRARY=$probe_allowed" -D "STOCK_APP=$stock_app")
    if /usr/bin/sandbox-exec "${test_args[@]}" /usr/bin/stat -f '%z' "$denied_bundle/metadata-probe" > "$output_dir/denied-library-probe.txt" 2>&1; then
        fail "sandbox profile permitted a production-like .fcpbundle fixture"
    fi
    /usr/bin/sandbox-exec "${test_args[@]}" /usr/bin/stat -f '%z' "$probe_allowed/metadata-probe" > "$output_dir/allowed-library-probe.txt" 2>&1 || fail "sandbox profile denied its explicitly allowed fixture"
    /usr/bin/sandbox-exec "${test_args[@]}" /usr/bin/touch "$probe_root/runtime-write-probe" > "$output_dir/runtime-write-probe.txt" 2>&1 || fail "sandbox profile denied a non-library runtime write"
    local -a launch_args=(-f "$profile" -D "ALLOWED_LIBRARY=$allowed_library" -D "STOCK_APP=$stock_app")
    /usr/bin/sandbox-exec "${launch_args[@]}" /usr/bin/stat -f '%d' "${allowed_library:h}" > "$output_dir/allowed-parent-probe.txt" 2>&1 || fail "sandbox profile denied disposable-library parent metadata"
    if [[ -e "$allowed_library" ]]; then
        /usr/bin/sandbox-exec "${launch_args[@]}" /usr/bin/stat -f '%d' "$allowed_library" > "$output_dir/existing-allowed-library-probe.txt" 2>&1 || fail "sandbox profile denied existing exact disposable-library metadata"
        print -r -- "allowed_library_probe=existing_library_metadata_only" > "$output_dir/allowed-library-probe-mode.txt"
    else
        print -r -- "allowed_library_probe=absent_library_parent_metadata_only" > "$output_dir/allowed-library-probe-mode.txt"
    fi
}

if [[ "$#" -ne 1 || ( "$1" != "--preflight-only" && "$1" != "--launch" && "$1" != "--launch-bootstrap-disposable-library" && "$1" != "--launch-bootstrap-disposable-project" ) ]]; then
    usage
fi
mode="$1"
[[ -x /usr/bin/sandbox-exec ]] || fail "/usr/bin/sandbox-exec is unavailable; refusing an uncontained launch"
[[ -x /usr/bin/jq ]] || fail "/usr/bin/jq is unavailable; refusing to weaken exact copied-entitlement verification"
require_exact_regular_file "$profile" "committed sandbox profile"
require_exact_regular_file "$entitlement_verifier" "entitlement verifier"
umask 077
prepare_isolation_paths
preflight_dir="$(/usr/bin/mktemp -d "$runtime_root/provenance/isolated-launch-preflight.XXXXXX")" || fail "cannot create private preflight provenance"
require_exact_directory "$preflight_dir" "preflight provenance directory"
require_not_running "$preflight_dir/no-fcp-before.txt"
capture_normal_preferences "$preflight_dir/normal-preferences-before"
verify_copied_identity "$preflight_dir"
if [[ "$mode" == "--launch-bootstrap-disposable-project" ]]; then
    require_exact_directory "$allowed_library" "enrolled disposable project library"
    verify_disposable_project_bootstrap_fixtures
    print -r -- "bootstrap_disposable_project_fixtures=reviewed_exact_hashes"
fi
run_profile_probes "$preflight_dir"
capture_normal_preferences "$preflight_dir/normal-preferences-after"
compare_normal_preferences "$preflight_dir/normal-preferences-before" "$preflight_dir/normal-preferences-after"
require_not_running "$preflight_dir/no-fcp-after.txt"
print -r -- "copied_app=$copied_app"
print -r -- "copied_executable=$copied_executable"
print -r -- "allowed_disposable_library=$allowed_library"
print -r -- "isolation_home=$isolated_home"
print -r -- "environment=HOME=$isolated_home CFFIXED_USER_HOME=$isolated_home TMPDIR=$isolated_home/tmp XDG_CACHE_HOME=$isolated_home/Library/Caches"
print -r -- "limitation=sandbox-exec_is_deprecated_and_CFFIXED_USER_HOME_cannot_prove_isolation_of_every_daemon_mediated_state_write"
print -r -- "preflight=pass provenance=$preflight_dir"
[[ "$mode" == "--preflight-only" ]] && exit 0
require_not_running "$preflight_dir/no-fcp-before-launch.txt"
print -r -- "launch=begin exact_copied_executable_only"
capture_normal_preferences "$preflight_dir/normal-preferences-before-launch"
bootstrap_environment=()
if [[ "$mode" == "--launch-bootstrap-disposable-library" ]]; then
    bootstrap_environment=(FCPCC_BOOTSTRAP_DISPOSABLE_LIBRARY=1)
    print -r -- "bootstrap_disposable_library=reviewed_one_shot_requested"
    print -r -- "bootstrap_disposable_project=not_requested"
elif [[ "$mode" == "--launch-bootstrap-disposable-project" ]]; then
    bootstrap_environment=(FCPCC_BOOTSTRAP_DISPOSABLE_PROJECT=1)
    print -r -- "bootstrap_disposable_library=not_requested"
    print -r -- "bootstrap_disposable_project=reviewed_one_shot_requested"
else
    print -r -- "bootstrap_disposable_library=not_requested"
    print -r -- "bootstrap_disposable_project=not_requested"
fi
/usr/bin/env -i \
    PATH=/usr/bin:/bin:/usr/sbin:/sbin \
    HOME="$isolated_home" \
    CFFIXED_USER_HOME="$isolated_home" \
    TMPDIR="$isolated_home/tmp" \
    XDG_CACHE_HOME="$isolated_home/Library/Caches" \
    FCPCC_ISOLATED_HOME="$isolated_home" \
    "${bootstrap_environment[@]}" \
    /usr/bin/sandbox-exec -f "$profile" \
    -D "ALLOWED_LIBRARY=$allowed_library" \
    -D "STOCK_APP=$stock_app" \
    "$copied_executable" \
    > "$preflight_dir/child.stdout" \
    2> "$preflight_dir/child.stderr" &
child_pid=$!
child_status=0
wait "$child_pid" || child_status=$?
print -r -- "launch=child_exit_status=$child_status"
require_not_running "$preflight_dir/no-fcp-after-launch.txt"
capture_normal_preferences "$preflight_dir/normal-preferences-after-launch"
compare_normal_preferences "$preflight_dir/normal-preferences-before-launch" "$preflight_dir/normal-preferences-after-launch" "$child_status"
print -r -- "launch=child_stdout=$preflight_dir/child.stdout"
print -r -- "launch=child_stderr=$preflight_dir/child.stderr"
if [[ "$child_status" -ne 0 ]]; then
    print -u2 -r -- "launch-isolated-fcpcommandconsole: copied Final Cut child exited with status=$child_status"
fi
exit "$child_status"

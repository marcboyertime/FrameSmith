    [[ "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixturePaths:0')" == "$fixture_a" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixturePaths:1')" == "$fixture_b" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixturePaths:2')" == "$fixture_living_still" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixtureSHA256:0')" == "$fixture_a_sha256" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixtureSHA256:1')" == "$fixture_b_sha256" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:FixtureSHA256:2')" == "$fixture_living_still_sha256" ]] || fail "embedded disposable-project bootstrap fixtures are not reviewed"

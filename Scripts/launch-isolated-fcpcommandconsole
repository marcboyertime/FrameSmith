    [[ "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ActiveSessionOwnership')" == "single_static_strong_root" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ActiveSessionSetAtLifecycleState')" == "running_before_async_escape" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ActiveSessionDuplicateStartFailsClosed')" == "true" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ActiveSessionWeakCompletionBackedByRoot')" == "true" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ActiveSessionReleaseCondition')" == "identity_matching_after_finished_timeout_pasteboard_and_provenance_finalization" ]] || fail "embedded disposable-project bootstrap active-session lifetime policy is not reviewed"
    [[ "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ProjectCreationClass')" == "FFProjectDocument" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ProjectCreationSelector')" == "actionNewProject:name:sequence:actionName:error:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:DeepLoadedSequenceClass')" == "FFLibrary" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:DeepLoadedSequenceSelector')" == "_deepLoadedSequences" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:EditorLoadClass')" == "PEEditorContainerModule" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:EditorLoadSelector')" == "loadEditorForSequence:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:ImportClass')" == "FFMediaEventProject" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:NewClipSelector')" == "newClipFromURL:manageFileType:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:AddOwnedClipSelector')" == "addOwnedClipsObject:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:PasteboardClass')" == "FFPasteboard" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:PasteboardInitSelector')" == "initWithName:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:PasteboardWriteSelector')" == "writeRangesOfMedia:options:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:RangeFactoryClass')" == "FigTimeRangeAndObject" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:RangeFactorySelector')" == "rangeAndObjectWithRange:andObject:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:EditActionClass')" == "FFEditAction" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:EditActionSelector')" == "editActionOfKind:backTimed:trackType:" && "$(plist_value "$runtime_policy" 'DisposableProjectBootstrap:EditActionKind')" == "2" && "$(plist_value "$runtime_policy" 'DisposableProjectBoot
#!/bin/sh
set -eu

# Installs the locally built app into ~/Applications.
#
# Every path this script writes through is checked for being a symlink first.
# A symlinked or dangling target is refused rather than followed: writing
# through one would install the bundle wherever the link points, outside the
# directory this script is allowed to touch.

project_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
app_parent="$HOME/Applications"
target="$app_parent/FrameSmith.app"
legacy_target="$app_parent/FCPCommandConsole.app"
bundle_id="com.marcboyer.FCPCommandConsole"

fail() { echo "$1" >&2; exit 1; }

# The parent must be a real directory. mktemp and every rename below stay
# inside it, so a symlinked parent would relocate the whole install.
if [ -L "$app_parent" ]; then
  fail "Refusing to install through a symlinked directory: $app_parent"
fi
if [ -e "$app_parent" ] && [ ! -d "$app_parent" ]; then
  fail "Not a directory: $app_parent"
fi
mkdir -p "$app_parent"
app_parent=$(CDPATH= cd -- "$app_parent" && pwd -P)
target="$app_parent/FrameSmith.app"
legacy_target="$app_parent/FCPCommandConsole.app"

# A dangling symlink is invisible to `-e`; check the link itself first so it
# cannot be silently written through.
for candidate in "$target" "$legacy_target"; do
  if [ -L "$candidate" ]; then
    fail "Refusing to replace a symlinked bundle: $candidate"
  fi
  if [ -e "$candidate" ] && [ ! -d "$candidate" ]; then
    fail "Refusing to replace a non-bundle path: $candidate"
  fi
done

cd "$project_root"
# Living Still v2 is a production path, so an installed app may not defer model
# acquisition until the user presses Preview. The acquisition script is pinned
# and hash-verifying; an existing valid artifact is reused without network I/O.
"$project_root/Scripts/acquire-depth-model"
swift build -c release --product FCPCommandConsoleApp
bin_dir=$(swift build -c release --show-bin-path)
binary="$bin_dir/FCPCommandConsoleApp"
[ -f "$binary" ] || fail "Built product is missing: $binary"
[ -x "$binary" ] || fail "Built product is not executable: $binary"
if [ -L "$binary" ]; then
  fail "Built product is a symlink: $binary"
fi

stage_root=$(mktemp -d "$app_parent/.FrameSmith.app.stage.XXXXXX")
stage_bundle="$stage_root/FrameSmith.app"
cleanup() { rm -rf "$stage_root"; }
trap cleanup EXIT HUP INT TERM

# mktemp resolves nothing; confirm the staging directory really is inside the
# parent before anything is written into it.
resolved_stage=$(CDPATH= cd -- "$stage_root" && pwd -P)
case "$resolved_stage" in
  "$app_parent"/.*) ;;
  *) fail "Staging directory escaped $app_parent: $resolved_stage" ;;
esac

mkdir -p "$stage_bundle/Contents/MacOS" "$stage_bundle/Contents/Resources/registry"
cp "$binary" "$stage_bundle/Contents/MacOS/FCPCommandConsoleApp"
cp "$project_root/assets/branding/FrameSmith.icns" "$stage_bundle/Contents/Resources/FrameSmith.icns"
ditto "$project_root/registry/effects" "$stage_bundle/Contents/Resources/registry/effects"
ditto "$project_root/registry/models" "$stage_bundle/Contents/Resources/registry/models"
# Technique cards ship with the app: the catalog must work with no network and
# no checkout, so Surprise Me cannot depend on the developer's working copy.
ditto "$project_root/registry/editorial-techniques" "$stage_bundle/Contents/Resources/registry/editorial-techniques"
mkdir -p "$stage_bundle/Contents/Resources/editorial-intelligence"
cp "$project_root/docs/editorial-intelligence/sources.csv" "$stage_bundle/Contents/Resources/editorial-intelligence/sources.csv"
ditto "$project_root/schemas" "$stage_bundle/Contents/Resources/schemas"
cat > "$stage_bundle/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleDevelopmentRegion</key><string>en</string>
  <key>CFBundleDisplayName</key><string>FrameSmith</string>
  <key>CFBundleExecutable</key><string>FCPCommandConsoleApp</string>
  <key>CFBundleIconFile</key><string>FrameSmith</string>
  <key>CFBundleIdentifier</key><string>com.marcboyer.FCPCommandConsole</string>
  <key>CFBundleName</key><string>FrameSmith</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>0.1</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>14.0</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>NSPrincipalClass</key><string>NSApplication</string>
</dict></plist>
PLIST
plutil -lint "$stage_bundle/Contents/Info.plist" >/dev/null
staged_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$stage_bundle/Contents/Info.plist")
[ "$staged_id" = "$bundle_id" ] || fail "Staged bundle identifier is wrong: $staged_id"
test -f "$stage_bundle/Contents/Resources/FrameSmith.icns"
test -f "$stage_bundle/Contents/Resources/registry/effects/native.targeted_rotate_zoom.json"
test -f "$stage_bundle/Contents/Resources/registry/models/depth-anything-v2-small.json"
test -f "$stage_bundle/Contents/Resources/registry/editorial-techniques/motion.still.quiet_push.v1.json"
test -f "$stage_bundle/Contents/Resources/schemas/effect-plan.schema.json"
test -f "$stage_bundle/Contents/Resources/schemas/treatment-plan.schema.json"
test -f "$stage_bundle/Contents/Resources/editorial-intelligence/sources.csv"
[ "$(find "$stage_bundle/Contents/Resources/registry/editorial-techniques" -type f -name '*.json' | wc -l | tr -d ' ')" = 15 ] || fail "Expected all 15 editorial technique cards"
codesign --force --deep --sign - "$stage_bundle"
codesign --verify --deep --strict "$stage_bundle"

# Confirms an installed bundle is the one this script just built.
verify_installed() {
  [ -d "$1" ] || return 1
  if [ -L "$1" ] || [ -L "$1/Contents/Info.plist" ]; then return 1; fi
  installed_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$1/Contents/Info.plist" 2>/dev/null || true)
  [ "$installed_id" = "$bundle_id" ] || return 1
  installed_icon=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIconFile' "$1/Contents/Info.plist" 2>/dev/null || true)
  [ "$installed_icon" = "FrameSmith" ] || return 1
  [ -f "$1/Contents/Resources/FrameSmith.icns" ] || return 1
  [ -f "$1/Contents/Resources/registry/effects/native.targeted_rotate_zoom.json" ] || return 1
  [ -f "$1/Contents/Resources/registry/models/depth-anything-v2-small.json" ] || return 1
  [ -f "$1/Contents/Resources/registry/editorial-techniques/motion.still.quiet_push.v1.json" ] || return 1
  [ -f "$1/Contents/Resources/schemas/effect-plan.schema.json" ] || return 1
  [ -f "$1/Contents/Resources/schemas/treatment-plan.schema.json" ] || return 1
  [ -f "$1/Contents/Resources/editorial-intelligence/sources.csv" ] || return 1
  [ "$(find "$1/Contents/Resources/registry/editorial-techniques" -type f -name '*.json' | wc -l | tr -d ' ')" = 15 ] || return 1
  codesign --verify --deep --strict "$1" >/dev/null 2>&1 || return 1
  return 0
}

if [ -d "$target" ]; then
  if [ -L "$target/Contents/Info.plist" ]; then
    fail "Refusing to read a symlinked Info.plist: $target/Contents/Info.plist"
  fi
  existing_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$target/Contents/Info.plist" 2>/dev/null || true)
  if [ "$existing_id" != "$bundle_id" ]; then
    fail "Refusing to replace non-owned bundle: $target"
  fi
  if diff -qr "$target" "$stage_bundle" >/dev/null 2>&1; then
    echo "Installed bundle is already byte-identical: $target"
  else
    backup="$app_parent/.FrameSmith.app.backup.$(date +%Y%m%d%H%M%S).$$"
    if [ -e "$backup" ] || [ -L "$backup" ]; then
      fail "Backup path already exists: $backup"
    fi

    # POSIX cannot exchange two non-empty directories in one step, so the swap is
    # two renames within one directory. Both are individually atomic, and the
    # window between them is a rollback point rather than a lost install.
    mv "$target" "$backup"
    if ! mv "$stage_bundle" "$target"; then
      mv "$backup" "$target"
      fail "Install failed; restored previous bundle at $target"
    fi
    if ! verify_installed "$target"; then
      rm -rf "$target"
      mv "$backup" "$target"
      fail "Installed bundle failed verification; restored previous bundle at $target"
    fi
    echo "Installed $target (previous owned bundle preserved at $backup)"
  fi
else
  mv "$stage_bundle" "$target"
  if ! verify_installed "$target"; then
    rm -rf "$target"
    fail "Installed bundle failed verification and was removed: $target"
  fi
  echo "Installed $target"
fi

# Retire the legacy visible product name only after the FrameSmith bundle has
# been installed and verified. Keep the prior owned bundle as a hidden backup
# so the branding migration is recoverable and no stale Dock target remains.
if [ -d "$legacy_target" ]; then
  if [ -L "$legacy_target/Contents/Info.plist" ]; then
    fail "Refusing to read a symlinked Info.plist: $legacy_target/Contents/Info.plist"
  fi
  legacy_id=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$legacy_target/Contents/Info.plist" 2>/dev/null || true)
  if [ "$legacy_id" != "$bundle_id" ]; then
    fail "Refusing to retire non-owned legacy bundle: $legacy_target"
  fi
  legacy_backup="$app_parent/.FCPCommandConsole.app.backup.$(date +%Y%m%d%H%M%S).$$"
  if [ -e "$legacy_backup" ] || [ -L "$legacy_backup" ]; then
    fail "Legacy backup path already exists: $legacy_backup"
  fi
  mv "$legacy_target" "$legacy_backup"
  echo "Retired legacy app name; previous bundle preserved at $legacy_backup"
fi
